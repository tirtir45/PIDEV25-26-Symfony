{# templates/entrepreneur/projet_detail.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="container-fluid fade-in">
    <!-- Header -->
    <div class="header">
        <div>
            <h1>{{ projet.titre }}</h1>
            <div class="page-subtitle">
                Soumis le {{ projet.dateSoumission|date('d/m/Y H:i') }} - 
                Entrepreneur: {{ projet.entrepreneur.nom ?? 'N/A' }}
            </div>
        </div>
        <div>
            <span class="status-badge 
                {% if projet.etat == 'En attente' %}status-pending
                {% elseif projet.etat == 'Accepté' %}status-accepted
                {% elseif projet.etat == 'Refusé' %}status-refused
                {% elseif projet.etat == 'En cours' %}status-in-progress
                {% else %}status-completed{% endif %}"
                style="font-size: 1rem; padding: 0.5rem 1.25rem;">
                {{ projet.etat }}
            </span>
        </div>
    </div>
    
    <!-- Progression -->
    <div class="card-modern mb-4">
        <div class="card-body-modern">
            <div class="d-flex justify-content-between mb-2">
                <strong>Progression du projet</strong>
                <strong class="text-primary">{{ progression }}%</strong>
            </div>
            <div class="progress" style="height: 12px;">
                <div class="progress-bar" style="width: {{ progression }}%"></div>
            </div>
            
            {% if projet.etat == 'Refusé' and projet.commentaireAdmin %}
            <div class="alert alert-warning mt-3">
                <i class="bi bi-info-circle"></i>
                <strong>Commentaire de l'administrateur:</strong> {{ projet.commentaireAdmin }}
            </div>
            {% endif %}
        </div>
    </div>
    
    <div class="row">
        <!-- Description du projet -->
        <div class="col-lg-7 mb-4">
            <div class="card-modern">
                <div class="card-header-modern">
                    <h3><i class="bi bi-info-circle"></i> Détails du projet</h3>
                </div>
                <div class="card-body-modern">
                    <div class="detail-item">
                        <label>Secteur</label>
                        <p><span class="badge" style="background: var(--color-primary);">{{ projet.secteur }}</span></p>
                    </div>
                    
                    <div class="detail-item">
                        <label>Description</label>
                        <p>{{ projet.description }}</p>
                    </div>
                    
                    <div class="detail-item">
                        <label>Objectifs</label>
                        <p>{{ projet.objectifs }}</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Statistiques -->
        <div class="col-lg-5 mb-4">
            <div class="card-modern mb-4">
                <div class="card-header-modern">
                    <h3><i class="bi bi-graph-up"></i> Statistiques</h3>
                </div>
                <div class="card-body-modern">
                    <div class="stat-item">
                        <span>Membres dans l'équipe</span>
                        <strong>{{ membres|length }}</strong>
                    </div>
                    <div class="stat-item">
                        <span>Tâches totales</span>
                        <strong>{{ taches|length }}</strong>
                    </div>
                    <div class="stat-item">
                        <span>Tâches terminées</span>
                        <strong>{{ taches|filter(t => t.statut == 'Terminée')|length }}</strong>
                    </div>
                    <div class="stat-item">
                        <span>Tâches en cours</span>
                        <strong>{{ taches|filter(t => t.statut == 'En cours')|length }}</strong>
                    </div>
                </div>
            </div>
            
            <!-- Commentaire Admin si refusé -->
            {% if projet.etat == 'Refusé' and projet.commentaireAdmin %}
            <div class="card-modern">
                <div class="card-header-modern" style="background: linear-gradient(135deg, var(--color-warning), #fbbf24);">
                    <h3><i class="bi bi-chat-dots"></i> Commentaire de l'admin</h3>
                </div>
                <div class="card-body-modern">
                    <p>{{ projet.commentaireAdmin }}</p>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    
    <!-- Membres et Tâches -->
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card-modern">
                <div class="card-header-modern">
                    <h3><i class="bi bi-people"></i> Membres de l'équipe</h3>
                </div>
                <div class="card-body-modern">
                    {% if membres|length > 0 %}
                        <div class="members-list">
                            {% for membre in membres %}
                            <div class="member-item">
                                <div class="member-avatar">
                                    <i class="bi bi-person-circle fs-3"></i>
                                </div>
                                <div class="member-info">
                                    <div class="member-name">{{ membre.membre.nom }}</div>
                                    <div class="member-role">{{ membre.roleEquipe }}</div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-4">
                            <i class="bi bi-people fs-1 text-muted"></i>
                            <p class="text-muted mt-2">Aucun membre assigné pour le moment</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <div class="col-lg-6 mb-4">
            <div class="card-modern">
                <div class="card-header-modern">
                    <h3><i class="bi bi-check2-square"></i> Tâches du projet</h3>
                </div>
                <div class="card-body-modern">
                    {% if taches|length > 0 %}
                        <div class="tasks-list">
                            {% for tache in taches %}
                            <div class="task-item">
                                <div class="task-status-indicator 
                                    {% if tache.statut == 'Terminée' %}status-completed
                                    {% elseif tache.statut == 'En cours' %}status-in-progress
                                    {% else %}status-pending{% endif %}">
                                </div>
                                <div class="task-content">
                                    <div class="task-title">{{ tache.titre }}</div>
                                    <div class="task-meta">
                                        <span><i class="bi bi-person"></i> {{ tache.responsable.nom ?? 'Non assigné' }}</span>
                                        {% if tache.dateLimite %}
                                        <span><i class="bi bi-calendar"></i> {{ tache.dateLimite|date('d/m/Y') }}</span>
                                        {% endif %}
                                        <span class="status-badge 
                                            {% if tache.statut == 'Terminée' %}status-completed
                                            {% elseif tache.statut == 'En cours' %}status-in-progress
                                            {% else %}status-pending{% endif %}"
                                            style="font-size: 0.7rem;">
                                            {{ tache.statut }}
                                        </span>
                                    </div>
                                    {% if tache.description %}
                                    <div class="task-description-small">{{ tache.description|slice(0, 100) }}...</div>
                                    {% endif %}
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-4">
                            <i class="bi bi-check2-square fs-1 text-muted"></i>
                            <p class="text-muted mt-2">Aucune tâche créée pour le moment</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.detail-item {
    margin-bottom: 1.5rem;
}

.detail-item label {
    display: block;
    font-weight: 600;
    color: var(--color-gray);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.5rem;
}

.detail-item p {
    margin: 0;
    color: var(--color-dark);
    line-height: 1.6;
}

.stat-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid #e2e8f0;
}

.stat-item:last-child {
    border-bottom: none;
}

.stat-item span {
    color: var(--color-gray);
}

.stat-item strong {
    font-size: 1.25rem;
    color: var(--color-primary);
}

.members-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.member-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    background: #f8fafc;
    border-radius: 12px;
    transition: var(--transition);
}

.member-item:hover {
    background: #f1f5f9;
}

.member-avatar {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: 50%;
    color: white;
}

.member-info {
    flex: 1;
}

.member-name {
    font-weight: 600;
    color: var(--color-dark);
}

.member-role {
    font-size: 0.85rem;
    color: var(--color-gray);
}

.tasks-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.task-item {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background: #f8fafc;
    border-radius: 12px;
    transition: var(--transition);
}

.task-item:hover {
    background: #f1f5f9;
}

.task-status-indicator {
    width: 4px;
    border-radius: 4px;
}

.task-status-indicator.status-pending { background: var(--color-warning); }
.task-status-indicator.status-in-progress { background: var(--color-info); }
.task-status-indicator.status-completed { background: var(--color-success); }

.task-content {
    flex: 1;
}

.task-title {
    font-weight: 600;
    color: var(--color-dark);
    margin-bottom: 0.5rem;
}

.task-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--color-gray);
    margin-bottom: 0.5rem;
}

.task-meta i {
    margin-right: 0.25rem;
}

.task-description-small {
    font-size: 0.85rem;
    color: var(--color-gray);
    line-height: 1.4;
}
</style>
{% endblock %}