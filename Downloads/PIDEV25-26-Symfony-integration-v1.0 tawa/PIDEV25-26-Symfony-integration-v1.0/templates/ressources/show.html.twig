{% extends 'base.html.twig' %}

{% block title %}Ressource — {{ ressource.nom }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="ressource-show-page">

    {# ── Card ── #}
    <div class="show-card">

        {# ── Header ── #}
        <div class="show-header">
            <div>
                <h1>{{ ressource.nom }}</h1>
                <p>Détails de la ressource</p>
            </div>
            <span class="header-star">✦</span>
        </div>

        {# ── Body ── #}
        <div class="show-body">

            {# ── Section title ── #}
            <div class="section-title">Informations de la ressource</div>
            <hr class="divider">

            {# ── Image + main info ── #}
            <div class="top-row">

                {# Image preview #}
                <div class="image-box">
                    {% if ressource.image_r %}
                        <img src="{{ asset('uploads/ressources/' ~ ressource.image_r) }}"
                             alt="{{ ressource.nom }}"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                        <div class="img-placeholder" style="display:none">
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#D08EC1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                            <span>{{ ressource.image_r }}</span>
                        </div>
                    {% else %}
                        <div class="img-placeholder">
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#D08EC1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                            <span>Aucune image</span>
                        </div>
                    {% endif %}
                </div>

                {# Badges #}
                <div class="badges-col">
                    {# Offre badge #}
                    {% if ressource.offre == 'achat' %}
                        <span class="badge badge-achat">💰 Achat</span>
                    {% elseif ressource.offre == 'louer' %}
                        <span class="badge badge-louer">📋 Location</span>
                    {% else %}
                        <span class="badge badge-other">{{ ressource.offre }}</span>
                    {% endif %}

                    {# Disponibilite badge #}
                    {% if ressource.disponibilite %}
                        <span class="badge badge-dispo">✓ Disponible</span>
                    {% else %}
                        <span class="badge badge-indispo">✗ Indisponible</span>
                    {% endif %}

                    {# Etat badge #}
                    <span class="badge badge-etat">{{ ressource.etat }}</span>
                </div>
            </div>

            {# ── Detail grid ── #}
            <div class="detail-grid">

                <div class="detail-row">
                    <div class="detail-field">
                        <span class="detail-label">Nom</span>
                        <span class="detail-value">{{ ressource.nom }}</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Type de ressource</span>
                        <span class="detail-value">{{ ressource.type_r }}</span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-field">
                        <span class="detail-label">Type d'offre</span>
                        <span class="detail-value">{{ ressource.offre }}</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">État</span>
                        <span class="detail-value">{{ ressource.etat }}</span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-field">
                        <span class="detail-label">Prix d'achat</span>
                        <span class="detail-value price">
                            {{ ressource.prix_achat is not null ? ressource.prix_achat ~ ' TND' : '—' }}
                        </span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Prix de location</span>
                        <span class="detail-value price">
                            {{ ressource.prix_louer is not null ? ressource.prix_louer ~ ' TND' : '—' }}
                            {% if ressource.unite_louer %}
                                <span class="unit">/ {{ ressource.unite_louer }}</span>
                            {% endif %}
                        </span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-field">
                        <span class="detail-label">Quantité</span>
                        <span class="detail-value">{{ ressource.quantite }}</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Disponibilité</span>
                        <span class="detail-value">{{ ressource.disponibilite ? 'Oui' : 'Non' }}</span>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-field full">
                        <span class="detail-label">Description</span>
                        <span class="detail-value desc">{{ ressource.description ?: '—' }}</span>
                    </div>
                </div>

            </div>{# /.detail-grid #}

        </div>{# /.show-body #}

        {# ── Actions ── #}
        <div class="show-actions">
            <a class="btn btn-back" href="{{ path('app_fournisseur_ressources') }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                Retour à la liste
            </a>
            <a class="btn btn-edit" href="{{ path('app_ressources_edit', {'idRessource': ressource.id_ressource}) }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Modifier
            </a>
            {{ include('ressources/_delete_form.html.twig') }}
        </div>

    </div>{# /.show-card #}

</div>

<style>
.ressource-show-page {
    --purple:      #A155B9;
    --purple-dark: #8a4ca0;
    --purple-hover:#f3e8f9;
    --pink:        #F765A3;
    --border:      #e2e8f0;
    --border-card: #ead5f0;
    --text:        #2d0a3e;
    --muted:       #b05fa0;
    --white:       #ffffff;
    --radius:      9px;
    --input-bg:    #f8fafc;
    --page-bg:     #fdf4fb;

    font-family: 'Nunito', sans-serif;
    background: var(--page-bg);
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 28px 16px;
}

/* ── Card ── */
.show-card {
    background: var(--white);
    border-radius: 16px;
    border: 1px solid var(--border-card);
    box-shadow: 0 6px 14px rgba(161,85,185,0.08);
    width: 100%;
    max-width: 900px;
    overflow: hidden;
}

/* ── Header ── */
.show-header {
    background: linear-gradient(to right, #A155B9, #c472d4);
    padding: 22px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.show-header h1 {
    color: #fff;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0;
}
.show-header p {
    color: rgba(255,255,255,0.75);
    font-size: 0.88rem;
    margin: 4px 0 0;
}
.header-star {
    color: rgba(255,255,255,0.3);
    font-size: 28px;
    flex-shrink: 0;
}

/* ── Body ── */
.show-body {
    padding: 32px 32px 28px;
}

/* ── Section title ── */
.section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.06rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 16px;
}
.section-title::before {
    content: '';
    display: inline-block;
    width: 4px; height: 22px;
    background: var(--purple);
    border-radius: 3px;
    flex-shrink: 0;
}
hr.divider {
    border: none;
    height: 1px;
    background: linear-gradient(to right, #D08EC1, #f5c6e0, transparent);
    margin-bottom: 26px;
}

/* ── Top row: image + badges ── */
.top-row {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    margin-bottom: 28px;
}

.image-box {
    flex-shrink: 0;
    width: 140px;
    height: 140px;
    border-radius: 12px;
    border: 1.5px solid var(--border-card);
    background: var(--input-bg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}
.image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.img-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.78rem;
    text-align: center;
    padding: 12px;
    width: 100%;
    height: 100%;
}

.badges-col {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 4px;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
}
.badge-achat  { background: #fff0f6; color: #e04d8e; border: 1px solid #f5c6e0; }
.badge-louer  { background: var(--purple-hover); color: var(--purple); border: 1px solid #D08EC1; }
.badge-other  { background: var(--input-bg); color: var(--text); border: 1px solid var(--border); }
.badge-dispo  { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
.badge-indispo{ background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
.badge-etat   { background: var(--input-bg); color: var(--text); border: 1px solid var(--border); }

/* ── Detail grid ── */
.detail-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
}

.detail-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid #f0eaf6;
}
.detail-row:last-child { border-bottom: none; }

.detail-field {
    display: grid;
    grid-template-columns: 150px 1fr;
    align-items: baseline;
    column-gap: 16px;
    padding: 12px 0;
}
.detail-field:first-child { padding-right: 20px; border-right: 1px solid #f0eaf6; }
.detail-field:last-child  { padding-left: 20px; }
.detail-field.full        { grid-column: 1 / -1; border-right: none; padding-left: 0; }

.detail-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: #000;
    text-align: right;
    padding-right: 4px;
    white-space: nowrap;
}
.detail-value {
    font-size: 0.9rem;
    color: #374151;
}
.detail-value.price {
    font-weight: 700;
    color: var(--purple);
}
.detail-value .unit {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.82rem;
}
.detail-value.desc {
    white-space: pre-wrap;
    line-height: 1.6;
}

/* ── Actions ── */
.show-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 22px 32px 28px;
    background: linear-gradient(to right, #D08EC1, #f5c6e0, transparent) no-repeat top / 100% 1px;
    flex-wrap: wrap;
}

.btn {
    font-family: 'Nunito', sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    border-radius: 10px;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.16s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 42px;
    padding: 0 22px;
}
.btn-back {
    background: var(--white);
    border-color: var(--border);
    color: #374151;
}
.btn-back:hover { background: var(--input-bg); }

.btn-edit {
    background: var(--purple);
    color: var(--white);
    border-color: transparent;
    box-shadow: 0 4px 12px rgba(161,85,185,0.3);
}
.btn-edit:hover {
    background: var(--purple-dark);
    box-shadow: 0 6px 16px rgba(161,85,185,0.4);
}

/* Delete form button — align with our style */
.show-actions form button,
.show-actions form input[type="submit"] {
    font-family: 'Nunito', sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    height: 42px;
    padding: 0 22px;
    border-radius: 10px;
    border: 2px solid #fca5a5;
    background: #fff0f0;
    color: #991b1b;
    cursor: pointer;
    transition: all 0.16s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.show-actions form button:hover,
.show-actions form input[type="submit"]:hover {
    background: #fee2e2;
    border-color: #f87171;
}

@media (max-width: 640px) {
    .top-row { flex-direction: column; }
    .detail-row { grid-template-columns: 1fr; }
    .detail-field { grid-template-columns: 1fr; row-gap: 3px; }
    .detail-field:first-child { border-right: none; padding-right: 0; border-bottom: 1px solid #f0eaf6; }
    .detail-field:last-child  { padding-left: 0; }
    .detail-label { text-align: left; }
    .show-body { padding: 20px 16px; }
    .show-actions { padding: 18px 16px 22px; }
}
</style>
{% endblock %}
