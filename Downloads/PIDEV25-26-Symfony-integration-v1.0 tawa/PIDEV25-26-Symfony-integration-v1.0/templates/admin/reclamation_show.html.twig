{% extends 'base.html.twig' %}
{% block title %}Réclamation #{{ reclamation.id }}{% endblock %}

{% block stylesheets %}
<style>
.recap-header {
    background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
    border-radius: 16px;
    padding: 28px 32px;
    color: white;
    margin-bottom: 28px;
}
.recap-header .badge-statut {
    display: inline-block;
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    background: rgba(255,255,255,0.2);
    color: white;
    backdrop-filter: blur(4px);
}
.info-card {
    background: #fff;
    border-radius: 14px;
    border: 1px solid #f0f0f5;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    padding: 24px;
    height: 100%;
}
.info-card .section-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #9ca3af;
    margin-bottom: 8px;
}
.chat-card {
    background: #fff;
    border-radius: 14px;
    border: 1px solid #f0f0f5;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    height: 560px;
}
.chat-header {
    padding: 18px 24px;
    border-bottom: 1px solid #f0f0f5;
    font-weight: 600;
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: #fafafa;
}
.chat-messages::-webkit-scrollbar { width: 4px; }
.chat-messages::-webkit-scrollbar-thumb { background: #e0e0e0; border-radius: 4px; }
.msg-bubble {
    max-width: 70%;
    display: flex;
    flex-direction: column;
}
.msg-bubble.me { align-self: flex-end; align-items: flex-end; }
.msg-bubble.other { align-self: flex-start; align-items: flex-start; }
.msg-bubble .bubble-meta {
    font-size: 11px;
    color: #9ca3af;
    margin-bottom: 4px;
}
.msg-bubble .bubble-text {
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.5;
}
.msg-bubble.me .bubble-text {
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    color: white;
    border-bottom-right-radius: 4px;
}
.msg-bubble.other .bubble-text {
    background: #fff;
    color: #1f2937;
    border: 1px solid #e5e7eb;
    border-bottom-left-radius: 4px;
}
.chat-input-area {
    padding: 16px 20px;
    border-top: 1px solid #f0f0f5;
    background: #fff;
    border-radius: 0 0 14px 14px;
}
.chat-input-area .input-group {
    background: #f8f7ff;
    border-radius: 12px;
    overflow: hidden;
    border: 1.5px solid #e9e4ff;
    transition: border-color 0.2s;
}
.chat-input-area .input-group:focus-within {
    border-color: #7c3aed;
}
.chat-input-area input {
    background: transparent;
    border: none;
    padding: 12px 16px;
    font-size: 14px;
    outline: none;
    box-shadow: none !important;
}
.chat-input-area .btn-send {
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    color: white;
    border: none;
    padding: 0 20px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
}
.chat-input-area .btn-send:hover { opacity: 0.9; }
.chat-closed {
    padding: 20px;
    text-align: center;
    color: #6b7280;
    font-size: 13px;
    background: #f9fafb;
    border-radius: 0 0 14px 14px;
    border-top: 1px solid #f0f0f5;
}
.statut-form select {
    border-radius: 8px;
    border: 1.5px solid #e5e7eb;
    padding: 6px 12px;
    font-size: 13px;
    outline: none;
}
.statut-form .btn-update {
    background: rgba(255,255,255,0.2);
    color: white;
    border: 1.5px solid rgba(255,255,255,0.4);
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
}
.statut-form .btn-update:hover { background: rgba(255,255,255,0.3); }
.ai-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}
.empty-chat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
    gap: 8px;
}
.empty-chat i { font-size: 36px; opacity: 0.3; }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid fade-in px-4">

    <a href="{{ path('admin_reclamation_index') }}" class="btn btn-sm btn-outline-secondary mb-4">
        <i class="bi bi-arrow-left me-1"></i> Retour aux réclamations
    </a>

    {# Header #}
    <div class="recap-header d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge-statut">
                    {{ reclamation.statut == 'EN_ATTENTE' ? '⏳' : (reclamation.statut == 'RESOLU' ? '✅' : (reclamation.statut == 'EN_COURS' ? '🔄' : '❌')) }}
                    {{ reclamation.statut|replace({'_': ' '}) }}
                </span>
                <span style="opacity:0.6; font-size:13px;">{{ reclamation.dateCreation|date('d/m/Y à H:i') }}</span>
            </div>
            <h2 class="mb-0 fw-bold" style="font-size:22px;">{{ reclamation.sujet }}</h2>
        </div>
        <form method="POST" action="{{ path('admin_reclamation_show', {id: reclamation.id}) }}" class="statut-form d-flex align-items-center gap-2">
            <select name="statut">
                <option value="EN_ATTENTE" {{ reclamation.statut == 'EN_ATTENTE' ? 'selected' : '' }}>⏳ En attente</option>
                <option value="EN_COURS"   {{ reclamation.statut == 'EN_COURS'   ? 'selected' : '' }}>🔄 En cours</option>
                <option value="RESOLU"     {{ reclamation.statut == 'RESOLU'     ? 'selected' : '' }}>✅ Résolu</option>
                <option value="REJETE"     {{ reclamation.statut == 'REJETE'     ? 'selected' : '' }}>❌ Rejeté</option>
            </select>
            <button type="submit" class="btn-update">Mettre à jour</button>
        </form>
    </div>

    <div class="row g-4">
        {# Colonne gauche : infos #}
        <div class="col-lg-4">
            <div class="info-card">

                {# Utilisateur #}
                <div class="section-label"><i class="bi bi-person me-1"></i>Utilisateur</div>
                {% if reclamation.utilisateur %}
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div style="width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#7c3aed,#a855f7);color:white;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px;flex-shrink:0;">
                        {{ reclamation.utilisateur.nom|slice(0,1)|upper }}
                    </div>
                    <div>
                        <div class="fw-semibold">{{ reclamation.utilisateur.nom }}</div>
                        <div class="text-muted small">{{ reclamation.utilisateur.email }}</div>
                    </div>
                </div>
                {% endif %}

                <hr style="border-color:#f0f0f5;">

                {# Description #}
                <div class="section-label"><i class="bi bi-file-text me-1"></i>Description</div>
                <p class="mb-0" style="font-size:14px;line-height:1.6;color:#374151;">{{ reclamation.description }}</p>

                {% if reclamation.descriptionOriginale %}
                <div class="mt-3 p-3 rounded-3" style="background:#fffbeb;border-left:3px solid #f59e0b;">
                    <div class="small text-muted mb-1"><i class="bi bi-translate me-1"></i>Texte original
                        <span class="badge bg-warning-subtle text-warning ms-1">{{ reclamation.langueOriginale }}</span>
                    </div>
                    <div style="font-size:13px;">{{ reclamation.descriptionOriginale }}</div>
                </div>
                {% endif %}

                {% if reclamation.categorie or reclamation.sentiment or reclamation.priorite %}
                <hr style="border-color:#f0f0f5;">
                <div class="section-label"><i class="bi bi-robot me-1"></i>Analyse IA</div>
                <div class="d-flex flex-wrap gap-2">
                    {% if reclamation.categorie %}
                        <span class="ai-badge" style="background:#eff6ff;color:#3b82f6;">
                            <i class="bi bi-tag-fill"></i> {{ reclamation.categorie }}
                        </span>
                    {% endif %}
                    {% if reclamation.sentiment %}
                        <span class="ai-badge {{ reclamation.sentiment == 'négatif' ? '' : (reclamation.sentiment == 'positif' ? '' : '') }}"
                            style="background:{{ reclamation.sentiment == 'négatif' ? '#fef2f2' : (reclamation.sentiment == 'positif' ? '#f0fdf4' : '#f9fafb') }};
                                   color:{{ reclamation.sentiment == 'négatif' ? '#ef4444' : (reclamation.sentiment == 'positif' ? '#22c55e' : '#6b7280') }};">
                            {{ reclamation.sentiment == 'négatif' ? '😠' : (reclamation.sentiment == 'positif' ? '😊' : '😐') }}
                            {{ reclamation.sentiment }}
                        </span>
                    {% endif %}
                    {% if reclamation.priorite %}
                        <span class="ai-badge"
                            style="background:{{ reclamation.priorite == 'HIGH' ? '#fef2f2' : (reclamation.priorite == 'MEDIUM' ? '#fffbeb' : '#f0fdf4') }};
                                   color:{{ reclamation.priorite == 'HIGH' ? '#ef4444' : (reclamation.priorite == 'MEDIUM' ? '#f59e0b' : '#22c55e') }};">
                            {{ reclamation.priorite == 'HIGH' ? '🔴' : (reclamation.priorite == 'MEDIUM' ? '🟡' : '🟢') }}
                            {{ reclamation.priorite }}
                        </span>
                    {% endif %}
                </div>
                {% endif %}

            </div>
        </div>

        {# Colonne droite : chat #}
        <div class="col-lg-8">
            <div class="chat-card">
                <div class="chat-header">
                    <i class="bi bi-chat-dots" style="color:#7c3aed;"></i>
                    Discussion avec l'utilisateur
                    <span class="ms-auto badge rounded-pill" style="background:#f3f0ff;color:#7c3aed;font-size:11px;">
                        {{ messages|length }} message{{ messages|length > 1 ? 's' : '' }}
                    </span>
                </div>

                <div class="chat-messages" id="chatBox">
                    {% if messages is empty %}
                        <div class="empty-chat">
                            <i class="bi bi-chat-square-dots"></i>
                            <span>Aucun message. Commencez la discussion.</span>
                        </div>
                    {% else %}
                        {% for msg in messages %}
                            {% set isAdmin = msg.id_auteur.getId() == adminId %}
                            <div class="msg-bubble {{ isAdmin ? 'me' : 'other' }}">
                                <div class="bubble-meta">
                                    {% if isAdmin %}
                                        <i class="bi bi-shield-check me-1" style="color:#7c3aed;"></i>Admin
                                    {% else %}
                                        <i class="bi bi-person me-1"></i>{{ msg.id_auteur.nom }}
                                    {% endif %}
                                    · {{ msg.date_commentaire|date('d/m à H:i') }}
                                </div>
                                <div class="bubble-text">{{ msg.commentaire }}</div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>

                {% if reclamation.statut == 'RESOLU' %}
                    <div class="chat-closed">
                        <i class="bi bi-lock-fill me-2" style="color:#22c55e;"></i>
                        Réclamation résolue — la communication est fermée.
                    </div>
                {% else %}
                    <div class="chat-input-area">
                        <form method="POST" action="{{ path('admin_reclamation_show', {id: reclamation.id}) }}">
                            <div class="input-group">
                                <input type="text" name="message" placeholder="Répondre à l'utilisateur..." autocomplete="off" class="form-control">
                                <button type="submit" class="btn-send">
                                    <i class="bi bi-send-fill me-1"></i> Envoyer
                                </button>
                            </div>
                        </form>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
    const box = document.getElementById('chatBox');
    if (box) box.scrollTop = box.scrollHeight;
</script>
{% endblock %}
