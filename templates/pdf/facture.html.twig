<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8">
<style>
* { margin:0;padding:0;box-sizing:border-box; }
body { font-family:DejaVu Sans,Arial,sans-serif;font-size:13px;color:#1e1e2e; }
.header { background:linear-gradient(135deg,#6a0dad 0%,#a155b9 100%);padding:30px 38px;color:white; }
.hrow { display:flex;justify-content:space-between;align-items:flex-start; }
.brand { font-size:26px;font-weight:bold; }
.brand-sub { font-size:11px;opacity:.8;margin-top:3px; }
.inv-label { text-align:right; }
.inv-title { font-size:20px;font-weight:bold; }
.inv-num { font-size:12px;opacity:.85;margin-top:3px; }
.hdivider { border-top:1px solid rgba(255,255,255,.3);margin:16px 0; }
.hmeta { display:flex;justify-content:space-between;font-size:12px;opacity:.9; }
.body { padding:28px 38px; }
.stitle { font-size:11px;font-weight:bold;color:#a155b9;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:8px; }
.infobox { background:#f9f5ff;border-left:4px solid #a155b9;border-radius:4px;padding:12px 16px;margin-bottom:18px; }
.irow { display:flex;margin-bottom:5px; }
.ilabel { width:130px;color:#6b7280;font-size:12px;flex-shrink:0; }
.ival { font-weight:bold;color:#1e1e2e;font-size:12px; }
.evbox { border:1px solid #e9d5ff;border-radius:8px;padding:16px;margin-bottom:20px; }
.evtitle { font-size:16px;font-weight:bold;color:#6a0dad;margin-bottom:8px; }
.pricebox { background:#6a0dad;color:white;border-radius:8px;padding:14px 18px;display:flex;justify-content:space-between;align-items:center;margin-bottom:22px; }
.pricelabel { font-size:12px;opacity:.85; }
.priceamt { font-size:20px;font-weight:bold; }
.qrsec { text-align:center; }
.qrtitle { font-size:11px;color:#6b7280;margin-bottom:6px;letter-spacing:1px;text-transform:uppercase; }
.qrtoken { font-size:9px;color:#a155b9;margin-top:5px;word-break:break-all; }
.footer { border-top:1px solid #e9d5ff;margin:0 38px;padding:14px 0;text-align:center;font-size:11px;color:#9ca3af; }
.badge-paid { display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:bold;background:#d1fae5;color:#059669; }
.badge-free { display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:bold;background:#ede9fe;color:#7c3aed; }
</style></head><body>

<div class="header">
  <div class="hrow">
    <div><div class="brand">StartHub</div><div class="brand-sub">Plateforme Entrepreneuriale</div></div>
    <div class="inv-label"><div class="inv-title">BILLET</div><div class="inv-num">#{{ reservation.idReservation }}</div></div>
  </div>
  <div class="hdivider"></div>
  <div class="hmeta">
    <span>Date : {{ reservation.dateReservation|date("d/m/Y a H:i") }}</span>
    <span>{% if evenement.prix == 0 %}<span class="badge-free">GRATUIT</span>{% else %}<span class="badge-paid">PAYÉ</span>{% endif %}</span>
  </div>
</div>

<div class="body">
  <div style="display:flex;gap:20px;margin-bottom:20px;">
    <div style="flex:1;">
      <div class="stitle">Client</div>
      <div class="infobox">
        <div class="irow"><span class="ilabel">Nom :</span><span class="ival">{{ utilisateur ? utilisateur.nom : "—" }}</span></div>
        <div class="irow"><span class="ilabel">Email :</span><span class="ival">{{ utilisateur ? utilisateur.email : "—" }}</span></div>
        <div class="irow"><span class="ilabel">Ref. billet :</span><span class="ival">#{{ reservation.idReservation }}</span></div>
      </div>
    </div>
    <div style="width:176px;text-align:center;">
      <div class="qrtitle">QR Code</div>
      {% if qr_svg %}
        <div style="width:140px;height:140px;margin:0 auto;">{{ qr_svg|raw }}</div>
      {% else %}
        <div style="width:140px;height:140px;border:2px dashed #c084fc;border-radius:6px;
                    font-size:10px;color:#a155b9;text-align:center;padding:20px 8px;margin:0 auto;">
          Scannez le token ci-dessous
        </div>
      {% endif %}
      <div class="qrtoken">{{ reservation.tokenVerification }}</div>
    </div>
  </div>

  <div class="stitle">Evenement</div>
  <div class="evbox">
    <div class="evtitle">{{ evenement ? evenement.titre : "—" }}</div>
    <div class="irow"><span class="ilabel">Date :</span><span class="ival">{{ evenement and evenement.dateEvenement ? evenement.dateEvenement|date("d/m/Y") : "—" }}</span></div>
    <div class="irow"><span class="ilabel">Lieu :</span><span class="ival">{{ evenement ? evenement.lieu : "—" }}</span></div>
    <div class="irow" style="margin-top:5px;"><span class="ilabel">Description :</span><span class="ival" style="font-weight:normal;color:#4b5563;">{{ evenement and evenement.description ? evenement.description|slice(0,120) : "—" }}</span></div>
  </div>

  <div class="pricebox">
    <div><div class="pricelabel">Montant total</div><div style="font-size:11px;opacity:.7;">1 place</div></div>
    <div class="priceamt">{{ evenement and evenement.prix > 0 ? evenement.prix|number_format(2,"."," ")~" DT" : "GRATUIT" }}</div>
  </div>

  <div style="background:#fdf4ff;border:1px dashed #c084fc;border-radius:8px;padding:11px 14px;font-size:11px;color:#7c3aed;text-align:center;">
    Ce billet est personnel et non transferable. Presentez ce QR code a l\'entree de l\'evenement.
  </div>
</div>

<div class="footer">
  StartHub — Plateforme Entrepreneuriale &nbsp;|&nbsp; Genere le {{ "now"|date("d/m/Y a H:i:s") }}<br>
  Ce document tient lieu de facture et de billet d\'entree.
</div>
</body></html>