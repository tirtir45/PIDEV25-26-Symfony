{% extends 'base.html.twig' %}

{% block title %}{{ evenement.titre }}{% endblock %}

{% set active = 'admin_events' %}

{% block body %}
<div class="page-header">
    <div style="flex:1">
        <p class="page-header-title">📅 {{ evenement.titre }}</p>
        <p class="page-header-sub">📍 {{ evenement.lieu }} — {{ evenement.dateEvenement|date('d/m/Y') }}</p>
    </div>
    <a href="{{ path('admin_evenement_edit', {id: evenement.idEvenement}) }}" class="btn-pink"
       style="text-decoration:none; display:inline-flex; align-items:center; gap:5px;">
        ✏️ Modifier
    </a>
    <a href="{{ path('admin_evenement_index') }}" class="btn-outline-purple"
       style="color:white; border-color:rgba(255,255,255,.4); text-decoration:none;">
        ← Retour
    </a>
</div>

<!-- EVENT DETAIL CARD -->
<div style="display:flex; gap:18px; flex-wrap:wrap; margin-bottom:20px;">
    <div style="flex:1; min-width:280px; background:white; border-radius:14px; padding:24px;
                border:1px solid #ead5f0; box-shadow:0 2px 10px rgba(161,85,185,.08);">
        <h6 style="color:#A155B9; font-weight:700; margin-bottom:16px;">ℹ️ Détails</h6>
        <div style="display:flex; flex-direction:column; gap:12px; font-size:13px;">
            <div style="display:flex; justify-content:space-between;">
                <span style="color:#94a3b8; font-weight:600;">Date</span>
                <span style="font-weight:700;">{{ evenement.dateEvenement|date('d MMMM Y') }}</span>
            </div>
            <div style="display:flex; justify-content:space-between;">
                <span style="color:#94a3b8; font-weight:600;">Lieu</span>
                <span style="font-weight:700;">{{ evenement.lieu }}</span>
            </div>
            <div style="display:flex; justify-content:space-between;">
                <span style="color:#94a3b8; font-weight:600;">Places restantes</span>
                <span style="font-weight:700; color:{% if evenement.capacite <= 0 %}#dc2626{% else %}#059669{% endif %};">
                    {{ evenement.capacite }}
                </span>
            </div>
            <div style="display:flex; justify-content:space-between;">
                <span style="color:#94a3b8; font-weight:600;">Prix</span>
                <span style="font-weight:700; color:#A155B9;">
                    {% if evenement.prix == 0 %}Gratuit{% else %}{{ evenement.prix|number_format(2) }} DT{% endif %}
                </span>
            </div>
            <div style="display:flex; justify-content:space-between;">
                <span style="color:#94a3b8; font-weight:600;">Réservations</span>
                <span style="font-weight:700; color:#2563eb;">{{ reservations|length }}</span>
            </div>
            <div style="display:flex; justify-content:space-between;">
                <span style="color:#94a3b8; font-weight:600;">Statut</span>
                {% if evenement.complet %}
                    <span class="badge-complet">Complet</span>
                {% elseif evenement.futur %}
                    <span class="badge-futur">À venir</span>
                {% else %}
                    <span style="background:#f1f5f9; color:#64748b; font-size:10px; padding:2px 8px; border-radius:20px; font-weight:600;">Passé</span>
                {% endif %}
            </div>
        </div>

        {% if evenement.description %}
        <hr style="border-color:#ead5f0; margin: 16px 0;">
        <h6 style="color:#A155B9; font-weight:700; margin-bottom:8px;">📝 Description</h6>
        <p style="font-size:13px; color:#4b5563; line-height:1.6;">{{ evenement.description }}</p>
        {% endif %}
    </div>

    <!-- RESERVATIONS TABLE -->
    <div style="flex:2; min-width:320px;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
            <h6 style="color:#4a3068; font-weight:700; margin:0;">🎫 Réservations ({{ reservations|length }})</h6>
            <a href="{{ path('admin_reservation_new') }}" class="btn-pink"
               style="text-decoration:none; font-size:11px; padding:6px 14px; border-radius:8px;">
                ＋ Nouvelle réservation
            </a>
        </div>

        {% if reservations is empty %}
        <div style="text-align:center; padding:40px; background:white; border-radius:14px;
                    border:1px solid #ead5f0; color:#a78bca;">
            <div style="font-size:36px;">📭</div>
            <p style="margin-top:10px; font-size:13px; font-weight:600;">Aucune réservation pour cet événement</p>
        </div>
        {% else %}
        <div class="table-card">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Utilisateur</th>
                        <th>Date de réservation</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in reservations %}
                    <tr>
                        <td>{{ r.idReservation }}</td>
                        <td>
                            {% if r.utilisateur %}
                                <strong>{{ r.utilisateur.nom ?? '(sans nom)' }}</strong>
                                <div style="font-size:11px; color:#94a3b8;">{{ r.utilisateur.email }}</div>
                            {% else %}—{% endif %}
                        </td>
                        <td>{{ r.dateReservation|date('d/m/Y H:i') }}</td>
                        <td>
                            <form method="post" action="{{ path('admin_reservation_delete', {id: r.idReservation}) }}"
                                  onsubmit="return confirm('Supprimer cette réservation ?')" style="margin:0;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ r.idReservation) }}">
                                <button type="submit" style="background:#fee2e2; color:#dc2626; border:none;
                                        border-radius:6px; padding:4px 10px; font-size:11px; cursor:pointer;">
                                    🗑
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
