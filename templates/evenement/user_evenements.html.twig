{% extends 'base.html.twig' %}

{% block title %}Événements à venir — StartHub{% endblock %}

{% set active = 'events' %}

{% block body %}
<!-- HEADER BANNER (matches AfficherEvenementUser.fxml header) -->
<div class="page-header" style="gap:14px;">
    <div style="flex:1">
        <p class="page-header-title">Événements à venir</p>
        <p class="page-header-sub">Découvrez tous nos événements</p>
    </div>
    <form method="get" style="display:flex; align-items:center;">
        <input type="text" name="search" value="{{ search }}"
               placeholder="🔍  Rechercher un événement..."
               style="background:rgba(255,255,255,.92); border:none; border-radius:10px;
                      font-size:13px; width:260px; padding:10px 16px; outline:none;"
               onchange="this.form.submit()">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="prix_min" value="{{ prix_min }}">
        <input type="hidden" name="prix_max" value="{{ prix_max }}">
    </form>
    <span style="font-size:22px;">🔔</span>
</div>

<!-- FILTER / VIEW-TOGGLE BAR (matches AfficherEvenementUser.fxml filter bar) -->
<form method="get" class="filter-bar">
    <!-- View toggle buttons -->
    <a href="{{ path('user_evenements') }}"
       style="background:#A155B9; color:white; border-radius:20px; padding:7px 14px;
              font-size:12px; font-weight:700; text-decoration:none;">
        📅 Tous les événements
    </a>
    <a href="{{ path('user_mes_reservations') }}"
       style="background:#f3e8ff; color:#A155B9; border:1px solid #ead5f0; border-radius:20px;
              padding:7px 14px; font-size:12px; font-weight:700; text-decoration:none;">
        🎫 Mes Réservations
    </a>

    <div style="flex:1;"></div>

    <label style="font-size:12px; font-weight:700; color:#6b4d8a; margin:0;">Trier :</label>
    <select name="sort" class="form-select" style="width:auto; font-size:12px;" onchange="this.form.submit()">
        <option value="date_asc"  {% if sort == 'date_asc'  %}selected{% endif %}>Date ↑</option>
        <option value="date_desc" {% if sort == 'date_desc' %}selected{% endif %}>Date ↓</option>
        <option value="prix_asc"  {% if sort == 'prix_asc'  %}selected{% endif %}>Prix ↑</option>
        <option value="prix_desc" {% if sort == 'prix_desc' %}selected{% endif %}>Prix ↓</option>
        <option value="titre_asc" {% if sort == 'titre_asc' %}selected{% endif %}>Titre A→Z</option>
    </select>

    <label style="font-size:12px; font-weight:700; color:#6b4d8a; margin:0;">Prix :</label>
    <input type="number" name="prix_min" value="{{ prix_min }}" placeholder="min" min="0" step="0.5"
           class="form-control" style="width:72px; font-size:12px;">
    <span style="color:#9b77b5; font-size:12px;">→</span>
    <input type="number" name="prix_max" value="{{ prix_max }}" placeholder="max" min="0" step="0.5"
           class="form-control" style="width:72px; font-size:12px;">

    <input type="hidden" name="search" value="{{ search }}">

    <a href="{{ path('user_evenements') }}"
       style="color:#9b77b5; font-size:11px; text-decoration:none;
              padding:5px 10px; border:1px solid #ead5f0; border-radius:8px;">
        ✕ Réinitialiser
    </a>
</form>

<!-- CARDS (same Java card style: white + colored stripe) -->
{% if evenements is empty %}
<div style="text-align:center; padding:80px; background:white; border-radius:16px; color:#64748b;">
    <div style="font-size:56px;">🔭</div>
    <p style="font-size:16px; font-weight:600; margin-top:16px;">Aucun événement trouvé</p>
    <p style="font-size:13px; color:#c4a3d8;">Essayez de modifier vos filtres</p>
</div>
{% else %}
<div class="events-grid">
    {% for ev in evenements %}
    {% set isPast = not ev.futur %}
    <div style="background:white; border-radius:14px; width:265px; overflow:hidden;
                box-shadow:0 4px 12px rgba(0,0,0,.07);
                opacity:{% if isPast %}0.80{% else %}1{% endif %};
                border:1.5px solid var(--purple-border); transition:border-color .15s;"
         onmouseenter="this.style.borderColor='#d08ec1'"
         onmouseleave="this.style.borderColor='#ead5f0'">

        <!-- Colored stripe -->
        <div style="height:6px; background:{% if isPast %}#94a3b8{% else %}#A155B9{% endif %};"></div>

        <div style="padding:14px;">
            <!-- Status badge -->
            <span style="font-size:10px; font-weight:700;
                         color:{% if isPast %}#64748b{% else %}#059669{% endif %};
                         background:{% if isPast %}#f1f5f9{% else %}#d1fae5{% endif %};
                         border-radius:20px; padding:2px 8px;">
                {% if isPast %}🏁 Passé{% else %}✅ À venir{% endif %}
            </span>

            <!-- Title -->
            <p style="font-size:15px; font-weight:800; color:#0f172a; margin:8px 0 6px; line-height:1.3;">
                {{ ev.titre }}
            </p>

            <hr style="opacity:.4; margin:6px 0 10px;">

            <!-- Price badge -->
            <span style="display:inline-block; background:#f3e8ff; color:#A155B9; font-weight:800;
                         font-size:13px; padding:3px 10px; border-radius:20px; margin-bottom:8px;">
                💰 {{ ev.prix == 0 ? 'Gratuit' : ev.prix|number_format(2) ~ ' DT' }}
            </span>

            <!-- Info rows -->
            <p style="font-size:12px; color:#475569; margin:4px 0;">📅 {{ ev.dateEvenement|date('d/m/Y') }}</p>
            <p style="font-size:12px; color:#475569; margin:4px 0;">📍 {{ ev.lieu }}</p>
            <p style="font-size:12px; margin:4px 0 8px;
                      {% if ev.capacite <= 0 %}color:#dc2626; font-weight:700;
                      {% elseif ev.capacite <= 10 %}color:#dc2626;
                      {% else %}color:#475569;{% endif %}">
                👥
                {% if ev.capacite <= 0 %}
                    Complet
                {% elseif ev.capacite <= 10 %}
                    <strong>{{ ev.capacite }} place(s) restante(s) !</strong>
                {% else %}
                    {{ ev.capacite }} places
                {% endif %}
            </p>

            <!-- Description -->
            {% if ev.description %}
            <p style="font-size:11px; color:#94a3b8; font-style:italic; margin-bottom:12px; line-height:1.4;">
                {{ ev.description|slice(0,100) }}{% if ev.description|length > 100 %}...{% endif %}
            </p>
            {% endif %}

            <!-- Reserve button -->
            {% if ev.idEvenement in reserved_ids %}
                <button disabled
                        style="width:100%; background:#ede9fe; color:#7c3aed; border:1.5px solid #ddd6fe;
                               border-radius:10px; padding:9px; font-size:12px; font-weight:700; cursor:not-allowed;">
                    ✅ Déjà réservé
                </button>
            {% elseif ev.complet or isPast %}
                <button disabled
                        style="width:100%; background:#f1f5f9; color:#94a3b8; border:none;
                               border-radius:10px; padding:9px; font-size:12px; font-weight:700; cursor:not-allowed;">
                    {% if ev.complet %}Complet{% else %}Événement passé{% endif %}
                </button>
            {% else %}
                <form method="post" action="{{ path('user_checkout', {id: ev.idEvenement}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('checkout' ~ ev.idEvenement) }}">
                    <button type="submit"
                            style="width:100%; border:none; border-radius:10px; padding:9px;
                                   font-size:12px; font-weight:700; cursor:pointer; color:white;
                                   background:{% if ev.prix == 0 %}#059669{% else %}#A155B9{% endif %};
                                   box-shadow:0 3px 8px rgba(0,0,0,.15);">
                        {% if ev.prix == 0 %}🎫 Réserver (Gratuit){% else %}💳 Réserver — {{ ev.prix|number_format(2) }} DT{% endif %}
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

<div class="footer-pill" style="margin-top:20px;">
    <span>📅 Trouvez les meilleurs événements près de chez vous</span>
</div>
{% endblock %}
