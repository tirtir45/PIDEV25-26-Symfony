{% extends 'base.html.twig' %}

{% block title %}Admin — Gestion des Événements{% endblock %}

{% set active = 'admin_events' %}

{% block body %}
<!-- HEADER (matches AfficherEvenement.fxml header) -->
<div class="page-header" style="gap:14px;">
    <div style="flex:1">
        <p class="page-header-title">Gestion des Événements</p>
        <p class="page-header-sub">Administrez, filtrez et analysez vos événements</p>
    </div>
    <form method="get" style="display:flex; align-items:center;">
        <input type="text" name="search" value="{{ search }}" placeholder="🔍 Rechercher..."
               style="background:rgba(255,255,255,.92); border:none; border-radius:10px;
                      font-size:12px; width:200px; padding:8px 14px; outline:none;"
               onchange="this.form.submit()">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="prix_min" value="{{ prix_min }}">
        <input type="hidden" name="prix_max" value="{{ prix_max }}">
        <input type="hidden" name="statut" value="{{ statut }}">
    </form>
    <a href="{{ path('admin_reservation_index') }}"
       style="background:rgba(255,255,255,.18); color:white; border:1.5px solid rgba(255,255,255,.4);
              border-radius:10px; padding:8px 12px; font-size:11px; font-weight:700; text-decoration:none;">
        🎫 Réservations
    </a>
    <a href="{{ path('admin_evenement_new') }}"
       class="btn-pink" style="text-decoration:none; font-size:11px; padding:8px 12px;">
        ＋ Ajouter
    </a>
</div>

<!-- STATS ROW (matches AfficherEvenement.fxml stat cards) -->
<div class="stat-row">
    <div class="stat-card">
        <div class="stat-icon">📋</div>
        <div class="stat-value" style="color:#A155B9;">{{ stat_total }}</div>
        <div class="stat-label">Total Événements</div>
    </div>
    <div class="stat-card" style="border-color:#d1fae5;">
        <div class="stat-icon">✅</div>
        <div class="stat-value" style="color:#059669;">{{ stat_futur }}</div>
        <div class="stat-label">À venir</div>
    </div>
    <div class="stat-card" style="border-color:#dbeafe;">
        <div class="stat-icon">🎫</div>
        <div class="stat-value" style="color:#2563eb;">{{ stat_res }}</div>
        <div class="stat-label">Réservations</div>
    </div>
    <div class="stat-card" style="border-color:#fef9c3;">
        <div class="stat-icon">💰</div>
        <div class="stat-value" style="color:#d97706; font-size:20px;">{{ stat_revenu|number_format(2) }} DT</div>
        <div class="stat-label">Revenu (DT)</div>
    </div>
</div>

<!-- FILTER BAR (matches AfficherEvenement.fxml filter bar) -->
<form method="get" class="filter-bar">
    <label>Trier :</label>
    <select name="sort" class="form-select" style="width:auto;" onchange="this.form.submit()">
        <option value="date_asc"  {% if sort == 'date_asc'  %}selected{% endif %}>Date ↑</option>
        <option value="date_desc" {% if sort == 'date_desc' %}selected{% endif %}>Date ↓</option>
        <option value="prix_asc"  {% if sort == 'prix_asc'  %}selected{% endif %}>Prix ↑ (moins cher)</option>
        <option value="prix_desc" {% if sort == 'prix_desc' %}selected{% endif %}>Prix ↓ (plus cher)</option>
        <option value="titre_asc" {% if sort == 'titre_asc' %}selected{% endif %}>Titre A→Z</option>
    </select>

    <label>Statut :</label>
    <select name="statut" class="form-select" style="width:auto;" onchange="this.form.submit()">
        <option value=""      {% if statut == ''      %}selected{% endif %}>Tous</option>
        <option value="futur" {% if statut == 'futur' %}selected{% endif %}>À venir uniquement</option>
        <option value="passe" {% if statut == 'passe' %}selected{% endif %}>Passés uniquement</option>
    </select>

    <label>Prix :</label>
    <input type="number" name="prix_min" value="{{ prix_min }}" placeholder="min" min="0" step="0.5"
           class="form-control" style="width:72px;">
    <span style="color:#9b77b5; font-weight:700;">→</span>
    <input type="number" name="prix_max" value="{{ prix_max }}" placeholder="max" min="0" step="0.5"
           class="form-control" style="width:72px;">

    <input type="hidden" name="search" value="{{ search }}">

    <div style="flex:1"></div>
    <a href="{{ path('admin_evenement_index') }}"
       style="color:#9b77b5; font-size:11px; text-decoration:none;
              padding:5px 10px; border:1px solid #ead5f0; border-radius:8px;">
        ✕ Réinitialiser
    </a>
</form>

<!-- EVENTS GRID (cards matching AfficherEvenementController.buildCard) -->
{% if evenements is empty %}
    <div style="text-align:center; padding:60px; background:white; border-radius:16px; color:#64748b;">
        <div style="font-size:48px;">🔭</div>
        <p style="font-size:15px; font-weight:600; margin-top:12px;">Aucun événement trouvé.</p>
    </div>
{% else %}
<div class="events-grid">
    {% for ev in evenements %}
    {% set isPast = not ev.futur %}
    <div style="background:white; border-radius:14px; width:265px; overflow:hidden;
                box-shadow:0 4px 12px rgba(0,0,0,.07); cursor:default;
                opacity:{% if isPast %}0.80{% else %}1{% endif %};
                border:1.5px solid var(--purple-border); transition:border-color .15s;"
         onmouseenter="this.style.borderColor='#d08ec1'"
         onmouseleave="this.style.borderColor='#ead5f0'">

        <!-- Colored stripe (purple=future, gray=past) -->
        <div style="height:6px; background:{% if isPast %}#94a3b8{% else %}#A155B9{% endif %};"></div>

        <div style="padding:14px;">
            <!-- Status badge -->
            <span style="font-size:10px; font-weight:700;
                         color:{% if isPast %}#64748b{% else %}#059669{% endif %};
                         background:{% if isPast %}#f1f5f9{% else %}#d1fae5{% endif %};
                         border-radius:20px; padding:2px 8px;">
                {% if isPast %}🏁 Passé{% else %}✅ À venir{% endif %}
            </span>

            <!-- Title -->
            <p style="font-size:15px; font-weight:800; color:#0f172a; margin:8px 0 6px; line-height:1.3;">
                {{ ev.titre }}
            </p>

            <hr style="opacity:.4; margin:6px 0 10px;">

            <!-- Price badge -->
            <span style="display:inline-block; background:#f3e8ff; color:#A155B9; font-weight:800;
                         font-size:13px; padding:3px 10px; border-radius:20px; margin-bottom:8px;">
                💰 {{ ev.prix == 0 ? 'Gratuit' : ev.prix|number_format(2) ~ ' DT' }}
            </span>

            <!-- Info rows -->
            <p style="font-size:12px; color:#475569; margin:4px 0;">📅 {{ ev.dateEvenement|date('d/m/Y') }}</p>
            <p style="font-size:12px; color:#475569; margin:4px 0;">📍 {{ ev.lieu }}</p>
            <p style="font-size:12px; color:#475569; margin:4px 0 8px;">👥 {{ ev.capacite }} places</p>

            <!-- Description -->
            {% if ev.description %}
            <p style="font-size:11px; color:#94a3b8; font-style:italic; margin-bottom:10px; line-height:1.4;">
                {{ ev.description|slice(0,90) }}{% if ev.description|length > 90 %}...{% endif %}
            </p>
            {% endif %}

            <!-- Buttons row (✏ Modifier | 🗑 | 🎫 Réservations) -->
            <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:8px;">
                <a href="{{ path('admin_evenement_edit', {id: ev.idEvenement}) }}"
                   style="background:#A155B9; color:white; border:none; border-radius:8px;
                          padding:6px 10px; font-size:11px; font-weight:700; text-decoration:none;">
                    ✏ Modifier
                </a>
                <form method="post" action="{{ path('admin_evenement_delete', {id: ev.idEvenement}) }}"
                      onsubmit="return confirm('Supprimer « {{ ev.titre|e('js') }} » ?')" style="margin:0;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ev.idEvenement) }}">
                    <button type="submit"
                            style="background:#fef2f2; color:#dc2626; border:1px solid #fecaca;
                                   border-radius:8px; padding:6px 9px; font-size:11px; font-weight:700; cursor:pointer;">
                        🗑
                    </button>
                </form>
                <a href="{{ path('admin_evenement_show', {id: ev.idEvenement}) }}"
                   style="background:#dbeafe; color:#2563eb; border:1px solid #bfdbfe; border-radius:8px;
                          padding:6px 9px; font-size:11px; font-weight:700; text-decoration:none;">
                    🎫 Réservations
                </a>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

<div class="footer-pill" style="margin-top:20px;">
    <span>📅 {{ evenements|length }} événement(s) affiché(s)</span>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     📊 STATISTIQUES — embedded section
     ════════════════════════════════════════════════════════════════════════ -->
<div style="margin-top:32px;">
    <!-- Section header with toggle -->
    <div style="display:flex; align-items:center; gap:14px; margin-bottom:18px;">
        <div style="flex:1; height:1px; background:#ead5f0;"></div>
        <button onclick="toggleStats()" id="stats-toggle-btn"
                style="background:#f3e8ff; color:#A155B9; border:1.5px solid #ead5f0;
                       border-radius:20px; padding:8px 20px; font-size:12px; font-weight:700;
                       cursor:pointer; display:flex; align-items:center; gap:6px;">
            <span>📊</span> <span id="stats-toggle-label">Afficher les statistiques</span>
        </button>
        <div style="flex:1; height:1px; background:#ead5f0;"></div>
    </div>

    <div id="stats-section" style="display:none;">

        <!-- KPI mini-cards -->
        <div class="stat-row" style="margin-bottom:20px;">
            <div class="stat-card" style="border-color:#ddd6fe;">
                <div class="stat-icon">📅</div>
                <div class="stat-value" style="color:#7c3aed;">{{ stat_total }}</div>
                <div class="stat-label">Événements</div>
            </div>
            <div class="stat-card" style="border-color:#a7f3d0;">
                <div class="stat-icon">🟢</div>
                <div class="stat-value" style="color:#059669;">{{ stat_futur }}</div>
                <div class="stat-label">À venir</div>
            </div>
            <div class="stat-card" style="border-color:#e2e8f0;">
                <div class="stat-icon">🏁</div>
                <div class="stat-value" style="color:#64748b;">{{ count_passes }}</div>
                <div class="stat-label">Passés</div>
            </div>
            <div class="stat-card" style="border-color:#fbcfe8;">
                <div class="stat-icon">🎫</div>
                <div class="stat-value" style="color:#db2777;">{{ stat_res }}</div>
                <div class="stat-label">Réservations</div>
            </div>
            <div class="stat-card" style="border-color:#fde68a;">
                <div class="stat-icon">💰</div>
                <div class="stat-value" style="color:#d97706; font-size:18px;">{{ stat_revenu|number_format(2) }}<span style="font-size:11px;"> DT</span></div>
                <div class="stat-label">Revenu total</div>
            </div>
        </div>

        <!-- Charts 2×2 grid -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-bottom:20px;">

            <div style="background:white; border-radius:14px; padding:18px 20px;
                        border:1px solid #ead5f0; box-shadow:0 2px 8px rgba(161,85,185,.06);">
                <p style="font-size:13px; font-weight:800; color:#4a3068; margin:0 0 12px;">
                    📈 Réservations / mois (12 derniers mois)
                </p>
                <div id="chart_monthly" style="height:240px;"></div>
            </div>

            <div style="background:white; border-radius:14px; padding:18px 20px;
                        border:1px solid #ead5f0; box-shadow:0 2px 8px rgba(161,85,185,.06);">
                <p style="font-size:13px; font-weight:800; color:#4a3068; margin:0 0 12px;">
                    🍩 Futurs vs Passés
                </p>
                <div id="chart_donut" style="height:240px;"></div>
            </div>

            <div style="background:white; border-radius:14px; padding:18px 20px;
                        border:1px solid #ead5f0; box-shadow:0 2px 8px rgba(161,85,185,.06);">
                <p style="font-size:13px; font-weight:800; color:#4a3068; margin:0 0 12px;">
                    🏆 Top 5 événements les plus réservés
                </p>
                <div id="chart_top" style="height:240px;"></div>
            </div>

            <div style="background:white; border-radius:14px; padding:18px 20px;
                        border:1px solid #ead5f0; box-shadow:0 2px 8px rgba(161,85,185,.06);">
                <p style="font-size:13px; font-weight:800; color:#4a3068; margin:0 0 12px;">
                    💸 Revenu par événement payant
                </p>
                <div id="chart_revenu" style="height:240px;"></div>
            </div>

        </div>

    </div>{# /stats-section #}
</div>

{% endblock %}

{% block javascripts %}
<script src="https://www.gstatic.com/charts/loader.js"></script>
<script>
var statsLoaded = false;

function toggleStats() {
    var sec = document.getElementById('stats-section');
    var btn = document.getElementById('stats-toggle-label');
    if (sec.style.display === 'none') {
        sec.style.display = 'block';
        btn.textContent   = 'Masquer les statistiques';
        if (!statsLoaded) { google.charts.load('current',{packages:['corechart']}); google.charts.setOnLoadCallback(drawAllCharts); statsLoaded = true; }
    } else {
        sec.style.display = 'none';
        btn.textContent   = 'Afficher les statistiques';
    }
}

var dataMonthly = {{ count_by_month|json_encode|raw }};
var dataTop     = {{ top_evenements|json_encode|raw }};
var dataRevenu  = {{ revenu_par_ev|json_encode|raw }};
var cntFuturs   = {{ stat_futur }};
var cntPasses   = {{ count_passes }};

function drawAllCharts() { drawMonthly(); drawDonut(); drawTop(); drawRevenu(); }

function drawMonthly() {
    var rows = [['Mois','Réservations']];
    dataMonthly.forEach(function(r){ rows.push([r.month, parseInt(r.total)]); });
    if (rows.length===1) rows.push(['—',0]);
    var data = google.visualization.arrayToDataTable(rows);
    new google.visualization.ColumnChart(document.getElementById('chart_monthly')).draw(data,{
        legend:{position:'none'}, colors:['#A155B9'],
        chartArea:{width:'82%',height:'68%'},
        hAxis:{textStyle:{fontSize:10,color:'#64748b'}},
        vAxis:{minValue:0,format:'0',textStyle:{fontSize:10}},
        backgroundColor:'transparent'
    });
}

function drawDonut() {
    var data = google.visualization.arrayToDataTable([
        ['Statut','Nombre'],['À venir',cntFuturs],['Passés',cntPasses]
    ]);
    new google.visualization.PieChart(document.getElementById('chart_donut')).draw(data,{
        pieHole:0.42, colors:['#A155B9','#94a3b8'],
        legend:{position:'right',textStyle:{fontSize:11}},
        chartArea:{width:'86%',height:'82%'}, backgroundColor:'transparent'
    });
}

function drawTop() {
    var rows=[['Événement','Réservations',{role:'style'}]];
    var colors=['#A155B9','#F765A3','#c472d4','#8a4ca0','#e04ab0'];
    dataTop.forEach(function(r,i){
        rows.push([r.titre.length>18?r.titre.substr(0,16)+'…':r.titre, parseInt(r.total),'color:'+(colors[i]||'#A155B9')]);
    });
    if (rows.length===1) rows.push(['—',0,'color:#e2e8f0']);
    var data = google.visualization.arrayToDataTable(rows);
    new google.visualization.ColumnChart(document.getElementById('chart_top')).draw(data,{
        legend:{position:'none'},
        chartArea:{width:'80%',height:'68%'},
        hAxis:{textStyle:{fontSize:10,color:'#64748b'}},
        vAxis:{minValue:0,format:'0',textStyle:{fontSize:10}},
        backgroundColor:'transparent'
    });
}

function drawRevenu() {
    var rows=[['Événement','Revenu (DT)']];
    dataRevenu.forEach(function(r){
        rows.push([r.titre.length>20?r.titre.substr(0,18)+'…':r.titre, parseFloat(r.revenu)]);
    });
    if (rows.length===1) rows.push(['Aucun',0]);
    var data = google.visualization.arrayToDataTable(rows);
    new google.visualization.PieChart(document.getElementById('chart_revenu')).draw(data,{
        colors:['#A155B9','#F765A3','#c472d4','#8a4ca0','#e04ab0','#6b21a8','#d946ef'],
        legend:{position:'right',textStyle:{fontSize:10}},
        chartArea:{width:'80%',height:'82%'}, backgroundColor:'transparent'
    });
}
</script>
{% endblock %}
