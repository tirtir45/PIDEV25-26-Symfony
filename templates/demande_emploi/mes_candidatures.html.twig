{# templates/candidat/mes_candidatures.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mes Candidatures — StartHub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Styles partagés déjà créés dans les réponses précédentes */
        .page-header { display: flex; align-items: center; gap: 14px; background: linear-gradient(to right, #A155B9, #c472d4); border-radius: 16px; padding: 22px 28px; box-shadow: 0 6px 18px rgba(161, 85, 185, 0.35); margin-bottom: 20px; }
        .page-header-title { font-size: 26px; font-weight: 800; color: white; margin: 0; }
        .page-header-sub { font-size: 12px; color: rgba(255, 255, 255, 0.75); margin: 0; }
        .btn-outline { background-color: rgba(255, 255, 255, 0.18); color: white; font-weight: 700; border-radius: 10px; padding: 10px 18px; border: 1.5px solid rgba(255, 255, 255, 0.4); text-decoration: none; }
        .btn-pink { background-color: #F765A3; color: white; font-weight: 700; border-radius: 10px; padding: 10px 18px; text-decoration: none; box-shadow: 0 3px 10px rgba(247, 101, 163, 0.45); }
        .btn-purple { background-color: #A155B9; color: white; font-weight: 700; padding: 8px 16px; border-radius: 20px; border: none; }

        /* Styles spécifiques pour cette page */
        .candidatures-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; }
        .candidature-card { background: white; border-radius: 14px; overflow: hidden; border: 1px solid #ead5f0; box-shadow: 0 4px 12px rgba(161, 85, 185, 0.08); transition: transform 0.2s, box-shadow 0.2s; }
        .candidature-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(161, 85, 185, 0.12); }
        .card-header { padding: 20px; background: linear-gradient(135deg, #a155b9, #c472d4); color: white; }
        .card-header-expired { background: linear-gradient(135deg, #6b7280, #9ca3af); } /* Pour les offres expirées */
        .card-title { font-size: 18px; font-weight: 700; margin: 0; }
        .card-subtitle { font-size: 13px; margin: 4px 0 0 0; opacity: 0.8; }
        .card-body { padding: 20px; }
        .card-meta { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #64748b; margin-bottom: 8px; }
        
        .badge { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; text-transform: capitalize; }
        .badge-en-attente { background-color: #fffbeb; color: #b45309; }
        .badge-acceptée { background-color: #e7f7ef; color: #28a745; }
        .badge-refusée { background-color: #fbe9e9; color: #dc3545; }
    </style>
{% endblock %}

{% block body %}
<div style="padding: 28px; background-color: #fdf4fb;">

    <!-- HEADER -->
    <div class="page-header">
        <div style="flex:1">
            <p class="page-header-title">Mes candidatures</p>
            <p class="page-header-sub">
                {# Salue l'utilisateur et affiche le nombre de candidatures #}
                {% if app.session.get('user_nom') %}Bonjour {{ app.session.get('user_nom') }} — {% endif %}
                {{ candidatures|length }} candidature(s)
            </p>
        </div>
        <a href="{{ path('app_user_publication_index') }}" class="btn-outline">
            Retour aux offres
        </a>
    </div>
    
    {% if candidatures is empty %}
        <div style="text-align:center; padding:80px 20px; background:white; border-radius:16px;
                    border:1px solid #ead5f0; color:#a78bca;">
            <div style="font-size:56px;">📄</div>
            <p style="font-size:16px; font-weight:600; margin-top:16px;">Vous n'avez aucune candidature pour le moment.</p>
            <p style="font-size:13px; color:#c4a3d8; margin-bottom:20px;">Parcourez les offres d'emploi et trouvez votre prochain défi !</p>
            <a href="{{ path('app_user_publication_index') }}" class="btn-pink" style="text-decoration:none; display:inline-block;">
                Voir les offres d'emploi
            </a>
        </div>
    {% else %}
        <div class="candidatures-grid">
            {# Boucle sur les candidatures de l'utilisateur connecté #}
            {% for demande in candidatures %}
                <div class="candidature-card">
                    {# L'en-tête de la carte, avec l'offre d'emploi concernée #}
                    <div class="card-header {% if demande.getPublication() and demande.getPublication().getDate_expiration() < "now"|date("Y-m-d") %}card-header-expired{% endif %}">
                        <p class="card-title">
                            {% if demande.getPublication() %}{{ demande.getPublication().titre }}{% else %}Offre inconnue{% endif %}
                        </p>
                        <p class="card-subtitle">
                            {% if demande.getPublication() %}📍 {{ demande.getPublication().getLocalisation() }}{% endif %}
                        </p>
                    </div>

                    <div class="card-body">
                        <div class="card-meta" style="color:#A155B9; font-weight: 600;">
                            <span>🗓️</span>
                            Postulé le {{ demande.getDateDemande()|date('d/m/Y') }}
                        </div>
                        
                        <div style="margin: 12px 0;">
                            <span class="badge badge-{{ demande.getStatutDemande()|lower|replace({' ': '-'}) }}">
                                Statut : {{ demande.getStatutDemande() }}
                            </span>
                        </div>

                        <p style="font-size: 13px; color: #4b5563; line-height: 1.6; margin-top: 16px; border-left: 3px solid #f3e8f9; padding-left: 12px;">
                           Votre lettre de motivation : <br>
                           <em>"{{ demande.getLettreMotivation()|slice(0, 100) }}..."</em>
                        </p>

                        {# Boutons d'action pour le candidat #}
                        <div style="display:flex; gap:10px; margin-top:16px;">
                            {# Bouton "Voir l'offre" #}
                            <a href="{{ path('app_publication_show', {'publication_id': demande.getPublication().publication_id}) }}"
                               style="flex:1; background-color:#f3e8ff; color:#A155B9; border:1px solid #ead5f0; border-radius:10px;
                                      padding:9px; font-size:12px; font-weight:700; text-decoration:none; text-align:center;">
                                Voir l'offre
                            </a>

                            {# Bouton "Modifier" : n'est cliquable que si le statut est "En attente" #}
                            {% if demande.getStatutDemande() == 'En attente' %}
                                <a href="{{ path('app_demande_emploi_edit', {'id': demande.getDemande_id()}) }}"
                                   style="flex:1; background-color:#eef2ff; color:#4338ca; border-radius:10px;
                                          padding:9px; font-size:12px; font-weight:700; text-decoration:none; text-align:center;">
                                    ✏️ Modifier ma candidature
                                </a>
                            {% else %}
                                <span style="flex:1; background-color:#f1f5f9; color:#9ca3af; border-radius:10px; cursor:not-allowed;
                                             padding:9px; font-size:12px; font-weight:700; text-decoration:none; text-align:center;">
                                    ✏️ Modification verrouillée
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}