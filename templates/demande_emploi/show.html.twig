{% extends 'base_dashboard.html.twig' %}

{% block title %}Demande_emploi{% endblock %}

{% block body %}
    <h1>Demande_emploi</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Demande_id</th>
                <td>{{ demande_emploi.getDemande_id() }}</td>
            </tr>
            <tr>
                <th>Publication</th>
                <td>{{ demande_emploi.getPublication() ? demande_emploi.getPublication().getPublication_id() : '' }}</td>
            </tr>
            <tr>
                <th>Candidat</th>
                <td>{{ demande_emploi.getCandidat() ? demande_emploi.getCandidat().getId_utilisateur() : '' }}</td>
            </tr>
            <tr>
                <th>CvUrl</th>
                <td>{{ demande_emploi.getCvUrl() }}</td>
            </tr>
            <tr>
                <th>LettreMotivation</th>
                <td>{{ demande_emploi.getLettreMotivation() }}</td>
            </tr>
            <tr>
                <th>MotivationCiblee</th>
                <td>{{ demande_emploi.getMotivationCiblee() }}</td>
            </tr>
            <tr>
                <th>StatutDemande</th>
                <td>{{ demande_emploi.getStatutDemande() }}</td>
            </tr>
            <tr>
                <th>DateDemande</th>
                <td>{{ demande_emploi.getDateDemande() ? demande_emploi.getDateDemande()|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_demande_emploi_index') }}">back to list</a>

    <a href="{{ path('app_demande_emploi_edit', {'id': demande_emploi.getDemande_id()}) }}">edit</a>

    {{ include('demande_emploi/_delete_form.html.twig') }}
{% endblock %}