{# templates/demande_emploi/new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Postuler — StartHub{% endblock %}

{% block body %}
<div class="da-root">

    <header class="da-header">
        <div>
            <h1 class="da-header-title">📄 {% if is_admin|default(false) %}Ajouter une candidature{% else %}Postuler à une offre{% endif %}</h1>
            <p class="da-header-sub">
                {% if demande.publication %}
                    {{ demande.publication.titre }}
                {% else %}
                    Remplissez le formulaire ci-dessous
                {% endif %}
            </p>
        </div>
        {% if is_admin|default(false) %}
            <a href="{{ path('app_admin_publication_index') }}" class="da-btn-outline">← Retour</a>
        {% else %}
            <a href="{{ path('app_user_publication_index') }}" class="da-btn-outline">← Retour aux offres</a>
        {% endif %}
    </header>

    <main class="da-card">
        {{ form_start(form, {'action': path('app_demande_emploi_new', {'publication_id': demande.publication.publication_id|default('')})}) }}
        <div class="da-card-title">
            <span class="da-card-title-icon">▎</span>
            <span>{% if is_admin|default(false) %}Nouvelle Candidature{% else %}Ma Candidature{% endif %}</span>
        </div>
        <div class="da-divider"></div>

        {% if not form.vars.valid %}
            <div class="da-error">
                <strong>Veuillez corriger les erreurs ci-dessous :</strong>
                {{ form_errors(form) }}
            </div>
        {% endif %}

        <div class="da-form-grid">
            {# Publication (read-only for users, shown as info) #}
            {{ form_row(form.publication) }}

            {# Candidat only visible for admin #}
            {% if form.candidat is defined %}
                {{ form_row(form.candidat) }}
            {% endif %}

            {{ form_row(form.cvFile) }}
            {{ form_row(form.lettreMotivation) }}
            {{ form_row(form.motivationCiblee) }}

            {# Status and date only for admin #}
            {% if form.statutDemande is defined %}
                {{ form_row(form.statutDemande) }}
            {% endif %}
            {% if form.dateDemande is defined %}
                {{ form_row(form.dateDemande) }}
            {% endif %}
        </div>

        <div class="da-divider"></div>

        <div class="da-actions">
            {% if is_admin|default(false) %}
                <a href="{{ path('app_admin_publication_index') }}" class="da-btn-cancel">Annuler</a>
            {% else %}
                <a href="{{ path('app_user_publication_index') }}" class="da-btn-cancel">Annuler</a>
            {% endif %}
            <button type="submit" class="da-btn-submit">
                {% if is_admin|default(false) %}Ajouter la candidature{% else %}Envoyer ma candidature{% endif %}
            </button>
        </div>
        {{ form_end(form) }}
    </main>
</div>

<style>
.da-root { max-width: 720px; margin: 0 auto; padding: 0 1.5rem 3rem; }
.da-header {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    background: linear-gradient(135deg, #A155B9, #c472d4);
    border-radius: 14px; padding: 22px 28px; margin-bottom: 20px;
    box-shadow: 0 6px 18px rgba(161, 85, 185, 0.35);
}
.da-header-title { margin: 0; font-size: 22px; font-weight: 800; color: white; }
.da-header-sub { margin: 4px 0 0; font-size: 13px; color: rgba(255,255,255,.75); }
.da-btn-outline {
    background: rgba(255,255,255,.18); color: white; font-weight: 700; border-radius: 10px;
    padding: 10px 18px; border: 1.5px solid rgba(255,255,255,.4); text-decoration: none; font-size: 13px;
}
.da-card {
    background: white; border-radius: 14px; padding: 28px;
    border: 1px solid rgba(161, 85, 185, 0.15); box-shadow: 0 4px 14px rgba(0,0,0,.05);
}
.da-card-title { display: flex; align-items: center; gap: 8px; font-size: 1rem; font-weight: 700; color: #1a1523; }
.da-card-title-icon { color: #A155B9; font-size: 1.3rem; }
.da-divider { height: 1px; background: rgba(161, 85, 185, 0.12); margin: 18px 0; }
.da-error { background: #fee2e2; color: #991b1b; padding: .7rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: .82rem; }
.da-form-grid { display: flex; flex-direction: column; gap: 1rem; }
.da-actions { display: flex; gap: .75rem; justify-content: flex-end; }
.da-btn-cancel {
    padding: .65rem 1.2rem; border: 1.5px solid rgba(161,85,185,.25); border-radius: 10px;
    background: transparent; color: #4b5563; font-size: .85rem; font-weight: 600; text-decoration: none;
    display: inline-flex; align-items: center;
}
.da-btn-submit {
    padding: .65rem 1.4rem; border: none; border-radius: 10px; background: #A155B9; color: white;
    font-size: .85rem; font-weight: 700; cursor: pointer; transition: background .15s;
}
.da-btn-submit:hover { background: #8B3FA0; }
</style>
{% endblock %}