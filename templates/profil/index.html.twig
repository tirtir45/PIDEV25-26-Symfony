{# templates/profil/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon Profil - StartHub{% endblock %}

{% block body %}
<div class="container-fluid fade-in">
    <!-- Header with Profile Summary -->
    <div class="header mb-4">
        <div>
            <h1>Mon Profil</h1>
            <div class="page-subtitle">Gérez vos informations personnelles et professionnelles</div>
        </div>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Sidebar Profile Card -->
        <div class="col-lg-4">
            <div class="card-modern text-center p-4 h-100">
                <div class="position-relative d-inline-block mb-3">
                    <div class="avatar-large" style="width: 120px; height: 120px; margin: 0 auto; border-radius: 50%; overflow: hidden; border: 4px solid white; box-shadow: 0 4px 15px rgba(0,0,0,0.1); background: var(--primary);">
                        {% if user.photo %}
                            <img src="{{ asset(user.photo) }}" alt="{{ user.nom }}" style="width:100%; height:100%; object-fit:cover;">
                        {% else %}
                            <div style="font-size: 40px; color: white; height: 100%; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                                {{ user.nom|slice(0, 2)|upper }}
                            </div>
                        {% endif %}
                    </div>
                </div>
                
                <h3 class="fw-bold text-main mb-1">
                    {{ user.nom }}
                    {% if user.badgeVerifie %}
                        <span title="Compte vérifié" style="display:inline-flex;align-items:center;gap:3px;background:#dbeafe;color:#1d4ed8;border-radius:20px;padding:2px 10px;font-size:12px;font-weight:700;margin-left:6px;vertical-align:middle;">
                            ✔️ Vérifié
                        </span>
                    {% endif %}
                </h3>
                <div class="badge bg-primary-subtle text-primary rounded-pill px-3 mb-3">
                    {{ user.role ? user.role.nomRole : 'Utilisateur' }}
                </div>
                
                <p class="text-muted small mb-4">
                    {{ user.bio ?? 'Aucune bio renseignée.' }}
                </p>

                <div class="p-3 rounded-4 bg-light text-start mb-4">
                    <div class="mb-2">
                        <label class="small text-muted d-block">Email</label>
                        <span class="text-main">{{ user.email }}</span>
                    </div>
                    <div class="mb-0">
                        <label class="small text-muted d-block">Téléphone</label>
                        <span class="text-main">{{ user.telephone ?? '—' }}</span>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button onclick="toggleEditForm()" class="btn btn-primary" id="editToggleBtn">
                        <i class="bi bi-pencil-square me-2"></i> Modifier mon profil
                    </button>

                    {% if not user.badgeVerifie and app.session.get('user_role') != 'Administrateur' %}
                    <a href="{{ path('verification_request') }}" class="btn btn-outline-primary">
                        ✔️ Demander la vérification
                    </a>
                    {% elseif user.badgeVerifie %}
                    <div class="text-center">
                        <span style="background:#d1fae5;color:#065f46;border-radius:20px;padding:6px 16px;font-size:13px;font-weight:700;">
                            ✔️ Compte vérifié
                        </span>
                    </div>
                    {% endif %}
                    
                    {% if app.session.get('user_role') != 'Administrateur' %}
                    <form method="POST" action="{{ path('app_profile') }}" onsubmit="return confirm('Supprimer définitivement votre compte ? Cette action est irréversible.')">
                        <input type="hidden" name="action" value="delete">
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="bi bi-person-dash me-2"></i> Supprimer le compte
                        </button>
                    </form>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-8">
            <!-- Edit Section -->
            <div class="card-modern" id="edit-section" style="{{ errors is not empty ? '' : 'display:none;' }}">                <div class="card-header-modern border-bottom p-4 d-flex align-items-center justify-content-between">
                    <h4 class="mb-0">Détails du Compte</h4>
                    <button type="button" onclick="toggleEditForm()" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-lg"></i> Fermer
                    </button>
                </div>
                <div class="card-body-modern p-4">
                    {% if errors is not empty %}
                    <div style="background:#fef2f2;border:1.5px solid #ef4444;border-radius:10px;padding:14px 18px;margin-bottom:20px;">
                        <div style="font-weight:700;color:#dc2626;font-size:13px;margin-bottom:6px;"><i class="bi bi-exclamation-triangle-fill me-2"></i>Veuillez corriger les erreurs suivantes :</div>
                        <ul style="margin:0;padding-left:18px;color:#b91c1c;font-size:13px;">
                            {% for field, msg in errors %}
                            <li>{{ msg }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
                    <form method="POST" action="{{ path('app_profile') }}" class="row g-3" enctype="multipart/form-data">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Nom Complet</label>
                            <input type="text" name="nom" class="form-control {{ errors.nom is defined ? 'is-invalid' : '' }}" value="{{ user.nom }}" placeholder="Jean Dupont" required>
                            {% if errors.nom is defined %}<div class="invalid-feedback">{{ errors.nom }}</div>{% endif %}
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Adresse Email</label>
                            <input type="email" name="email" class="form-control {{ errors.email is defined ? 'is-invalid' : '' }}" value="{{ user.email }}" placeholder="jean@example.com" required>
                            {% if errors.email is defined %}<div class="invalid-feedback">{{ errors.email }}</div>{% endif %}
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">N° Téléphone</label>
                            <input type="tel" name="telephone" class="form-control {{ errors.telephone is defined ? 'is-invalid' : '' }}" value="{{ user.telephone ?? '' }}" placeholder="+216 ...">
                            {% if errors.telephone is defined %}<div class="invalid-feedback">{{ errors.telephone }}</div>{% endif %}
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Photo de Profil</label>
                            <input type="file" name="photo" class="form-control {{ errors.photo is defined ? 'is-invalid' : '' }}" accept="image/jpeg,image/png,image/webp">
                            {% if errors.photo is defined %}
                            <div style="background:#fef2f2;border:1.5px solid #ef4444;border-left:4px solid #dc2626;border-radius:8px;padding:10px 14px;margin-top:8px;display:flex;align-items:flex-start;gap:10px;">
                                <span style="font-size:20px;flex-shrink:0;">🚫</span>
                                <div>
                                    <div style="font-weight:700;color:#dc2626;font-size:13px;">Photo refusée par l'IA</div>
                                    <div style="color:#b91c1c;font-size:12px;margin-top:2px;">{{ errors.photo }}</div>
                                    <div style="color:#6b7280;font-size:11px;margin-top:6px;">
                                        ✅ Utilisez une vraie photo de votre visage, claire et bien éclairée.
                                    </div>
                                </div>
                            </div>
                            {% else %}
                            <div class="form-text mt-1 small">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                Votre photo sera analysée par IA (visage humain requis, pas de mèmes).
                            </div>
                            {% endif %}
                        </div>

                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold">Biographie</label>
                            <textarea name="bio" id="bioField" class="form-control {{ errors.bio is defined ? 'is-invalid' : '' }}" rows="3" placeholder="Parlez-nous de vous... (min. 10 caractères)" oninput="checkLen(this,'bio-msg',10)">{{ user.bio ?? '' }}</textarea>
                            {% if errors.bio is defined %}
                                <div class="invalid-feedback">{{ errors.bio }}</div>
                            {% endif %}
                            <div id="bio-msg" style="color:#dc2626;font-size:12px;margin-top:4px;display:{{ (user.bio is not null and user.bio|length > 0 and user.bio|length < 10) ? 'block' : 'none' }};">⚠️ La bio doit contenir au moins 10 caractères.</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold">Compétences</label>
                            <textarea name="competences" id="competencesField" class="form-control {{ errors.competences is defined ? 'is-invalid' : '' }}" rows="3" placeholder="Séparées par des virgules... (min. 4 caractères)" oninput="checkLen(this,'comp-msg',4)">{{ user.competences ?? '' }}</textarea>
                            {% if errors.competences is defined %}
                                <div class="invalid-feedback">{{ errors.competences }}</div>
                            {% endif %}
                            <div id="comp-msg" style="color:#dc2626;font-size:12px;margin-top:4px;display:{{ (user.competences is not null and user.competences|length > 0 and user.competences|length < 4) ? 'block' : 'none' }};">⚠️ Les compétences doivent contenir au moins 4 caractères.</div>
                        </div>

                        <div class="col-12 text-end mt-4">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save2 me-2"></i> Enregistrer les modifications
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
function checkLen(el, msgId, min) {
    const msg = document.getElementById(msgId);
    if (!msg) return;
    const len = el.value.length;
    if (len > 0 && len < min) {
        msg.style.display = 'block';
        el.style.borderColor = '#ef4444';
    } else {
        msg.style.display = 'none';
        el.style.borderColor = '';
    }
}

function toggleEditForm() {
    const section = document.getElementById('edit-section');
    const btn = document.getElementById('editToggleBtn');
    if (section.style.display === 'none') {
        section.style.display = '';
        section.scrollIntoView({behavior: 'smooth'});
        btn.innerHTML = '<i class="bi bi-x-lg me-2"></i> Annuler';
        btn.classList.replace('btn-primary', 'btn-outline-secondary');
    } else {
        section.style.display = 'none';
        btn.innerHTML = '<i class="bi bi-pencil-square me-2"></i> Modifier mon profil';
        btn.classList.replace('btn-outline-secondary', 'btn-primary');
    }
}

// Validation bio en temps réel
const bioField = document.getElementById('bioField');
const bioError = document.getElementById('bio-error');
const bioCount = document.getElementById('bio-count');
if (bioField) {
    const updateBio = () => {
        const len = bioField.value.length;
        if (bioCount) bioCount.textContent = len;
        if (bioError) {
            if (len > 0 && len < 10) {
                bioError.style.display = 'block';
                bioField.style.borderColor = '#ef4444';
            } else {
                bioError.style.display = 'none';
                bioField.style.borderColor = '';
            }
        }
    };
    bioField.addEventListener('input', updateBio);
    updateBio();
}

// Validation compétences en temps réel
const compField = document.getElementById('competencesField');
const compError = document.getElementById('competences-error');
const compCount = document.getElementById('comp-count');
if (compField) {
    const updateComp = () => {
        const len = compField.value.length;
        if (compCount) compCount.textContent = len;
        if (compError) {
            if (len > 0 && len < 4) {
                compError.style.display = 'block';
                compField.style.borderColor = '#ef4444';
            } else {
                compError.style.display = 'none';
                compField.style.borderColor = '';
            }
        }
    };
    compField.addEventListener('input', updateComp);
    updateComp();
}
</script>
{% endblock %}