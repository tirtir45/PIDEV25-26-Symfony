{% set currentRoute = app.request.attributes.get('_route')|default('') %}

<aside class="sidebar sidebar-entrepreneur">

    <div class="sidebar-logo">
        <div class="sidebar-logo-icon sidebar-logo-icon--entrepreneur">
            <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
            </svg>
        </div>
        <div>
            <div class="sidebar-logo-text">StartHub</div>
            <div class="sidebar-logo-tag">Membre</div>
        </div>
    </div>

    <nav class="sidebar-nav">

        <span class="sidebar-nav-section">Workspace</span>

        <a href="{{ path('member_dashboard') }}" class="nav-item {{ currentRoute starts with 'member_dashboard' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M9 16.17l-3.88-3.88L3 14.41 9 20.41 21 8.41 18.88 6.29z"/>
            </svg>
            <span>Mes Tâches</span>
        </a>

        <a href="#" class="nav-item {{ currentRoute starts with 'member_projets' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M10 4H4v6h6V4zm10 0h-6v6h6V4zM10 14H4v6h6v-6zm10 0h-6v6h6v-6z"/>
            </svg>
            <span>Mes Projets</span>
        </a>

        <span class="sidebar-nav-section">Plus</span>

        <a href="{{ path('user_evenements') }}" class="nav-item {{ currentRoute starts with 'user_evenement' or currentRoute starts with 'user_mes_reservations' or currentRoute starts with 'user_checkout' or currentRoute starts with 'user_payment' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
            </svg>
            <span>Événements</span>
        </a>

        <a href="{{ path('app_user_publication_index') }}" class="nav-item {{ currentRoute starts with 'app_user_publication' or currentRoute starts with 'app_publication' or currentRoute starts with 'app_candidat' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-2 .89-2 2v11c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zM10 4h4v2h-4V4zm10 15H4V8h16v11z"/>
            </svg>
            <span>Offres d'emploi</span>
        </a>

        <a href="#" class="nav-item {{ currentRoute starts with 'app_messages_' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M4 4h16v12H5.17L4 17.17V4z"/>
            </svg>
            <span>Messages</span>
        </a>

        <a href="{{ path('app_profile') }}" class="nav-item {{ currentRoute == 'app_profile' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4z"/>
            </svg>
            <span>Mon Profil</span>
        </a>

        <a href="{{ path('reclamation_index') }}" class="nav-item {{ currentRoute starts with 'reclamation' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/>
            </svg>
            <span>Réclamations</span>
        </a>

        <a href="{{ path('app_logout') }}" class="nav-item nav-item--logout">
            <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
            </svg>
            <span>Déconnexion</span>
        </a>

    </nav>

    <div class="sidebar-user-card">
        <div class="sidebar-user-avatar">
            {{ app.session.get('user_nom') ? app.session.get('user_nom')|slice(0,1)|upper : 'U' }}
        </div>
        <div class="sidebar-user-meta">
            <div class="sidebar-user-name">{{ app.session.get('user_nom')|default('Utilisateur') }}</div>
            <div class="sidebar-user-role">Membre</div>
        </div>
        <a href="#" class="sidebar-user-cog" title="Paramètres">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
            </svg>
        </a>
    </div>

</aside>
