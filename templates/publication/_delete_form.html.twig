<form method="post" action="{{ path('app_publication_delete', {'publication_id': publication.getPublication_id()}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    {# On remplace publication.publication_id par publication.getPublication_id() #}
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ publication.getPublication_id()) }}">
    <button class="btn">Delete</button>
</form>