{% extends 'base.html.twig' %}
{% block title %}Vérification du code{% endblock %}
{% block layout %}
<div class="auth-layout">
    <div class="auth-container">
        <div class="auth-left">
            <h1 class="auth-brand">StartHub</h1>
            <p class="auth-tagline">Vérification en cours</p>
            <ul class="auth-features">
                <li><i class="bi bi-shield-check"></i> Code OTP sécurisé</li>
                <li><i class="bi bi-clock"></i> Valide 10 minutes</li>
                <li><i class="bi bi-lock"></i> 3 tentatives max</li>
            </ul>
        </div>
        <div class="auth-right">
            <h2 class="auth-title">Vérification</h2>
            <p class="auth-subtitle">Saisissez le code à 6 chiffres affiché sur la page précédente</p>

            {% if error %}
                <div style="background:#fef2f2;border:1.5px solid #ef4444;border-radius:10px;padding:12px 16px;margin-bottom:16px;color:#dc2626;font-size:13px;font-weight:600;">⚠️ {{ error }}</div>
            {% endif %}

            <form method="POST" action="{{ path('password_verify') }}" class="auth-form">
                <div class="auth-field">
                    <label class="auth-label">Code OTP (6 chiffres)</label>
                    <input type="text" name="code" class="auth-input"
                           placeholder="000000" maxlength="6" pattern="[0-9]{6}"
                           style="font-size:28px;letter-spacing:10px;text-align:center;font-weight:800;"
                           required autofocus autocomplete="one-time-code">
                </div>
                <div style="text-align:center;margin-bottom:16px;">
                    <span style="font-size:13px;color:#9ca3af;">Code valide pendant </span>
                    <span id="countdown" style="font-weight:700;color:#7C5CFC;">10:00</span>
                </div>
                <button type="submit" class="btn-auth">Vérifier le code</button>
            </form>

            <div class="auth-footer">
                <p><a href="{{ path('password_forgot') }}">← Recommencer</a></p>
            </div>
        </div>
    </div>
</div>
<script>
let s = {{ ttl }};
const el = document.getElementById('countdown');
const t = setInterval(() => {
    s--;
    const m = Math.floor(s/60), sec = s%60;
    el.textContent = `${m}:${sec.toString().padStart(2,'0')}`;
    if (s <= 0) { clearInterval(t); el.textContent = 'Expiré'; el.style.color = '#ef4444'; }
}, 1000);
</script>
{% endblock %}
