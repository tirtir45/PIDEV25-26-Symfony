{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié{% endblock %}
{% block layout %}
<div class="auth-layout">
    <div class="auth-container">
        <div class="auth-left">
            <h1 class="auth-brand">StartHub</h1>
            <p class="auth-tagline">Réinitialisation sécurisée</p>
            <ul class="auth-features">
                <li><i class="bi bi-shield-lock"></i> Code OTP sécurisé</li>
                <li><i class="bi bi-clock"></i> Valide 10 minutes</li>
                <li><i class="bi bi-lock"></i> Chiffrement bcrypt</li>
            </ul>
        </div>
        <div class="auth-right">
            <h2 class="auth-title">Mot de passe oublié</h2>

            {% if otp %}
                {# Code généré — affiché directement #}
                <div style="background:#f3f0ff;border:2px solid #7C5CFC;border-radius:12px;padding:24px;text-align:center;margin-bottom:24px;">
                    <p style="font-size:14px;color:#374151;margin:0 0 12px;">Votre code de vérification :</p>
                    <div style="font-size:40px;font-weight:900;color:#7C5CFC;letter-spacing:12px;">{{ otp }}</div>
                    <p style="font-size:12px;color:#9ca3af;margin:12px 0 0;">Valide 10 minutes</p>
                </div>
                <a href="{{ path('password_verify') }}" class="btn-auth" style="display:block;text-align:center;text-decoration:none;">
                    Saisir le code →
                </a>
            {% else %}
                <p class="auth-subtitle">Saisissez votre adresse email</p>

                {% if error %}
                    <div style="background:#fef2f2;border:1.5px solid #ef4444;border-radius:10px;padding:12px 16px;margin-bottom:16px;color:#dc2626;font-size:13px;font-weight:600;">⚠️ {{ error }}</div>
                {% endif %}

                <form method="POST" action="{{ path('password_forgot') }}" class="auth-form">
                    <div class="auth-field">
                        <label class="auth-label">Adresse email</label>
                        <input type="email" name="email" class="auth-input" placeholder="votre@email.com" required autofocus>
                    </div>
                    <button type="submit" class="btn-auth">Générer le code</button>
                </form>

                <div class="auth-footer">
                    <p><a href="{{ path('app_login') }}">← Retour à la connexion</a></p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
