<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Bordereau de Livraison #{{ commande.idCommande }}</title>
    <style>
        body { font-family: 'Helvetica', sans-serif; color: #333; line-height: 1.6; }
        .header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #eee; padding-bottom: 10px; }
        .header h1 { margin: 0; color: #111; text-transform: uppercase; letter-spacing: 2px; }
        .info-grid { display: flex; justify-content: space-between; margin-bottom: 40px; }
        .info-box { width: 45%; }
        .info-box h3 { border-bottom: 1px solid #ddd; padding-bottom: 5px; margin-bottom: 10px; font-size: 14px; color: #666; }
        .table { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
        .table th { background: #f9f9f9; text-align: left; padding: 10px; border: 1px solid #eee; font-size: 13px; }
        .table td { padding: 10px; border: 1px solid #eee; font-size: 13px; }
        .total { text-align: right; font-size: 18px; font-weight: bold; margin-top: 20px; }
        .footer { position: fixed; bottom: 0; width: 100%; text-align: center; font-size: 10px; color: #aaa; border-top: 1px solid #eee; padding-top: 10px; }
        .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
        .badge-blue { background: #dbeafe; color: #1e40af; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Bordereau de Livraison</h1>
        <p>Commande #{{ commande.idCommande }} | Date: {{ commande.dateCreation|date('d/m/Y') }}</p>
    </div>

    <table style="width: 100%; margin-bottom: 40px;">
        <tr>
            <td style="width: 50%; vertical-align: top; border: none;">
                <div class="info-box">
                    <h3>EXPÉDITEUR (FOURNISSEUR)</h3>
                    <strong>{{ fournisseur.nom }}</strong><br>
                    Email: {{ fournisseur.email }}<br>
                    Tél: {{ fournisseur.telephone }}
                </div>
            </td>
            <td style="width: 50%; vertical-align: top; border: none;">
                <div class="info-box">
                    <h3>DESTINATAIRE</h3>
                    <strong>{{ entrepreneur.nom }}</strong><br>
                    {{ commande.adresseLivraison }}<br>
                    {{ commande.codePostal }}, {{ commande.villeLivraison }}<br>
                    Tél: {{ commande.telephoneLivraison }}
                </div>
            </td>
        </tr>
    </table>

    <table class="table">
        <thead>
            <tr>
                <th>Ressource</th>
                <th>Description</th>
                <th>Quantité</th>
                <th>Prix Unitaire</th>
                <th>Total Ligne</th>
            </tr>
        </thead>
        <tbody>
            {% for line in lines %}
                <tr>
                    <td>{{ resource_names[line.id_ressource.id_ressource]|default('Produit #' ~ line.id_ressource.id_ressource) }}</td>
                    <td>{{ line.id_ressource.description|default('-') }}</td>
                    <td>{{ line.quantite }}</td>
                    <td>{{ (line.prix_ligne / line.quantite)|number_format(2, '.', ' ') }} DT</td>
                    <td>{{ line.prix_ligne|number_format(2, '.', ' ') }} DT</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="total">
        TOTAL À PAYER: {{ commande.totalGlobal }} DT
    </div>

    <div class="footer">
        Document généré automatiquement par StartHub - Portail Entrepreneuriat.
    </div>
</body>
</html>
