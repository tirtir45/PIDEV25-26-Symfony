{% extends 'base.html.twig' %}

{% block title %}Vérification du billet — StartHub{% endblock %}

{% block body %}
<div class="page-header">
    <div style="flex:1">
        <p class="page-header-title">🔍 Vérification de billet</p>
        <p class="page-header-sub">Scan QR code — résultat de la validation</p>
    </div>
</div>

<div style="max-width:500px; margin:40px auto;">
    {% if valid %}
    {# ── VALID TICKET ── #}
    <div style="background:white; border-radius:20px; overflow:hidden;
                border:2px solid #a7f3d0; box-shadow:0 8px 28px rgba(5,150,105,.15);">
        <div style="background:linear-gradient(135deg,#059669,#10b981); padding:24px; text-align:center;">
            <div style="font-size:54px;">✅</div>
            <p style="color:white; font-size:20px; font-weight:800; margin:8px 0 4px;">Billet valide !</p>
            <p style="color:rgba(255,255,255,.8); font-size:13px; margin:0;">Ce billet est authentique</p>
        </div>

        <div style="padding:24px;">
            {# Event info #}
            {% if evenement %}
            <div style="background:#f0fdf4; border-radius:12px; padding:16px; margin-bottom:16px;
                        border:1px solid #bbf7d0;">
                <p style="font-size:12px; color:#065f46; font-weight:700; text-transform:uppercase;
                           letter-spacing:.04em; margin:0 0 10px;">Événement</p>
                <p style="font-size:17px; font-weight:800; color:#0f172a; margin:0 0 6px;">
                    {{ evenement.titre }}
                </p>
                <p style="font-size:13px; color:#475569; margin:3px 0;">
                    📅 {{ evenement.dateEvenement|date('d/m/Y à H:i') }}
                </p>
                <p style="font-size:13px; color:#475569; margin:3px 0;">
                    📍 {{ evenement.lieu }}
                </p>
                <p style="font-size:13px; margin:3px 0;">
                    💰
                    {% if evenement.prix == 0 %}
                        <span style="color:#059669; font-weight:700;">Gratuit</span>
                    {% else %}
                        <span style="color:#A155B9; font-weight:700;">{{ evenement.prix|number_format(2) }} DT</span>
                    {% endif %}
                </p>
            </div>
            {% endif %}

            {# Holder info #}
            {% if utilisateur %}
            <div style="background:#faf5ff; border-radius:12px; padding:16px; margin-bottom:16px;
                        border:1px solid #ead5f0;">
                <p style="font-size:12px; color:#6b4d8a; font-weight:700; text-transform:uppercase;
                           letter-spacing:.04em; margin:0 0 10px;">Titulaire</p>
                <p style="font-size:15px; font-weight:700; color:#0f172a; margin:0 0 4px;">
                    👤 {{ utilisateur.nom ?? utilisateur.email }}
                </p>
                <p style="font-size:12px; color:#64748b; margin:0;">{{ utilisateur.email }}</p>
            </div>
            {% endif %}

            {# Reservation info #}
            {% if reservation %}
            <div style="background:#f8fafc; border-radius:10px; padding:12px; border:1px solid #e2e8f0;
                        font-size:12px; color:#64748b;">
                <span style="font-weight:700;">Réservé le :</span>
                {{ reservation.dateReservation|date('d/m/Y à H:i') }}
                &nbsp;|&nbsp;
                <span style="font-weight:700;">Ref #{{ reservation.idReservation }}</span>
                &nbsp;|&nbsp;
                {% if reservation.statutPaiement == 'paid' %}
                    <span style="color:#059669; font-weight:700;">✅ Payé</span>
                {% elseif reservation.statutPaiement == 'free' %}
                    <span style="color:#1e40af; font-weight:700;">🆓 Gratuit</span>
                {% else %}
                    <span style="color:#854d0e; font-weight:700;">⏳ En attente</span>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </div>

    {% else %}
    {# ── INVALID TICKET ── #}
    <div style="background:white; border-radius:20px; overflow:hidden;
                border:2px solid #fca5a5; box-shadow:0 8px 28px rgba(220,38,38,.12);">
        <div style="background:linear-gradient(135deg,#dc2626,#ef4444); padding:24px; text-align:center;">
            <div style="font-size:54px;">❌</div>
            <p style="color:white; font-size:20px; font-weight:800; margin:8px 0 4px;">Billet invalide</p>
            <p style="color:rgba(255,255,255,.8); font-size:13px; margin:0;">Ce QR code n'est pas reconnu</p>
        </div>

        <div style="padding:28px; text-align:center;">
            <p style="font-size:14px; color:#64748b; margin-bottom:24px;">
                Ce billet n'existe pas dans notre système ou a été falsifié.
                Veuillez contacter l'organisateur.
            </p>
            <div style="background:#fee2e2; border-radius:12px; padding:16px; margin-bottom:20px;
                        border:1px solid #fca5a5;">
                <p style="font-size:13px; color:#991b1b; font-weight:600; margin:0;">
                    ⚠️ Accès refusé — billet non valide
                </p>
            </div>
        </div>
    </div>
    {% endif %}

    <div style="text-align:center; margin-top:24px;">
        <a href="{{ path('user_evenements') }}"
           style="color:#A155B9; font-size:13px; font-weight:600; text-decoration:none;">
            ← Retour aux événements
        </a>
    </div>
</div>
{% endblock %}
