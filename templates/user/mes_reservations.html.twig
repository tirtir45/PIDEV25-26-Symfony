{% extends 'base.html.twig' %}

{% block title %}Mes Réservations — StartHub{% endblock %}

{% block body %}
<!-- HEADER -->
<div class="page-header">
    <div style="flex:1">
        <p class="page-header-title">🎫 Mes Réservations</p>
        <p class="page-header-sub">
            {% if utilisateur %}Bonjour {{ utilisateur.nom ?? 'Utilisateur' }} — {% endif %}
            {{ reservations|length }} réservation(s)
        </p>
    </div>
    <a href="{{ path('user_evenements') }}"
       class="btn-outline-purple" style="color:white; border-color:rgba(255,255,255,.4); text-decoration:none;">
        📅 Tous les événements
    </a>
</div>

<!-- VIEW TOGGLE BAR -->
<div style="background:white; border-radius:12px; padding:12px 16px; border:1px solid #ead5f0;
            display:flex; gap:10px; margin-bottom:18px; box-shadow:0 2px 6px rgba(161,85,185,.06);">
    <a href="{{ path('user_evenements') }}"
       style="background:#f3e8ff; color:#A155B9; border:1px solid #ead5f0; border-radius:20px;
              padding:7px 14px; font-size:12px; font-weight:700; text-decoration:none;">
        📅 Tous les événements
    </a>
    <a href="{{ path('user_mes_reservations') }}"
       class="btn-purple" style="text-decoration:none; border-radius:20px; font-size:12px;">
        🎫 Mes Réservations
    </a>
</div>

{% if reservations is empty %}
<div style="text-align:center; padding:80px 0; background:white; border-radius:14px;
            border:1px solid #ead5f0; color:#a78bca;">
    <div style="font-size:56px;">🎟️</div>
    <p style="font-size:16px; font-weight:600; margin-top:16px;">Aucune réservation</p>
    <p style="font-size:13px; color:#c4a3d8; margin-bottom:20px;">Parcourez les événements et réservez votre place !</p>
    <a href="{{ path('user_evenements') }}" class="btn-pink"
       style="text-decoration:none; display:inline-block;">
        📅 Voir les événements
    </a>
</div>
{% else %}
<div class="events-grid">
    {% for r in reservations %}
    <div class="event-card">
        <div class="event-card-header" style="{% if r.evenement and not r.evenement.futur %}background: linear-gradient(135deg, #6b7280, #9ca3af);{% endif %}">
            <p class="event-card-title">
                {% if r.evenement %}{{ r.evenement.titre }}{% else %}Événement inconnu{% endif %}
            </p>
            <p class="event-card-lieu">
                {% if r.evenement %}📍 {{ r.evenement.lieu }}{% endif %}
            </p>
        </div>
        <div class="event-card-body">
            {% if r.evenement %}
                <div class="event-meta">📅 {{ r.evenement.dateEvenement|date('d/m/Y') }}</div>
            {% endif %}
            <div class="event-meta" style="color:#A155B9;">
                🕐 Réservé le {{ r.dateReservation|date('d/m/Y à H:i') }}
            </div>
            {% if r.evenement %}
                <div style="margin: 8px 0; display:flex; flex-wrap:wrap; gap:5px; align-items:center;">
                    <span class="event-prix-badge {% if r.evenement.prix == 0 %}event-price-free{% endif %}">
                        {% if r.evenement.prix == 0 %}🆓 Gratuit{% else %}{{ r.evenement.prix|number_format(2) }} DT{% endif %}
                    </span>
                    {% if r.evenement.futur %}
                        <span class="badge-futur">À venir</span>
                    {% else %}
                        <span style="background:#f1f5f9; color:#64748b; font-size:10px; padding:2px 8px; border-radius:20px; font-weight:600;">Passé</span>
                    {% endif %}
                    {# Payment status badge #}
                    {% if r.statutPaiement == 'paid' %}
                        <span style="background:#d1fae5; color:#065f46; font-size:10px; padding:2px 8px; border-radius:20px; font-weight:700;">✅ Payé</span>
                    {% elseif r.statutPaiement == 'free' %}
                        <span style="background:#dbeafe; color:#1e40af; font-size:10px; padding:2px 8px; border-radius:20px; font-weight:700;">🆓 Gratuit</span>
                    {% else %}
                        <span style="background:#fef9c3; color:#854d0e; font-size:10px; padding:2px 8px; border-radius:20px; font-weight:700;">⏳ En attente</span>
                    {% endif %}
                </div>
            {% endif %}

            {# PDF download button — only for confirmed (paid or free) #}
            {% if r.statutPaiement in ['paid', 'free'] %}
            <a href="{{ path('user_facture', {id: r.idReservation}) }}"
               style="display:block; width:100%; text-align:center; margin-top:10px;
                      background:#f3e8ff; color:#A155B9; border:1.5px solid #ead5f0;
                      border-radius:10px; padding:8px; font-size:12px; font-weight:700;
                      text-decoration:none;">
                📄 Télécharger le billet PDF
            </a>
            {% endif %}

            <!-- CANCEL BUTTON -->
            <form method="post" action="{{ path('user_annuler_reservation', {id: r.idReservation}) }}"
                  onsubmit="return confirm('Annuler cette réservation ?')" style="margin-top:8px;">
                <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ r.idReservation) }}">
                <button type="submit"
                        style="width:100%; background:#fee2e2; color:#dc2626; border:none;
                               border-radius:10px; padding:9px; font-size:12px; font-weight:700; cursor:pointer;">
                    ✕ Annuler la réservation
                </button>
            </form>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

<div class="footer-pill">
    <span>🎫 {{ reservations|length }} réservation(s) au total</span>
</div>
{% endblock %}
