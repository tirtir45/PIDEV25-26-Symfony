{# templates/project/sprints.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Sprints — {{ projet.titre }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('styles/project.css') }}">
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .sprint-card {
        background: #fff;
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 16px;
        overflow: hidden;
        height: 100%;
        transition: all .2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sprint-card:hover {
        box-shadow: 0 8px 28px rgba(0,0,0,.12);
        transform: translateY(-3px);
    }

    .sprint-card-header {
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(0,0,0,.06);
        background: #fafafa;
    }

    .sprint-name {
        font-weight: 700;
        font-size: 1rem;
        color: #1a1a1a;
    }

    .sprint-status {
        font-size: .65rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .sprint-actif    { background: #eaf3de; color: #3b6d11; }
    .sprint-planifie { background: #faeeda; color: #854f0b; }
    .sprint-termine  { background: #f1efe8; color: #5f5e5a; }

    .sprint-card-body {
        padding: 1.25rem;
    }

    .sprint-objective {
        font-size: .8rem;
        color: #666;
        line-height: 1.5;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(0,0,0,.05);
    }

    .sprint-dates {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: .75rem;
        color: #888;
        margin-bottom: 1.25rem;
        background: #f8f9fa;
        padding: 0.6rem 1rem;
        border-radius: 10px;
    }

    .sprint-date-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .sprint-metrics {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }

    .sprint-metric {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 0.7rem;
        text-align: center;
    }

    .sprint-metric-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a1a;
        line-height: 1.2;
        margin-bottom: 0.25rem;
    }

    .sprint-metric-label {
        font-size: .65rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: .04em;
        font-weight: 600;
    }

    .active-sprint-banner {
        background: linear-gradient(135deg, #eaf3de 0%, #f0f9e8 100%);
        border: 1px solid #c0dd97;
        border-radius: 14px;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .active-sprint-banner-icon {
        width: 40px;
        height: 40px;
        background: #eaf3de;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #c0dd97;
    }

    .active-sprint-banner-content strong {
        font-size: .9rem;
        color: #27500a;
        display: block;
    }

    .active-sprint-banner-content span {
        font-size: .75rem;
        color: #3b6d11;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 1rem;
        color: #999;
    }

    .empty-state svg {
        opacity: 0.2;
        margin-bottom: 1rem;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }

    .empty-state p { font-size: .85rem; margin: 0; }
    .empty-state .cta { font-size: .8rem; margin-top: 0.5rem; opacity: 0.6; }

    @media (max-width: 768px) {
        .sprint-card-header {
            padding: 0.875rem 1rem;
        }
        
        .sprint-card-body {
            padding: 1rem;
        }
        
        .sprint-metric-value {
            font-size: 1rem;
        }
        
        .active-sprint-banner {
            flex-direction: column;
            text-align: center;
        }
        
        .active-sprint-banner .ms-auto {
            margin-left: 0 !important;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="page-header d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h1 class="h4 mb-1 fw-bold">Sprints <span class="text-muted fw-normal">— {{ projet.titre }}</span></h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="{{ path('entrepreneur_projets_liste') }}">Projets</a></li>
                <li class="breadcrumb-item active">Sprints</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-3">
        {% include 'project/_project_nav.html.twig' %}
        <button class="btn btn-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#modalNouveauSprint">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nouveau sprint
        </button>
    </div>
</div>

{% if sprintActif %}
<div class="active-sprint-banner">
    <div class="active-sprint-banner-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b6d11" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
    </div>
    <div class="active-sprint-banner-content">
        <strong>{{ sprintActif.nom }}</strong>
        <span>
            {{ sprintActif.date_debut ? sprintActif.date_debut|date('d/m/Y') : '?' }}
            →
            {{ sprintActif.date_fin ? sprintActif.date_fin|date('d/m/Y') : '?' }}
        </span>
    </div>
    <span class="sprint-status sprint-actif ms-auto">🏃 En cours</span>
</div>
{% endif %}

<div class="row g-3">
    {% for sprint in sprints %}
    <div class="col-md-6 col-xl-4">
        <div class="sprint-card">
            <div class="sprint-card-header">
                <span class="sprint-name">{{ sprint.nom }}</span>
                <span class="sprint-status sprint-{{ sprint.statut }}">
                    {% if sprint.statut == 'actif' %}🏃{% elseif sprint.statut == 'planifie' %}📅{% else %}✅{% endif %}
                    {{ sprint.statut|capitalize }}
                </span>
            </div>
            <div class="sprint-card-body">
                {% if sprint.objectif %}
                    <div class="sprint-objective">🎯 {{ sprint.objectif }}</div>
                {% endif %}

                <div class="sprint-dates">
                    <div class="sprint-date-item">
                        📅 Début<br>
                        <strong>{{ sprint.date_debut ? sprint.date_debut|date('d/m/Y') : 'N/A' }}</strong>
                    </div>
                    <div>→</div>
                    <div class="sprint-date-item">
                        📅 Fin<br>
                        <strong>{{ sprint.date_fin ? sprint.date_fin|date('d/m/Y') : 'N/A' }}</strong>
                    </div>
                </div>

                <div class="sprint-metrics">
                    <div class="sprint-metric">
                        <div class="sprint-metric-value">{{ sprint.capacite_equipe ?? 0 }}h</div>
                        <div class="sprint-metric-label">Capacité</div>
                    </div>
                    <div class="sprint-metric">
                        <div class="sprint-metric-value">{{ sprint.velocite_prevue ?? 0 }} pts</div>
                        <div class="sprint-metric-label">Vélocité</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-12">
        <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <p>Aucun sprint créé pour ce projet.</p>
            <p class="cta">✨ Cliquez sur « Nouveau sprint » pour commencer votre premier sprint</p>
        </div>
    </div>
    {% endfor %}
</div>

{# Modal nouveau sprint #}
<div class="modal fade" id="modalNouveauSprint" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-xl" style="border-radius: 20px; overflow: hidden;">
            <div class="modal-header border-0" style="padding: 1.5rem 1.75rem;">
                <h5 class="modal-title fw-bold">🚀 Nouveau sprint</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            {{ form_start(sprintForm) }}
            <div class="modal-body px-4 pt-2 pb-3">
                <div class="mb-3">{{ form_row(sprintForm.nom) }}</div>
                <div class="mb-3">{{ form_row(sprintForm.objectif) }}</div>
                <div class="row g-3">
                    <div class="col-6">{{ form_row(sprintForm.date_debut) }}</div>
                    <div class="col-6">{{ form_row(sprintForm.date_fin) }}</div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-4">{{ form_row(sprintForm.statut) }}</div>
                    <div class="col-4">{{ form_row(sprintForm.capacite_equipe) }}</div>
                    <div class="col-4">{{ form_row(sprintForm.velocite_prevue) }}</div>
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4">
                <button type="button" class="btn btn-light btn-sm px-4" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary btn-sm px-4">Créer le sprint</button>
            </div>
            {{ form_end(sprintForm) }}
        </div>
    </div>
</div>
{% endblock %}