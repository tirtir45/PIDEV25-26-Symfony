{# templates/project/calendar.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Calendrier — {{ projet.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/project.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --primary-light: #818cf8;
            --primary-bg: #eef2ff;
            --primary-glow: rgba(99, 102, 241, 0.2);
        }

        .calendar-wrap {
            background: #fff;
            border: 1px solid rgba(0,0,0,.06);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,.04);
            transition: box-shadow .3s ease;
        }

        .calendar-wrap:hover {
            box-shadow: 0 8px 40px rgba(0,0,0,.08);
        }

        .calendar-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid rgba(0,0,0,.05);
            background: #ffffff;
        }

        .calendar-toolbar-left {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .calendar-toolbar-title {
            font-weight: 600;
            font-size: 0.95rem;
            color: #1e1b4b;
            margin-left: 0.5rem;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .calendar-view-btns {
            display: flex;
            gap: 6px;
            background: #f8fafc;
            padding: 4px;
            border-radius: 14px;
        }

        .calendar-view-btn {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 6px 16px;
            border-radius: 10px;
            border: none;
            background: transparent;
            cursor: pointer;
            color: #64748b;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .calendar-view-btn:hover {
            background: rgba(99, 102, 241, 0.1);
            color: #6366f1;
        }

        .calendar-view-btn.active {
            background: #6366f1;
            color: #fff;
            box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
        }

        .calendar-nav-btn {
            width: 34px;
            height: 34px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            background: #fff;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            color: #64748b;
        }

        .calendar-nav-btn:hover {
            background: #eef2ff;
            border-color: #6366f1;
            color: #6366f1;
            transform: scale(1.02);
        }

        .today-btn {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            background: #fff;
            cursor: pointer;
            color: #64748b;
            transition: all 0.2s ease;
        }

        .today-btn:hover {
            background: #6366f1;
            border-color: #6366f1;
            color: #fff;
        }

        #calendar {
            padding: 1rem;
            background: #fff;
        }

        /* FullCalendar violet theme */
        .fc {
            --fc-border-color: rgba(0,0,0,.06);
            --fc-button-bg-color: transparent;
            --fc-button-border-color: transparent;
            --fc-button-hover-bg-color: rgba(99,102,241,.08);
            --fc-button-active-bg-color: #6366f1;
            --fc-today-bg-color: rgba(99,102,241,.04);
        }

        .fc .fc-toolbar { display: none !important; }

        .fc .fc-col-header-cell {
            background: #fafcff;
            border-bottom: 2px solid rgba(99,102,241,.1);
        }

        .fc .fc-col-header-cell-cushion {
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #94a3b8;
            padding: 1rem 0;
        }

        .fc .fc-daygrid-day-number {
            font-size: 0.85rem;
            font-weight: 500;
            color: #334155;
            padding: 8px 10px;
            transition: all 0.2s ease;
        }

        .fc .fc-day-today .fc-daygrid-day-number {
            background: #6366f1;
            color: #fff;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 4px;
            box-shadow: 0 4px 12px rgba(99,102,241,.4);
        }

        .fc .fc-day-today {
            background: rgba(99,102,241,.04) !important;
        }

        .fc .fc-event {
            border-radius: 10px !important;
            border: none !important;
            font-size: 0.7rem !important;
            font-weight: 600 !important;
            padding: 5px 10px !important;
            cursor: pointer;
            transition: all 0.2s ease;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: #fff;
            box-shadow: 0 2px 6px rgba(99,102,241,.25);
        }

        .fc .fc-event:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(99,102,241,.35);
        }

        .fc .fc-daygrid-dot-event .fc-event-title {
            font-weight: 600;
        }

        .fc .fc-list-event:hover td {
            background: rgba(99,102,241,.05) !important;
        }

        .fc .fc-list-day-cushion {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            background: #f8fafc !important;
            padding: 12px !important;
            color: #6366f1;
        }

        .fc td, .fc th {
            border-color: rgba(0,0,0,.05) !important;
        }

        .fc .fc-scrollgrid {
            border: none !important;
            border-radius: 16px;
            overflow: hidden;
        }

        .fc .fc-daygrid-day-frame {
            transition: background 0.2s ease;
        }

        .fc .fc-daygrid-day-frame:hover {
            background: rgba(99,102,241,.02);
        }

        @media (max-width: 768px) {
            .calendar-toolbar {
                flex-direction: column;
                align-items: stretch;
                padding: 1rem;
            }
            
            .calendar-toolbar-left {
                justify-content: center;
            }
            
            .calendar-view-btns {
                justify-content: center;
            }
            
            #calendar {
                padding: 0.5rem;
            }
            
            .fc .fc-daygrid-day-number {
                font-size: 0.7rem;
                padding: 4px 6px;
            }
        }

        @media (max-width: 480px) {
            .calendar-view-btn {
                padding: 4px 12px;
                font-size: 0.65rem;
            }
            
            .today-btn {
                padding: 4px 10px;
                font-size: 0.65rem;
            }
            
            .calendar-nav-btn {
                width: 28px;
                height: 28px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="page-header d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h1 class="h4 mb-1 fw-bold" style="background: linear-gradient(135deg, #6366f1, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Calendrier <span class="text-muted fw-normal" style="-webkit-text-fill-color: #94a3b8;">— {{ projet.titre }}</span></h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="{{ path('entrepreneur_projets_liste') }}">Projets</a></li>
                <li class="breadcrumb-item active">Calendrier</li>
            </ol>
        </nav>
    </div>
    {% include 'project/_project_nav.html.twig' %}
</div>

<div class="calendar-wrap">
    <div class="calendar-toolbar" id="calendarToolbar">
        <div class="calendar-toolbar-left">
            <button class="calendar-nav-btn" id="btnPrev" title="Précédent">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="today-btn" id="btnToday">Aujourd'hui</button>
            <button class="calendar-nav-btn" id="btnNext" title="Suivant">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <span class="calendar-toolbar-title" id="calTitle"></span>
        </div>
        <div class="calendar-view-btns">
            <button class="calendar-view-btn active" data-view="dayGridMonth">Mois</button>
            <button class="calendar-view-btn" data-view="timeGridWeek">Semaine</button>
            <button class="calendar-view-btn" data-view="listWeek">Liste</button>
        </div>
    </div>
    <div id="calendar"></div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        let calendar;

        const updateTitle = () => {
            const el = document.getElementById('calTitle');
            if (el && calendar) el.textContent = calendar.view.title;
        };

        calendar = new FullCalendar.Calendar(document.getElementById('calendar'), {
            initialView: 'dayGridMonth',
            locale: 'fr',
            headerToolbar: false,
            height: 'auto',
            events: {{ eventsJson|raw }},
            eventClick: info => {
                if (info.event.extendedProps.url) {
                    window.location.href = info.event.extendedProps.url;
                }
            },
            datesSet: updateTitle,
            eventDidMount: info => {
                info.el.title = info.event.title;
            },
            dayMaxEvents: true,
            weekends: true,
            nowIndicator: true,
            eventTimeFormat: { hour: '2-digit', minute: '2-digit', hour12: false }
        });

        calendar.render();
        updateTitle();

        document.getElementById('btnPrev').addEventListener('click', () => { calendar.prev(); updateTitle(); });
        document.getElementById('btnNext').addEventListener('click', () => { calendar.next(); updateTitle(); });
        document.getElementById('btnToday').addEventListener('click', () => { calendar.today(); updateTitle(); });

        document.querySelectorAll('.calendar-view-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.calendar-view-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                calendar.changeView(btn.dataset.view);
                updateTitle();
            });
        });
        
        const handleResize = () => {
            if (window.innerWidth < 768) {
                calendar.setOption('dayMaxEventRows', 2);
            } else {
                calendar.setOption('dayMaxEventRows', true);
            }
        };
        
        window.addEventListener('resize', handleResize);
        handleResize();
    });
    </script>
{% endblock %}