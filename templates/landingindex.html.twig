{# templates/landing/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}StartHub - La plateforme qui propulse votre startup{% endblock %}

{% block body %}
{# Ajout d'un wrapper qui neutralise le layout parent #}
<div class="landing-page-wrapper">
<div class="landing-root">

    {# ─────────────────── HERO SECTION ─────────────────── #}
    <section class="hero">
        <div class="hero-bg"></div>
        <div class="hero-glow glow-1"></div>
        <div class="hero-glow glow-2"></div>
        
        <div class="container">
            <div class="hero-inner">
                <div class="hero-content">
                    <div class="hero-badge">
                        <span class="pulse-dot"></span>
                        La plateforme des innovateurs
                    </div>
                    <h1 class="hero-title">
                        Donnez vie à vos<br>
                        <span class="gradient-text">idées audacieuses</span>
                    </h1>
                    <p class="hero-description">
                        Gérez vos projets, constituez votre équipe, accédez aux ressources et événements 
                        qui feront décoller votre startup. Tout est centralisé sur une seule plateforme.
                    </p>
                    <div class="hero-actions">
                        <a href="{{ path('app_register') }}" class="btn-primary">
                            <span>Commencer gratuitement</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="5" y1="12" x2="19" y2="12"/>
                                <polyline points="12 5 19 12 12 19"/>
                            </svg>
                        </a>
                        <a href="#features" class="btn-secondary">
                            <span>Explorer</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"/>
                            </svg>
                        </a>
                    </div>
                    <div class="hero-stats">
                        <div class="stat-card">
                            <span class="stat-number">500+</span>
                            <span class="stat-label">Startups accompagnées</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number">50k+</span>
                            <span class="stat-label">Utilisateurs actifs</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number">98%</span>
                            <span class="stat-label">Satisfaction client</span>
