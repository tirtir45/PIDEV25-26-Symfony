<style>
/* RESET COMPLET - Neutralise le layout parent */
.landing-page-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  background: var(--bg-gray);
  z-index: 1000;
}

/* Suppression de toutes les marges du parent */
body {
  margin: 0 !important;
  padding: 0 !important;
  overflow-x: hidden;
}

/* ───────────────────────────────────────────────────────── */
/* LANDING PAGE - DESIGN MODERNE & ÉLÉGANT                   */
/* ───────────────────────────────────────────────────────── */

:root {
  --primary: #7c3aed;
  --primary-light: #8b5cf6;
  --primary-dark: #6d28d9;
  --primary-soft: #e9e3ff;
  --primary-glow: rgba(124, 58, 237, 0.15);
  
  --bg-dark: #0f0b1a;
  --bg-card: #ffffff;
  --bg-gray: #faf9ff;
  
  --text-main: #1a1523;
  --text-secondary: #4c4566;
  --text-muted: #8b7fa8;
  
  --border-light: rgba(124, 58, 237, 0.08);
  --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.03);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.05);
  --shadow-lg: 0 20px 40px rgba(0, 0, 0, 0.08);
  --shadow-xl: 0 30px 60px rgba(0, 0, 0, 0.12);
}

.landing-root {
  min-height: 100vh;
  width: 100%;
  background: var(--bg-gray);
}

.container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 2rem;
}

/* Gradient Text */
.gradient-text {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* ─── HERO SECTION ─── */
.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 4rem 0 6rem;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 30% 40%, rgba(124, 58, 237, 0.04) 0%, transparent 60%);
  pointer-events: none;
}

.hero-glow {
  position: absolute;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.3;
  pointer-events: none;
}

.glow-1 {
  background: var(--primary);
  top: -200px;
  right: -100px;
}

.glow-2 {
  background: var(--primary-light);
  bottom: -200px;
  left: -100px;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  position: relative;
  z-index: 2;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(124, 58, 237, 0.08);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(124, 58, 237, 0.15);
  border-radius: 100px;
  padding: 0.4rem 1.2rem;
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--primary);
  margin-bottom: 1.8rem;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  background: var(--primary);
  border-radius: 50%;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.2); }
}

.hero-title {
  font-size: 3.5rem;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin-bottom: 1.5rem;
  color: var(--text-main);
}

.hero-description {
  font-size: 1.1rem;
  color: var(--text-secondary);
