{% set currentRoute = app.request.attributes.get('_route')|default('') %}

<aside class="sidebar sidebar-entrepreneur"> {# Using entrepreneur style for consistency #}

    <div class="sidebar-logo">
        <div class="sidebar-logo-icon">
            <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm0 1.9L18 6.6V11c0 4.25-2.84 8.05-6 9.09-3.16-1.04-6-4.84-6-9.09V6.6L12 3.9z"/>
            </svg>
        </div>
        <div>
            <div class="sidebar-logo-text">StartHub</div>
            <div class="sidebar-logo-tag">Admin
                {% if app.session.get('user_id') %}
                    {% set userId = app.session.get('user_id') %}
                    {# Badge vérifié affiché si disponible en session #}
                {% endif %}
            </div>
        </div>
    </div>

    {# User card #}
    <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,0.1);display:flex;align-items:center;gap:10px;margin-bottom:8px;">
        <div style="width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex-shrink:0;overflow:hidden;">
            {% set photo = app.session.get('user_photo') %}
            {% if photo %}
                <img src="{{ asset(photo) }}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
            {% else %}
                {{ app.session.get('user_nom')|default('A')|slice(0,1)|upper }}
            {% endif %}
        </div>
        <div style="flex:1;min-width:0;">
            <div style="font-size:13px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                {{ app.session.get('user_nom')|default('Admin') }}
                {% if app.session.get('user_badge') %}
                <span style="background:rgba(255,255,255,0.2);border-radius:20px;padding:1px 7px;font-size:10px;font-weight:700;margin-left:4px;">✔️ Vérifié</span>
                {% endif %}
            </div>
            <div style="font-size:11px;color:rgba(255,255,255,0.6);">Administrateur</div>
        </div>
    </div>

    <nav class="sidebar-nav">

        <span class="sidebar-nav-section">Utilisateur</span>

        <a href="{{ path('app_profile') }}" class="nav-item {{ currentRoute == 'app_profile' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            <span>Mon Profil</span>
        </a>

        <a href="{{ path('reclamation_index') }}" class="nav-item {{ currentRoute == 'reclamation_index' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
            <span>Réclamations</span>
        </a>

        <a href="#" class="nav-item {{ currentRoute starts with 'admin_offres' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-2 .89-2 2v11c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zM10 4h4v2h-4V4zm10 15H4V8h16v11z"/></svg>
            <span>Offres d'emploi</span>
        </a>

        <a href="#" class="nav-item {{ currentRoute starts with 'admin_projets' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M10 4H4v6h6V4zm10 0h-6v6h6V4zM10 14H4v6h6v-6zm10 0h-6v6h6v-6z"/></svg>
            <span>Mes Projets</span>
        </a>

        <a href="#" class="nav-item {{ currentRoute starts with 'admin_messages' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M4 4h16v12H5.17L4 17.17V4m0-2c-1.1 0-2 .9-2 2v15.51L5.51 18H20c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H4z"/></svg>
            <span>Messages</span>
        </a>

        <span class="sidebar-nav-section">Administration</span>
        <a href="{{ path('admin_dashboard') }}" class="nav-item {{ currentRoute == 'admin_dashboard' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M10 4H4v6h6V4zm10 0h-6v6h6V4zM10 14H4v6h6v-6zm10 0h-6v6h6v-6z"/></svg>
            <span>Gestion Projets</span>
        </a>
        <a href="{{ path('admin_user_index') }}" class="nav-item {{ currentRoute starts with 'admin_user' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0C9.66 11 11 9.66 11 8s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
            <span>Gestion Utilisateurs</span>
        </a>

        <a href="{{ path('admin_reclamation_index') }}" class="nav-item {{ currentRoute starts with 'admin_reclamation' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
            <span>Gestion Réclamations</span>
        </a>

        <a href="{{ path('admin_moderation_index') }}" class="nav-item {{ currentRoute starts with 'admin_moderation' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm0 1.9L18 6.6V11c0 4.25-2.84 8.05-6 9.09-3.16-1.04-6-4.84-6-9.09V6.6L12 3.9z"/></svg>
            <span>Centre Modération Shop</span>
        </a>

        <a href="#" class="nav-item {{ currentRoute starts with 'admin_gestion_evenements' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z"/></svg>
            <span>Gestion Événements</span>
        </a>

        <a href="#" class="nav-item {{ currentRoute starts with 'admin_gestion_recrutement' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 6c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2m0 10c2.7 0 5.8 1.29 6 2H6c.23-.72 3.31-2 6-2m0-12C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 10c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            <span>Gestion Recrutement</span>
        </a>

        <a href="{{ path('admin_verification_index') }}" class="nav-item {{ currentRoute starts with 'admin_badge' or currentRoute starts with 'admin_verification' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <span>Badge Vérifiée</span>
        </a>

        <a href="#" class="nav-item {{ currentRoute starts with 'admin_historique' ? 'is-active' : '' }}">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            <span>Historique Connexions</span>
        </a>

        <a href="{{ path('app_logout') }}" class="nav-item nav-item--logout">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
            <span>Déconnexion</span>
        </a>

    </nav>

</aside>
