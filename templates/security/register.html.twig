<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StartHub — Inscription</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }

        body {
            background: linear-gradient(135deg, #A155B9 0%, #c472d4 50%, #fdf4fb 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, sans-serif;
            padding: 24px;
        }

        .auth-card {
            background: white;
            border-radius: 20px;
            padding: 36px 44px;
            width: 100%;
            max-width: 460px;
            box-shadow: 0 20px 60px rgba(161,85,185,.35);
        }

        .auth-logo {
            text-align: center;
            margin-bottom: 24px;
        }

        .auth-logo .icon {
            width: 52px; height: 52px;
            background: linear-gradient(135deg, #A155B9, #c472d4);
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 8px;
            box-shadow: 0 6px 16px rgba(161,85,185,.4);
        }

        .auth-title { font-size: 22px; font-weight: 800; color: #2d1b4e; margin: 0; }
        .auth-sub   { font-size: 12px; color: #94a3b8; margin: 3px 0 0; }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #4a3068;
            margin-bottom: 5px;
        }

        .form-control {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 10px 14px;
            font-size: 13px;
        }

        .form-control:focus {
            border-color: #A155B9;
            box-shadow: 0 0 0 3px rgba(161,85,185,.15);
        }

        .btn-register {
            width: 100%;
            background: linear-gradient(135deg, #F765A3, #e0409a);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(247,101,163,.4);
            transition: opacity .15s;
        }

        .btn-register:hover { opacity: .9; }

        .error-box {
            background: #fee2e2; color: #991b1b;
            border: 1px solid #fca5a5; border-radius: 10px;
            padding: 10px 14px; font-size: 13px;
            font-weight: 600; margin-bottom: 14px;
        }

        .role-badge {
            display: inline-flex; align-items: center; gap: 6px;
            background: #f3e8ff; color: #A155B9;
            border-radius: 20px; padding: 5px 12px;
            font-size: 12px; font-weight: 600;
            margin-bottom: 16px;
        }

        .link-login { text-align: center; font-size: 13px; color: #64748b; margin-top: 16px; }
        .link-login a { color: #A155B9; font-weight: 700; text-decoration: none; }
        .link-login a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo">
            <div class="icon">🚀</div>
            <h1 class="auth-title">Créer un compte</h1>
            <p class="auth-sub">Rejoignez la communauté StartHub</p>
        </div>

        <div class="role-badge">
            👤 Compte Entrepreneur (vous pouvez voir et réserver des événements)
        </div>

        {% for msg in app.flashes('error') %}
            <div class="error-box">❌ {{ msg }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        <div class="mb-3">
            {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nom) }}
            {{ form_errors(form.nom) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.email) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.motDePasse.first, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.motDePasse.first) }}
            {{ form_errors(form.motDePasse.first) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.motDePasse.second, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.motDePasse.second) }}
            {{ form_errors(form.motDePasse) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.telephone, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.telephone) }}
            {{ form_errors(form.telephone) }}
        </div>

        <button type="submit" class="btn-register">
            ✅ Créer mon compte
        </button>

        {{ form_end(form) }}

        <div class="link-login">
            Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
        </div>
    </div>
</body>
</html>
