<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StartHub — Connexion</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }

        body {
            background: linear-gradient(135deg, #A155B9 0%, #c472d4 50%, #fdf4fb 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .auth-card {
            background: white;
            border-radius: 20px;
            padding: 40px 44px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 60px rgba(161,85,185,.35);
        }

        .auth-logo {
            text-align: center;
            margin-bottom: 28px;
        }

        .auth-logo .icon {
            width: 56px; height: 56px;
            background: linear-gradient(135deg, #A155B9, #c472d4);
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            margin-bottom: 10px;
            box-shadow: 0 6px 16px rgba(161,85,185,.4);
        }

        .auth-title {
            font-size: 24px;
            font-weight: 800;
            color: #2d1b4e;
            margin: 0;
        }

        .auth-sub {
            font-size: 13px;
            color: #94a3b8;
            margin: 4px 0 0;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #4a3068;
            margin-bottom: 5px;
        }

        .form-control {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 10px 14px;
            font-size: 13px;
            transition: border-color .15s, box-shadow .15s;
        }

        .form-control:focus {
            border-color: #A155B9;
            box-shadow: 0 0 0 3px rgba(161,85,185,.15);
            outline: none;
        }

        .btn-login {
            width: 100%;
            background: linear-gradient(135deg, #A155B9, #c472d4);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(161,85,185,.4);
            transition: opacity .15s;
        }

        .btn-login:hover { opacity: .9; }

        .error-box {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
            border-radius: 10px;
            padding: 11px 14px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .divider {
            text-align: center;
            color: #94a3b8;
            font-size: 12px;
            margin: 18px 0;
            position: relative;
        }

        .divider::before, .divider::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 42%;
            height: 1px;
            background: #e2e8f0;
        }

        .divider::before { left: 0; }
        .divider::after  { right: 0; }

        .link-register {
            text-align: center;
            font-size: 13px;
            color: #64748b;
        }

        .link-register a {
            color: #A155B9;
            font-weight: 700;
            text-decoration: none;
        }

        .link-register a:hover { text-decoration: underline; }

        .remember-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            font-size: 12px;
        }

        .remember-row label { color: #64748b; cursor: pointer; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo">
            <div class="icon">🚀</div>
            <h1 class="auth-title">StartHub</h1>
            <p class="auth-sub">Connectez-vous à votre espace</p>
        </div>

        {% if error %}
            <div class="error-box">
                ❌
                {% if error.messageKey == 'Invalid credentials.' %}
                    Email ou mot de passe incorrect.
                {% else %}
                    {{ error.messageData['%reason%'] ?? error.message }}
                {% endif %}
            </div>
        {% endif %}

        {% for msg in app.flashes('error') %}
            <div class="error-box">❌ {{ msg }}</div>
        {% endfor %}

        <form method="post" action="{{ path('app_login') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="mb-3">
                <label class="form-label">📧 Email</label>
                <input type="email" name="email" class="form-control"
                       value="{{ last_username }}"
                       placeholder="email@example.com" required autofocus>
            </div>

            <div class="mb-3">
                <label class="form-label">🔒 Mot de passe</label>
                <input type="password" name="password" class="form-control"
                       placeholder="Votre mot de passe" required>
            </div>

            <div class="remember-row">
                <label>
                    <input type="checkbox" name="_remember_me" style="accent-color:#A155B9;">
                    Se souvenir de moi
                </label>
            </div>

            <button type="submit" class="btn-login">
                Connexion →
            </button>
        </form>

        <div class="divider">ou</div>

        <div class="link-register">
            Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a>
        </div>
    </div>
</body>
</html>