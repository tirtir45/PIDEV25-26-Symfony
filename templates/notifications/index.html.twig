{% extends 'base.html.twig' %}
{% block title %}Notifications{% endblock %}
{% block body %}
<div class="container-fluid fade-in px-4 py-3">
    <div class="d-flex align-items-center gap-3 mb-4">
        <h1 style="font-size:20px;font-weight:700;margin:0;">Notifications</h1>
        <span class="badge rounded-pill" style="background:#EDE9FF;color:#7C5CFC;">{{ notifications|length }}</span>
    </div>

    {% if notifications is empty %}
        <div style="background:#fff;border:1px solid #EAE8F8;border-radius:14px;padding:60px;text-align:center;color:#9ca3af;">
            <i class="bi bi-bell-slash" style="font-size:40px;display:block;margin-bottom:12px;"></i>
            <p style="font-size:14px;margin:0;">Aucune notification pour le moment.</p>
        </div>
    {% else %}
        <div style="display:flex;flex-direction:column;gap:10px;">
            {% for n in notifications %}
            <div style="background:#fff;border:1px solid {{ n.lu ? '#EAE8F8' : '#c4b8f5' }};border-left:4px solid {{ n.type == 'success' ? '#22c55e' : (n.type == 'error' ? '#ef4444' : (n.type == 'warning' ? '#f59e0b' : '#7C5CFC')) }};border-radius:12px;padding:16px 20px;display:flex;align-items:flex-start;gap:14px;{{ n.lu ? '' : 'background:#faf8ff;' }}">
                <div style="width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:{{ n.type == 'success' ? '#d1fae5' : (n.type == 'error' ? '#fee2e2' : (n.type == 'warning' ? '#fef3c7' : '#EDE9FF')) }};">
                    <i class="bi {{ n.type == 'success' ? 'bi-check-circle-fill' : (n.type == 'error' ? 'bi-x-circle-fill' : (n.type == 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-bell-fill')) }}" style="color:{{ n.type == 'success' ? '#16a34a' : (n.type == 'error' ? '#dc2626' : (n.type == 'warning' ? '#b45309' : '#7C5CFC')) }};font-size:16px;"></i>
                </div>
                <div style="flex:1;">
                    <div style="font-size:14px;font-weight:600;color:#1a1040;margin-bottom:3px;">{{ n.titre }}</div>
                    <div style="font-size:13px;color:#374151;line-height:1.5;">{{ n.message }}</div>
                    <div style="font-size:11px;color:#9ca3af;margin-top:6px;">{{ n.createdAt|date('d/m/Y à H:i') }}</div>
                </div>
                {% if n.lien %}
                <a href="{{ n.lien }}" style="flex-shrink:0;font-size:12px;color:#7C5CFC;font-weight:600;text-decoration:none;padding:5px 12px;border:1px solid #c4b8f5;border-radius:8px;">Voir →</a>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
