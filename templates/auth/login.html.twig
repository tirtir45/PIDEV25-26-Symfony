{% extends 'base.html.twig' %}

{% block title %}Connexion - StartHub{% endblock %}

{% block layout %}
    <div class="auth-layout">
        <div class="auth-container">
            <!-- Left Pane -->
            <div class="auth-left">
                <h1 class="auth-brand">StartHub</h1>
                <p class="auth-tagline">Bienvenue de retour</p>
                <ul class="auth-features">
                    <li><i class="bi bi-check-circle"></i> Accédez à votre espace</li>
                    <li><i class="bi bi-check-circle"></i> Gérez vos projets</li>
                    <li><i class="bi bi-check-circle"></i> Restez connecté</li>
                </ul>
            </div>

            <!-- Right Pane -->
            <div class="auth-right">
                <h2 class="auth-title">Connexion</h2>
                <p class="auth-subtitle">Content de vous revoir !</p>

                {% if error %}
                    <div class="alert alert-danger rounded-4 mb-4 border-0 shadow-sm" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                        {{ error }}
                    </div>
                {% endif %}

                <form method="POST" action="{{ path('app_login') }}" class="auth-form" id="loginForm" novalidate>
                    <div class="auth-field">
                        <label class="auth-label">Email</label>
                        <input type="email" name="email" id="email" class="auth-input" placeholder="mail@example.com" required>
                        <span class="small text-danger" id="email-error"></span>
                    </div>

                    <div class="auth-field">
                        <label class="auth-label">Mot de passe</label>
                        <input type="password" name="password" id="password" class="auth-input" placeholder="••••••••" required>
                        <span class="small text-danger" id="password-error"></span>
                    </div>

                    <button type="submit" class="btn-auth" id="loginSubmitBtn">Se connecter</button>

                    <div class="h-captcha" data-sitekey="{{ captchaSiteKey }}" style="margin-bottom:16px;"></div>
                </form>
                <script src="https://js.hcaptcha.com/1/api.js" async defer></script>

                <script>
                const loginForm = document.getElementById('loginForm');
                const emailInput = document.getElementById('email');
                const passwordInput = document.getElementById('password');

                function validateLoginEmail() {
                    const val = emailInput.value.trim();
                    const errorSpan = document.getElementById('email-error');
                    
                    if (val === '') {
                        emailInput.classList.add('is-invalid');
                        emailInput.classList.remove('is-valid');
                        errorSpan.textContent = 'L\'adresse email est requise.';
                        errorSpan.style.display = 'block';
                        return false;
                    }

                    const isValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
                    if (!isValid) {
                        emailInput.classList.add('is-invalid');
                        emailInput.classList.remove('is-valid');
                        errorSpan.textContent = 'Veuillez entrer un email valide.';
                        errorSpan.style.display = 'block';
                        return false;
                    } else {
                        emailInput.classList.remove('is-invalid');
                        emailInput.classList.add('is-valid');
                        errorSpan.textContent = '';
                        errorSpan.style.display = 'none';
                        return true;
                    }
                }

                function validateLoginPassword() {
                    const val = passwordInput.value.trim();
                    const errorSpan = document.getElementById('password-error');
                    
                    if (val === '') {
                        passwordInput.classList.add('is-invalid');
                        passwordInput.classList.remove('is-valid');
                        errorSpan.textContent = 'Le mot de passe est requis.';
                        errorSpan.style.display = 'block';
                        return false;
                    } else {
                        passwordInput.classList.remove('is-invalid');
                        passwordInput.classList.add('is-valid');
                        errorSpan.textContent = '';
                        errorSpan.style.display = 'none';
                        return true;
                    }
                }

                emailInput.addEventListener('input', validateLoginEmail);
                passwordInput.addEventListener('input', validateLoginPassword);

                loginForm.addEventListener('submit', function(e) {
                    const isEmailValid = validateLoginEmail();
                    const isPasswordValid = validateLoginPassword();

                    if (!isEmailValid || !isPasswordValid) {
                        e.preventDefault();
                        if (!isEmailValid) emailInput.focus();
                        else if (!isPasswordValid) passwordInput.focus();
                    }
                });
                </script>

                <div class="auth-footer">
                    <p>Vous n'avez pas de compte ? <a href="{{ path('app_register') }}">S'inscrire</a></p>
                    <p><a href="{{ path('password_forgot') }}" style="color:#9ca3af;font-size:13px;">Mot de passe oublié ?</a></p>
                    <p><a href="{{ path('password_forgot') }}" style="color:#9ca3af;font-size:13px;">Mot de passe oublié ?</a></p>
                    <div class="mt-3">
                        <a href="{{ path('app_home') }}" class="text-muted text-decoration-none small">
                            <i class="bi bi-arrow-left"></i> Retour à l'accueil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}