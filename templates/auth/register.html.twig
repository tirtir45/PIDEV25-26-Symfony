{% extends 'base.html.twig' %}

{% block title %}S'inscrire - StartHub{% endblock %}

{% block layout %}
    <div class="auth-layout">
        <div class="auth-container">
            <!-- Left Pane -->
            <div class="auth-left">
                <h1 class="auth-brand">StartHub</h1>
                <p class="auth-tagline">Rejoignez notre communauté</p>
                <ul class="auth-features">
                    <li><i class="bi bi-star-fill"></i> Opportunités sans limites</li>
                    <li><i class="bi bi-person-check-fill"></i> Réseau professionnel puissant</li>
                    <li><i class="bi bi-lightning-fill"></i> Support et mentorship</li>
                </ul>
            </div>

            <!-- Right Pane -->
            <div class="auth-right">
                <h2 class="auth-title">Créer un compte</h2>
                <p class="auth-subtitle">Remplissez les informations ci-dessous</p>

                {% if error %}
                    <div id="registerError" style="background:#fef2f2;border:2px solid #ef4444;border-radius:10px;padding:14px 18px;margin-bottom:20px;display:flex;align-items:center;gap:10px;">
                        <i class="bi bi-exclamation-triangle-fill" style="color:#ef4444;font-size:18px;flex-shrink:0;"></i>
                        <span style="color:#dc2626;font-weight:600;font-size:13px;">{{ error }}</span>
                    </div>
                    <script>document.getElementById('registerError').scrollIntoView({behavior:'smooth'});</script>
                {% endif %}

                <form method="POST" action="{{ path('app_register') }}" class="auth-form" id="registerForm" novalidate>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="auth-field">
                                <label class="auth-label">Nom complet <span class="text-danger">*</span></label>
                                <input type="text" name="nom" id="nom" class="auth-input" placeholder="Entrez votre nom">
                                <span class="small text-danger" id="nom-error"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="auth-field">
                                <label class="auth-label">Email <span class="text-danger">*</span></label>
                                <input type="email" name="email" id="email" class="auth-input" placeholder="mail@example.com">
                                <span class="small text-danger" id="email-error"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="auth-field">
                                <label class="auth-label">Téléphone</label>
                                <input type="tel" name="telephone" id="telephone" class="auth-input" placeholder="+216 ...">
                                <span class="small text-danger" id="telephone-error"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="auth-field">
                                <label class="auth-label">Rôle <span class="text-danger">*</span></label>
                                <select name="role_id" id="role" class="auth-input">
                                    <option value="">-- Choisir un rôle --</option>
                                    {% for role in roles %}
                                        {% if role.nomRole in ['Candidat', 'Entrepreneur', 'Fournisseur'] %}
                                            <option value="{{ role.id }}">{{ role.nomRole }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                                <span class="small text-danger" id="role-error"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="auth-field">
                                <label class="auth-label">Mot de passe <span class="text-danger">*</span></label>
                                <input type="password" name="password" id="password" class="auth-input" placeholder="••••••••">
                                <span class="small text-danger" id="password-error"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="auth-field">
                                <label class="auth-label">Confirmer <span class="text-danger">*</span></label>
                                <input type="password" name="confirm" id="confirm" class="auth-input" placeholder="••••••••">
                                <span class="small text-danger" id="confirm-error"></span>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn-auth w-100">S'inscrire</button>
                </form>

                <div class="auth-footer">
                    <p>Vous avez déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a></p>
                    <div class="mt-3">
                        <a href="{{ path('app_home') }}" class="text-muted text-decoration-none small">
                            <i class="bi bi-arrow-left"></i> Retour à l'accueil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    const form = document.getElementById('registerForm');
    const inputs = form.querySelectorAll('.auth-input');

    const validationRules = {
        nom: {
            test: (val) => /^[a-zA-ZÀ-ÿ\s\-]{2,50}$/.test(val),
            requiredMsg: 'Le nom est obligatoire.',
            invalidMsg: 'Le nom doit contenir entre 2 et 50 lettres (sans chiffres).'
        },
        email: {
            test: (val) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val),
            requiredMsg: 'L\'adresse email est obligatoire.',
            invalidMsg: 'Veuillez entrer une adresse email valide.'
        },
        telephone: {
            test: (val) => !val || /^[0-9]{8,15}$/.test(val),
            requiredMsg: '', // Optional in model
            invalidMsg: 'Le numéro de téléphone doit contenir 8 à 15 chiffres.'
        },
        role: {
            test: (val) => val !== '',
            requiredMsg: 'Veuillez choisir un rôle.',
            invalidMsg: 'Veuillez choisir un rôle.'
        },
        password: {
            test: (val) => val.length >= 6,
            requiredMsg: 'Le mot de passe est obligatoire.',
            invalidMsg: 'Le mot de passe doit contenir au moins 6 caractères.'
        },
        confirm: {
            test: (val) => val === document.getElementById('password').value,
            requiredMsg: 'Veuillez confirmer votre mot de passe.',
            invalidMsg: 'Les mots de passe ne correspondent pas.'
        }
    };

    function validateField(fieldId) {
        const input = document.getElementById(fieldId);
        const val = input.value.trim();
        const rule = validationRules[fieldId === 'role' ? 'role' : fieldId];
        const errorSpan = document.getElementById(`${fieldId}-error`);

        if (!rule) return true;

        if (val === '' && rule.requiredMsg) {
            input.classList.add('is-invalid');
            input.classList.remove('is-valid');
            errorSpan.textContent = rule.requiredMsg;
            errorSpan.style.display = 'block';
            return false;
        } else if (!rule.test(val)) {
            input.classList.add('is-invalid');
            input.classList.remove('is-valid');
            errorSpan.textContent = rule.invalidMsg;
            errorSpan.style.display = 'block';
            return false;
        } else {
            input.classList.remove('is-invalid');
            input.classList.add('is-valid');
            errorSpan.textContent = '';
            errorSpan.style.display = 'none';
            return true;
        }
    }

    inputs.forEach(input => {
        input.addEventListener('input', () => {
            validateField(input.id);
            if (input.id === 'password') validateField('confirm');
        });

        if (input.tagName === 'SELECT') {
            input.addEventListener('change', () => validateField(input.id));
        }
    });

    form.addEventListener('submit', function(e) {
        let isFormValid = true;
        inputs.forEach(input => {
            if (!validateField(input.id)) {
                isFormValid = false;
            }
        });

        if (!isFormValid) {
            e.preventDefault();
            const firstError = form.querySelector('.is-invalid');
            if (firstError) firstError.focus();
        }
    });
    </script>
{% endblock %}