{# templates/member/mes_taches.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="tasks-dashboard">
    <!-- Hero Section -->
    <div class="dashboard-hero">
        <div class="hero-content">
            <div class="hero-badge">
                <span class="badge-pulse"></span>
                Tableau de bord personnel
            </div>
            <h1 class="hero-title">Mes Tâches</h1>
            <p class="hero-subtitle">Visualisez et gérez l'ensemble des missions qui vous sont confiées</p>
        </div>
        <div class="hero-stats">
            <div class="hero-stat">
                <span class="hero-stat-value">{{ stats.total_taches }}</span>
                <span class="hero-stat-label">totales</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-value">{{ stats.en_cours }}</span>
                <span class="hero-stat-label">en cours</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-value">{{ stats.terminees }}</span>
                <span class="hero-stat-label">terminées</span>
            </div>
        </div>
    </div>

    <!-- Kanban Style Stats -->
    <div class="kanban-stats">
        <div class="stat-panel stat-panel-todo">
            <div class="stat-panel-header">
                <div class="stat-panel-title">
                    <div class="stat-dot" style="background: var(--color-warning);"></div>
                    À faire
                </div>
                <div class="stat-panel-number">{{ stats.a_faire }}</div>
            </div>
            <div class="stat-panel-progress">
                <div class="progress-track">
                    <div class="progress-thumb" style="width: {{ stats.total_taches > 0 ? (stats.a_faire / stats.total_taches * 100) : 0 }}%; background: var(--color-warning);"></div>
                </div>
            </div>
        </div>
        <div class="stat-panel stat-panel-progress">
            <div class="stat-panel-header">
                <div class="stat-panel-title">
                    <div class="stat-dot" style="background: var(--color-info);"></div>
                    En cours
                </div>
                <div class="stat-panel-number">{{ stats.en_cours }}</div>
            </div>
            <div class="stat-panel-progress">
                <div class="progress-track">
                    <div class="progress-thumb" style="width: {{ stats.total_taches > 0 ? (stats.en_cours / stats.total_taches * 100) : 0 }}%; background: var(--color-info);"></div>
                </div>
            </div>
        </div>
        <div class="stat-panel stat-panel-done">
            <div class="stat-panel-header">
                <div class="stat-panel-title">
                    <div class="stat-dot" style="background: var(--color-success);"></div>
                    Terminées
                </div>
                <div class="stat-panel-number">{{ stats.terminees }}</div>
            </div>
            <div class="stat-panel-progress">
                <div class="progress-track">
                    <div class="progress-thumb" style="width: {{ stats.total_taches > 0 ? (stats.terminees / stats.total_taches * 100) : 0 }}%; background: var(--color-success);"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Control Bar -->
    <div class="control-bar">
        <div class="control-filters">
            <form method="get" class="filter-form">
                <div class="filter-group">
                    <span class="filter-icon">📋</span>
                    <select name="status" onchange="this.form.submit()">
                        <option value="all" {{ currentStatus == 'all' or currentStatus is null ? 'selected' : '' }}>Tous les statuts</option>
                        <option value="À faire" {{ currentStatus == 'À faire' ? 'selected' : '' }}>À faire</option>
                        <option value="En cours" {{ currentStatus == 'En cours' ? 'selected' : '' }}>En cours</option>
                        <option value="Terminée" {{ currentStatus == 'Terminée' ? 'selected' : '' }}>Terminées</option>
                    </select>
                </div>
                <div class="filter-group">
                    <span class="filter-icon">↗️</span>
                    <select name="sort" onchange="this.form.submit()">
                        <option value="date_limite" {{ sort == 'date_limite' ? 'selected' : '' }}>Date limite</option>
                        <option value="titre" {{ sort == 'titre' ? 'selected' : '' }}>Titre</option>
                        <option value="statut" {{ sort == 'statut' ? 'selected' : '' }}>Statut</option>
                    </select>
                </div>
                <div class="filter-group">
                    <span class="filter-icon">📊</span>
                    <select name="order" onchange="this.form.submit()">
                        <option value="ASC" {{ order == 'ASC' ? 'selected' : '' }}>Croissant ⬆</option>
                        <option value="DESC" {{ order == 'DESC' ? 'selected' : '' }}>Décroissant ⬇</option>
                    </select>
                </div>
            </form>
        </div>
        <div class="control-result">
            <span class="result-count">{{ taches|length }} tâche(s)</span>
        </div>
    </div>

    <!-- Tasks Grid -->
    <div class="tasks-grid">
        {% if taches is empty %}
        <div class="empty-canvas">
            <div class="empty-canvas-inner">
                <div class="empty-graphic">
                    <svg viewBox="0 0 120 120" fill="none">
                        <circle cx="60" cy="60" r="50" stroke="currentColor" stroke-width="0.5" stroke-dasharray="4 4"/>
                        <path d="M60 35 L60 60 L75 75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <circle cx="60" cy="60" r="3" fill="currentColor"/>
                    </svg>
                </div>
                <h3>Calme plat</h3>
                <p>Aucune tâche assignée pour le moment.<br>Parfait pour prendre de l'avance !</p>
            </div>
        </div>
        {% else %}
            {% for tache in taches %}
            <div class="task-card" data-status="{{ tache.statut }}">
                <div class="task-card-header">
                    <div class="task-type">
                        <div class="type-indicator"></div>
                        <span class="type-label">Mission</span>
                    </div>
                    <div class="task-status-badge status-{{ tache.statut|lower|replace({' ': '-', 'à': 'a', 'é': 'e'}) }}">
                        {{ tache.statut }}
                    </div>
                </div>
                
                <div class="task-card-body">
                    <h4 class="task-name">{{ tache.titre }}</h4>
                    {% if tache.description %}
                    <p class="task-description">{{ tache.description|slice(0, 120) }}{{ tache.description|length > 120 ? '...' : '' }}</p>
                    {% endif %}
                    
                    <div class="task-metadata">
                        <div class="metadata-item">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            {% if tache.dateLimite %}
                                <span>{{ tache.dateLimite|date('d M Y') }}</span>
                                {% set daysLeft = (tache.dateLimite|date('U') - "now"|date('U')) / 86400 %}
                                {% if daysLeft < 3 and daysLeft >= 0 and tache.statut != 'Terminée' %}
                                <span class="deadline-warning">• J-{{ daysLeft|round(0, 'ceil') }}</span>
                                {% endif %}
                            {% else %}
                                <span>Date non définie</span>
                            {% endif %}
                        </div>
                        <div class="metadata-item">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M22 19C22 20.1046 21.1046 21 20 21H4C2.89543 21 2 20.1046 2 19V5C2 3.89543 2.89543 3 4 3H9L11 6H20C21.1046 6 22 6.89543 22 8V19Z"/>
                            </svg>
                            <span>{{ tache.idProjet.titre }}</span>
                        </div>
                    </div>
                </div>
                
                <div class="task-card-footer">
                    <form method="POST" action="{{ path('member_modifier_statut_tache', {'id': tache.idTache}) }}">
                        <div class="status-updater">
                            <select name="statut" class="status-select" onchange="this.form.submit()">
                                <option value="À faire" {{ tache.statut == 'À faire' ? 'selected' : '' }}>◯ À faire</option>
                                <option value="En cours" {{ tache.statut == 'En cours' ? 'selected' : '' }}>◉ En cours</option>
                                <option value="Terminée" {{ tache.statut == 'Terminée' ? 'selected' : '' }}>✓ Terminée</option>
                            </select>
                        </div>
                    </form>
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

<style>
/* Variables & Reset */
:root {
    --bg-surface: #ffffff;
    --border-light: rgba(0, 0, 0, 0.06);
    --text-primary: #1a1f36;
    --text-secondary: #5a6e8a;
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.12);
}

.tasks-dashboard {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
}

/* Hero Section */
.dashboard-hero {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border-light);
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    background: rgba(52, 152, 219, 0.08);
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-primary);
    margin-bottom: 1rem;
}

.badge-pulse {
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
}

.hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--color-primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-subtitle {
    color: var(--text-secondary);
    margin: 0;
    font-size: 0.95rem;
}

.hero-stats {
    display: flex;
    gap: 2rem;
    align-items: center;
    background: var(--bg-surface);
    padding: 1rem 2rem;
    border-radius: 60px;
    box-shadow: var(--shadow-sm);
}

.hero-stat {
    text-align: center;
}

.hero-stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    display: block;
    line-height: 1;
}

.hero-stat-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.hero-stat-divider {
    width: 1px;
    height: 30px;
    background: var(--border-light);
}

/* Kanban Stats */
.kanban-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
}

.stat-panel {
    background: var(--bg-surface);
    border-radius: 20px;
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s;
}

.stat-panel:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.stat-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
}

.stat-panel-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
}

.stat-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}

.stat-panel-number {
    font-size: 1.75rem;
    font-weight: 700;
}

.progress-track {
    height: 4px;
    background: var(--border-light);
    border-radius: 2px;
    overflow: hidden;
}

.progress-thumb {
    height: 100%;
    border-radius: 2px;
    transition: width 0.3s ease;
}

/* Control Bar */
.control-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
}

.filter-form {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: 40px;
    padding: 0.25rem 1rem 0.25rem 0.75rem;
    transition: all 0.2s;
}

.filter-group:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.1);
}

.filter-icon {
    font-size: 0.875rem;
    opacity: 0.6;
}

.filter-group select {
    border: none;
    background: transparent;
    padding: 0.5rem 0;
    font-size: 0.875rem;
    cursor: pointer;
    outline: none;
}

.control-result {
    font-size: 0.875rem;
    color: var(--text-secondary);
}

.result-count {
    font-weight: 600;
    color: var(--text-primary);
}

/* Tasks Grid */
.tasks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1.5rem;
}

.task-card {
    background: var(--bg-surface);
    border-radius: 20px;
    box-shadow: var(--shadow-sm);
    transition: all 0.25s;
    overflow: hidden;
    border: 1px solid var(--border-light);
}

.task-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.task-card[data-status="Terminée"] {
    opacity: 0.7;
    background: #fafbfc;
}

.task-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background: rgba(0, 0, 0, 0.02);
    border-bottom: 1px solid var(--border-light);
}

.task-type {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.type-indicator {
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    border-radius: 50%;
}

.type-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
}

.task-status-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.05);
}

.status-a-faire, .status-à-faire {
    background: rgba(241, 196, 15, 0.12);
    color: #d4a000;
}

.status-en-cours {
    background: rgba(52, 152, 219, 0.12);
    color: var(--color-primary);
}

.status-terminee {
    background: rgba(46, 204, 113, 0.12);
    color: #27ae60;
}

.task-card-body {
    padding: 1.25rem;
}

.task-name {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
    line-height: 1.4;
}

.task-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 1rem 0;
}

.task-metadata {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
}

.metadata-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
}

.metadata-item svg {
    opacity: 0.6;
}

.deadline-warning {
    color: #e74c3c;
    font-weight: 500;
}

.task-card-footer {
    padding: 0.75rem 1.25rem 1.25rem;
    border-top: 1px solid var(--border-light);
}

.status-updater select {
    width: 100%;
    padding: 0.6rem 1rem;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    font-size: 0.875rem;
    background: white;
    cursor: pointer;
    transition: all 0.2s;
}

.status-updater select:hover {
    border-color: var(--color-primary);
}

.status-updater select:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.1);
}

/* Empty State */
.empty-canvas {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 2rem;
}

.empty-canvas-inner {
    max-width: 300px;
    margin: 0 auto;
}

.empty-graphic {
    width: 100px;
    height: 100px;
    margin: 0 auto 1.5rem;
    color: var(--text-secondary);
    opacity: 0.4;
}

.empty-canvas h3 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
}

.empty-canvas p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
}

/* Responsive */
@media (max-width: 768px) {
    .tasks-dashboard {
        padding: 1rem;
    }
    
    .dashboard-hero {
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
    }
    
    .hero-stats {
        width: 100%;
        justify-content: space-around;
    }
    
    .kanban-stats {
        grid-template-columns: 1fr;
    }
    
    .tasks-grid {
        grid-template-columns: 1fr;
    }
    
    .hero-title {
        font-size: 1.75rem;
    }
}

@media (max-width: 480px) {
    .filter-form {
        width: 100%;
    }
    
    .filter-group {
        flex: 1;
    }
    
    .task-metadata {
        flex-direction: column;
        gap: 0.5rem;
    }
}
</style>
{% endblock %}