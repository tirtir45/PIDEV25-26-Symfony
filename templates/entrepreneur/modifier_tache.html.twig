{# templates/entrepreneur/modifier_tache.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="mt-root">
  <div class="mt-wrap">

    {# ── Formulaire modification tâche ── #}
    <div class="mt-card">
      <div class="mt-card-accent"></div>
      <div class="mt-header">
        <a href="{{ path('entrepreneur_gestion_projet', {'id': projet.idProjet}) }}" class="mt-back">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Gestion du projet
        </a>
        <div class="mt-header-content">
          <div class="mt-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
          <div>
            <h1 class="mt-title">Modifier la tâche</h1>
            <p class="mt-subtitle">{{ projet.titre }}</p>
          </div>
        </div>
      </div>

      <div class="mt-body">
        {{ form_start(form, {'attr': {'id': 'tacheForm', 'novalidate': 'novalidate'}}) }}

          {% for type, messages in app.flashes %}
            {% for message in messages %}
              <div class="mt-flash mt-flash--{{ type }}">{{ message }}</div>
            {% endfor %}
          {% endfor %}

          <div class="mt-field">
            {{ form_label(form.titre) }}
            {{ form_widget(form.titre, {'attr': {'class': 'mt-input', 'placeholder': 'Ex: Développer la page d\'accueil'}}) }}
            {{ form_errors(form.titre) }}
            <p class="mt-hint">3 à 150 caractères</p>
          </div>

          <div class="mt-field">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'class': 'mt-input', 'rows': 3, 'placeholder': 'Description détaillée de la tâche…'}}) }}
          </div>

          <div class="mt-row">
            <div class="mt-field">
              {{ form_label(form.statut) }}
              {{ form_widget(form.statut, {'attr': {'class': 'mt-input'}}) }}
            </div>
            <div class="mt-field">
              {{ form_label(form.priorite) }}
              {{ form_widget(form.priorite, {'attr': {'class': 'mt-input'}}) }}
            </div>
          </div>

          <div class="mt-row">
            <div class="mt-field">
              {{ form_label(form.date_limite) }}
              {{ form_widget(form.date_limite, {'attr': {'class': 'mt-input', 'id': 'dateLimiteInput', 'min': 'now'|date('Y-m-d')}}) }}
              {{ form_errors(form.date_limite) }}
              <p class="mt-hint" id="dateHint">Les dates passées ne sont pas autorisées.</p>
            </div>
            <div class="mt-field">
              {{ form_label(form.id_responsable) }}
              {{ form_widget(form.id_responsable, {'attr': {'class': 'mt-input'}}) }}
            </div>
          </div>

          <div class="mt-actions">
            <a href="{{ path('entrepreneur_gestion_projet', {'id': projet.idProjet}) }}" class="mt-btn-ghost">Annuler</a>
            <button type="submit" class="mt-btn-primary">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Enregistrer
            </button>
          </div>

        {{ form_end(form) }}
      </div>
    </div>

    {# ── Section commentaires ── #}
    <div class="mt-card mt-comments">
      <div class="mt-card-accent mt-card-accent--green"></div>
      <div class="mt-header">
        <div class="mt-header-content">
          <div class="mt-icon-wrap mt-icon-wrap--green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div>
            <h2 class="mt-title">Commentaires</h2>
            <p class="mt-subtitle">{{ commentaires|length }} commentaire(s)</p>
          </div>
        </div>
      </div>

      <div class="mt-body">
        {# Liste des commentaires #}
        {% if commentaires|length > 0 %}
          <ul class="mt-comment-list">
            {% for c in commentaires %}
            <li class="mt-comment mt-comment--{{ c.type }}">
              <div class="mt-comment-avatar">{{ (c.auteur.nom ?? 'U')|slice(0,1)|upper }}</div>
              <div class="mt-comment-body">
                <div class="mt-comment-head">
                  <span class="mt-comment-author">{{ c.auteur.nom ?? 'Utilisateur' }}</span>
                  <span class="mt-comment-type mt-type--{{ c.type }}">{{ c.type|capitalize }}</span>
                  <span class="mt-comment-date">{{ c.createdAt|date('d/m/Y H:i') }}</span>
                </div>
                <p class="mt-comment-text">{{ c.contenu }}</p>
              </div>
              <form method="post" action="{{ path('entrepreneur_supprimer_commentaire', {'id': c.id}) }}" onsubmit="return confirm('Supprimer ce commentaire ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_commentaire_' ~ c.id) }}">
                <button type="submit" class="mt-comment-del" title="Supprimer">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M9 6V4h6v2"/></svg>
                </button>
              </form>
            </li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="mt-no-comment">Aucun commentaire pour l'instant.</p>
        {% endif %}

        {# Formulaire ajout commentaire #}
        <form method="post" action="{{ path('entrepreneur_tache_commentaires', {'id': tache.idTache}) }}" class="mt-comment-form">
          <div class="mt-field">
            <label for="commentaire_contenu">Ajouter un commentaire</label>
            <textarea id="commentaire_contenu" name="commentaire[contenu]" rows="3" class="mt-input" placeholder="Votre commentaire…" required></textarea>
          </div>
          <div class="mt-row">
            <div class="mt-field">
              <label for="commentaire_type">Type</label>
              <select id="commentaire_type" name="commentaire[type]" class="mt-input">
                <option value="commentaire">Commentaire</option>
                <option value="feedback">Feedback</option>
                <option value="validation">Validation</option>
              </select>
            </div>
            <div class="mt-field" style="display:flex;align-items:flex-end;">
              <button type="submit" class="mt-btn-primary" style="width:100%;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                Envoyer
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

  </div>{# /mt-wrap #}
</div>

<style>
:root {
  --v50: #f3f0ff; --v100: #e9e3ff; --v200: #d4c8ff;
  --v600: #7c3aed; --v700: #6d28d9;
  --g50: #f0fdf4; --g600: #16a34a;
  --ink: #1a1523; --ink2: #4c4566; --ink3: #8b7fa8;
  --border: rgba(124,58,237,.15); --border2: rgba(124,58,237,.3);
  --radius: 10px; --radius-lg: 18px;
}

.mt-root { min-height: 100vh; padding: 2.5rem 1rem; background: radial-gradient(ellipse 80% 60% at 50% -10%, var(--v100), transparent), linear-gradient(160deg, #faf9ff 0%, #f8f5ff 100%); }
.mt-wrap { max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem; }

.mt-card { background: white; border-radius: var(--radius-lg); box-shadow: 0 4px 24px rgba(0,0,0,.08); border: 1px solid var(--border); overflow: hidden; }
.mt-card-accent { height: 4px; background: linear-gradient(90deg, var(--v600) 0%, #a78bfa 60%, #c4b5fd 100%); }
.mt-card-accent--green { background: linear-gradient(90deg, var(--g600) 0%, #4ade80 100%); }
.mt-comments { border-color: rgba(22,163,74,.15); }

.mt-header { padding: 1.5rem 1.75rem 1.25rem; border-bottom: 1px solid var(--border); background: #faf9ff; }
.mt-back { display: inline-flex; align-items: center; gap: .35rem; font-size: .75rem; color: var(--v600); text-decoration: none; font-weight: 500; padding: .25rem .5rem; border-radius: 6px; transition: background .15s; margin-bottom: .75rem; }
.mt-back:hover { background: var(--v50); }
.mt-header-content { display: flex; align-items: center; gap: .9rem; }
.mt-icon-wrap { width: 44px; height: 44px; border-radius: 12px; background: var(--v100); color: var(--v700); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.mt-icon-wrap--green { background: var(--g50); color: var(--g600); }
.mt-title { margin: 0; font-size: 1.1rem; font-weight: 700; color: var(--ink); }
.mt-subtitle { margin: 0; font-size: .78rem; color: var(--ink3); margin-top: .15rem; }
.mt-body { padding: 1.5rem 1.75rem; }

.mt-flash { padding: .65rem .9rem; border-radius: 8px; margin-bottom: 1rem; font-size: .8rem; font-weight: 500; }
.mt-flash--success { background: #dcfce7; color: #166534; border-left: 3px solid #16a34a; }
.mt-flash--error   { background: #fee2e2; color: #991b1b; border-left: 3px solid #dc2626; }
.mt-flash--warning { background: #fef9c3; color: #854d0e; border-left: 3px solid #ca8a04; }

.mt-field { margin-bottom: 1.1rem; }
.mt-row { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
.mt-field label { display: block; font-size: .78rem; font-weight: 600; color: var(--ink2); margin-bottom: .35rem; }
.mt-input { width: 100%; box-sizing: border-box; border: 1.5px solid var(--border2); border-radius: 9px; padding: .6rem .85rem; font-size: .875rem; color: var(--ink); background: white; font-family: inherit; transition: border-color .15s, box-shadow .15s; }
.mt-input:focus { outline: none; border-color: var(--v600); box-shadow: 0 0 0 3px rgba(124,58,237,.1); }
.mt-hint { font-size: .7rem; color: var(--ink3); margin-top: .25rem; }

.mt-actions { display: flex; gap: .75rem; margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
.mt-btn-primary { flex: 1; display: flex; align-items: center; justify-content: center; gap: .45rem; background: var(--v600); color: white; border: none; padding: .7rem 1.25rem; border-radius: 10px; font-size: .875rem; font-weight: 600; cursor: pointer; transition: background .15s, transform .15s; }
.mt-btn-primary:hover { background: var(--v700); transform: translateY(-1px); }
.mt-btn-ghost { padding: .7rem 1.25rem; border: 1.5px solid var(--border2); border-radius: 10px; background: transparent; color: var(--ink2); font-size: .875rem; font-weight: 500; cursor: pointer; text-decoration: none; display: flex; align-items: center; transition: background .15s; }
.mt-btn-ghost:hover { background: var(--v50); }

/* Commentaires */
.mt-comment-list { list-style: none; margin: 0 0 1.5rem; padding: 0; display: flex; flex-direction: column; gap: .75rem; }
.mt-comment { display: flex; gap: .75rem; align-items: flex-start; padding: .75rem; border-radius: var(--radius); border: 1px solid rgba(0,0,0,.07); }
.mt-comment--feedback   { border-left: 3px solid #f59e0b; }
.mt-comment--validation { border-left: 3px solid var(--g600); }
.mt-comment--commentaire { border-left: 3px solid var(--v600); }
.mt-comment-avatar { flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, var(--v600), #a78bfa); color: white; display: flex; align-items: center; justify-content: center; font-size: .8rem; font-weight: 700; }
.mt-comment-body { flex: 1; min-width: 0; }
.mt-comment-head { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-bottom: .3rem; }
.mt-comment-author { font-weight: 600; font-size: .82rem; color: var(--ink); }
.mt-comment-date { font-size: .7rem; color: var(--ink3); margin-left: auto; }
.mt-comment-text { margin: 0; font-size: .85rem; color: var(--ink2); line-height: 1.5; }
.mt-comment-type { font-size: .65rem; font-weight: 700; padding: .1rem .45rem; border-radius: 99px; }
.mt-type--commentaire { background: var(--v100); color: var(--v700); }
.mt-type--feedback    { background: #fef3c7; color: #92400e; }
.mt-type--validation  { background: #dcfce7; color: #166534; }
.mt-comment-del { background: transparent; border: none; cursor: pointer; color: var(--ink3); padding: .2rem; border-radius: 5px; transition: color .15s, background .15s; }
.mt-comment-del:hover { color: #dc2626; background: #fee2e2; }
.mt-no-comment { font-size: .85rem; color: var(--ink3); text-align: center; padding: 1rem 0; }
.mt-comment-form { border-top: 1px solid var(--border); padding-top: 1.25rem; margin-top: .5rem; }

@media (max-width: 480px) {
  .mt-row { grid-template-columns: 1fr; }
  .mt-actions { flex-direction: column; }
}
</style>

<script>
(function() {
  const today = new Date(); today.setHours(0,0,0,0);
  const dateInput = document.getElementById('dateLimiteInput');
  const hint = document.getElementById('dateHint');

  if (dateInput) {
    dateInput.min = today.toISOString().split('T')[0];
    dateInput.addEventListener('change', function() {
      const val = new Date(this.value);
      if (this.value && val < today) {
        this.classList.add('error');
        if (hint) { hint.style.color = '#dc2626'; hint.textContent = 'La date limite ne peut pas être dans le passé.'; }
      } else {
        this.classList.remove('error');
        if (hint) { hint.style.color = ''; hint.textContent = 'Les dates passées ne sont pas autorisées.'; }
      }
    });
  }

  document.getElementById('tacheForm').addEventListener('submit', function(e) {
    const titre = this.querySelector('[name*="titre"]');
    if (titre && titre.value.trim().length < 3) { titre.classList.add('error'); e.preventDefault(); }
    else if (titre) titre.classList.remove('error');
    if (dateInput && dateInput.value && new Date(dateInput.value) < today) e.preventDefault();
  });
})();
</script>
{% endblock %}
