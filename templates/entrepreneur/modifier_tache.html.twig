{% extends 'base.html.twig' %}

{% block title %}Modifier la tâche{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-pencil-square"></i> Modifier la tâche
                    </h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Projet:</strong> {{ projet.titre }}
                    </div>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="mb-3">
                            {{ form_label(form.titre, 'Titre de la tâche', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Développer la page d\'accueil'}}) }}
                            {% if form.titre.vars.errors|length > 0 %}
                                <div class="text-danger">
                                    {{ form_errors(form.titre) }}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Décrivez la tâche en détail...'}}) }}
                            {% if form.description.vars.errors|length > 0 %}
                                <div class="text-danger">
                                    {{ form_errors(form.description) }}
                                </div>
                            {% endif %}
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.date_limite, 'Date limite', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.date_limite, {'attr': {'class': 'form-control'}}) }}
                                    {% if form.date_limite.vars.errors|length > 0 %}
                                        <div class="text-danger">
                                            {{ form_errors(form.date_limite) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.statut, 'Statut', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
                                    {% if form.statut.vars.errors|length > 0 %}
                                        <div class="text-danger">
                                            {{ form_errors(form.statut) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.id_responsable, 'Responsable', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.id_responsable, {'attr': {'class': 'form-control'}}) }}
                            {% if form.id_responsable.vars.errors|length > 0 %}
                                <div class="text-danger">
                                    {{ form_errors(form.id_responsable) }}
                                </div>
                            {% endif %}
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('entrepreneur_gestion_projet', {'id': projet.idProjet}) }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Retour
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Modifier la tâche
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}