/* ═══════════════════════════════════════════
   ANALYSE IA — DESIGN MODERNE
═══════════════════════════════════════════ */

/* Dashboard principal */
.ai-dashboard {
    background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
    border-radius: 20px;
    padding: 28px;
    color: white;
    box-shadow: 0 20px 60px rgba(124, 58, 237, 0.3);
}
.ai-dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
}
.ai-header-left { display: flex; align-items: center; gap: 16px; }
.ai-icon-wrap {
    width: 56px; height: 56px;
    background: rgba(168, 85, 247, 0.3);
    border: 2px solid rgba(168, 85, 247, 0.5);
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem;
}
.ai-title { font-size: 1.3rem; font-weight: 700; margin: 0; color: white; }
.ai-subtitle { font-size: 0.82rem; color: rgba(255,255,255,0.6); margin: 0; }

/* Ring SVG */
.ai-score-ring { position: relative; width: 80px; height: 80px; flex-shrink: 0; }
.ring-svg { width: 80px; height: 80px; transform: rotate(-90deg); }
.ring-bg { fill: none; stroke: rgba(255,255,255,0.1); stroke-width: 8; }
.ring-fill { fill: none; stroke-width: 8; stroke-linecap: round; transition: stroke-dasharray 1s ease; }
.ring-success { stroke: #22c55e; }
.ring-warning { stroke: #f59e0b; }
.ring-danger  { stroke: #ef4444; }
.ring-label {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    text-align: center; line-height: 1;
}
.ring-num { font-size: 1.3rem; font-weight: 800; display: block; }
.ring-sub { font-size: 0.65rem; color: rgba(255,255,255,0.5); }

/* Scores grid */
.ai-scores-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 12px;
}
.ai-score-card {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 14px;
    text-align: center;
    transition: background 0.2s;
}
.ai-score-card:hover { background: rgba(255,255,255,0.12); }
.ai-score-icon { font-size: 1.4rem; color: rgba(255,255,255,0.7); margin-bottom: 6px; display: block; }
.ai-score-label { font-size: 0.75rem; color: rgba(255,255,255,0.6); margin-bottom: 8px; }
.ai-score-bar-wrap { background: rgba(255,255,255,0.1); border-radius: 4px; height: 5px; margin-bottom: 6px; overflow: hidden; }
.ai-score-bar { height: 100%; border-radius: 4px; transition: width 1s ease; }
.bar-success { background: #22c55e; }
.bar-warning { background: #f59e0b; }
.bar-danger  { background: #ef4444; }
.ai-score-val { font-size: 0.85rem; font-weight: 700; }
.ai-analyzed-at { margin-top: 16px; font-size: 0.75rem; color: rgba(255,255,255,0.4); text-align: right; }

/* SWOT */
.swot-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-radius: 0 0 16px 16px;
    overflow: hidden;
}
.swot-cell { padding: 20px; }
.swot-cell ul { margin: 0; padding-left: 18px; font-size: 0.88rem; line-height: 1.7; }
.swot-cell-header { font-weight: 700; font-size: 0.9rem; margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
.swot-forces      { background: #f0fdf4; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; }
.swot-faiblesses  { background: #fff1f2; border-bottom: 1px solid #e2e8f0; }
.swot-opportunites{ background: #eff6ff; border-right: 1px solid #e2e8f0; }
.swot-menaces     { background: #fffbeb; }
.swot-forces .swot-cell-header      { color: #16a34a; }
.swot-faiblesses .swot-cell-header  { color: #dc2626; }
.swot-opportunites .swot-cell-header{ color: #2563eb; }
.swot-menaces .swot-cell-header     { color: #d97706; }

/* Pitch */
.pitch-block {
    background: linear-gradient(135deg, #f5f3ff, #ede9fe);
    border-left: 4px solid #7c3aed;
    border-radius: 0 12px 12px 0;
    padding: 20px 24px;
    position: relative;
}
.pitch-quote-icon { font-size: 2.5rem; color: #a855f7; opacity: 0.3; line-height: 1; margin-bottom: 8px; }
.pitch-text { font-size: 0.92rem; line-height: 1.8; color: #374151; }

/* Marché */
.market-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 16px;
}
.market-card {
    border-radius: 16px;
    padding: 20px;
    text-align: center;
    border: 2px solid transparent;
    transition: transform 0.2s;
}
.market-card:hover { transform: translateY(-3px); }
.market-tam   { background: #eff6ff; border-color: #bfdbfe; }
.market-sam   { background: #f0fdf4; border-color: #bbf7d0; }
.market-som   { background: #fdf4ff; border-color: #e9d5ff; }
.market-growth{ background: #f0fdf4; border-color: #86efac; }
.market-label { font-size: 1.1rem; font-weight: 800; color: #1e293b; }
.market-sublabel { font-size: 0.7rem; color: #64748b; margin: 4px 0 8px; }
.market-value { font-size: 1rem; font-weight: 700; color: #0f172a; }

/* Améliorations */
.amelio-list { display: flex; flex-direction: column; gap: 12px; }
.amelio-item {
    display: flex; gap: 12px; align-items: flex-start;
    background: #f8fafc; border-radius: 12px; padding: 14px;
    border: 1px solid #e2e8f0;
    transition: box-shadow 0.2s;
}
.amelio-item:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); }
.amelio-priority {
    flex-shrink: 0; font-size: 0.65rem; font-weight: 700;
    padding: 4px 8px; border-radius: 6px; letter-spacing: 0.5px;
}
.priority-haute   { background: #fee2e2; color: #dc2626; }
.priority-moyenne { background: #fef3c7; color: #d97706; }
.priority-faible  { background: #dcfce7; color: #16a34a; }
.amelio-suggestion { font-size: 0.9rem; font-weight: 500; color: #1e293b; margin-bottom: 6px; }
.amelio-meta { display: flex; gap: 12px; flex-wrap: wrap; }
.amelio-impact, .amelio-effort { font-size: 0.78rem; color: #64748b; }

/* KPIs */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
}
.kpi-card {
    background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
    border: 1px solid #bae6fd;
    border-radius: 14px;
    padding: 16px;
    transition: transform 0.2s;
}
.kpi-card:hover { transform: translateY(-2px); }
.kpi-name   { font-size: 0.85rem; font-weight: 600; color: #0c4a6e; margin-bottom: 6px; }
.kpi-target { font-size: 1rem; font-weight: 800; color: #0369a1; margin-bottom: 6px; }
.kpi-freq   { font-size: 0.75rem; color: #64748b; }

/* Projets similaires */
.similar-card {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 14px;
    padding: 16px;
    transition: box-shadow 0.2s;
}
.similar-card:hover { box-shadow: 0 4px 20px rgba(217, 119, 6, 0.15); }
.similar-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; }
.similar-name { font-weight: 700; font-size: 1rem; color: #1e293b; }
.similar-badge {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: white; font-size: 0.75rem; font-weight: 600;
    padding: 4px 12px; border-radius: 20px;
}
.similar-section-label { font-weight: 600; font-size: 0.8rem; margin-bottom: 4px; }
.similar-list { margin: 0; padding-left: 16px; font-size: 0.83rem; color: #374151; }
.similar-lecon {
    margin-top: 10px; padding: 10px 14px;
    background: rgba(245, 158, 11, 0.1);
    border-left: 3px solid #f59e0b;
    border-radius: 0 8px 8px 0;
    font-size: 0.83rem; color: #92400e; font-style: italic;
}

/* Site web preview */
.site-preview-wrap {
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    background: #f8fafc;
}
.site-preview-iframe {
    width: 100%; height: 420px; border: none; display: block;
}

@media (max-width: 768px) {
    .swot-grid { grid-template-columns: 1fr; }
    .ai-scores-grid { grid-template-columns: repeat(2, 1fr); }
    .market-grid { grid-template-columns: repeat(2, 1fr); }
    .kpi-grid { grid-template-columns: 1fr; }
}

    .header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }
    
    .stat-item strong {
        font-size: 1rem;
    }
    
    .task-meta {
        flex-direction: column;
        gap: 0.25rem;
    }
}

/* Animations */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.card-modern {
    animation: fadeIn 0.5s ease-out;
}

