.badge {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: 500;
}

/* Style pour les liens */
a {
    color: var(--color-primary);
    text-decoration: none;
    transition: var(--transition);
}

a:hover {
    color: var(--color-secondary);
    text-decoration: underline;
}

/* Style pour les boutons */
.btn {
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-weight: 500;
    transition: var(--transition);
