{# templates/reclamation/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mes Réclamations - StartHub{% endblock %}

{% block body %}
<div class="container-fluid fade-in">
    <!-- Header -->
    <div class="header">
        <div>
            <h1>Mes Réclamations</h1>
            <div class="page-subtitle">Consultez l'état de vos demandes et soumettez-en de nouvelles</div>
        </div>
        <div class="header-actions">
            {% if not showForm %}
                <a href="{{ path('reclamation_index', {new: 1}) }}" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-2"></i> Nouvelle Réclamation
                </a>
            {% endif %}
        </div>
    </div>

    {# ── Flash messages ── #}
    {% for msg in app.flashes('success') %}
    <div style="background:#f0fdf4;border:1.5px solid #22c55e;border-left:5px solid #16a34a;border-radius:10px;padding:14px 18px;margin-bottom:16px;display:flex;align-items:center;gap:12px;">
        <i class="bi bi-check-circle-fill" style="color:#16a34a;font-size:20px;flex-shrink:0;"></i>
        <span style="color:#15803d;font-weight:600;font-size:14px;">{{ msg }}</span>
    </div>
    {% endfor %}

    {% for msg in app.flashes('spam') %}
    <div style="background:#fef2f2;border:1.5px solid #ef4444;border-left:5px solid #dc2626;border-radius:10px;padding:14px 18px;margin-bottom:16px;display:flex;align-items:flex-start;gap:12px;">
        <i class="bi bi-shield-exclamation" style="color:#dc2626;font-size:20px;flex-shrink:0;"></i>
        <div>
            <div style="font-weight:700;color:#dc2626;font-size:13px;margin-bottom:2px;">🚫 Action bloquée — Détection de spam</div>
            <div style="color:#b91c1c;font-size:13px;">{{ msg }}</div>
        </div>
    </div>
    {% endfor %}

    {% if showForm %}
    <!-- Form Card -->
    <div class="row justify-content-center mt-4 mb-5">
        <div class="col-lg-8">
            <div class="card-modern shadow-lg">
                <div class="card-header-modern p-4 border-bottom">
                    <h4 class="mb-0">Soumettre une Réclamation</h4>
                </div>
                <div class="card-body-modern p-4">
                    {% if error %}
                        <div style="background:#fef2f2;border:1.5px solid #ef4444;border-left:4px solid #dc2626;border-radius:10px;padding:14px 18px;margin-bottom:20px;display:flex;align-items:flex-start;gap:12px;">
                            <i class="bi bi-exclamation-triangle-fill" style="color:#dc2626;font-size:18px;flex-shrink:0;"></i>
                            <span style="color:#b91c1c;font-size:13px;">{{ error }}</span>
                        </div>
                    {% endif %}

                    <form method="POST" action="{{ path('reclamation_index') }}" id="reclamForm" class="row g-3">
                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold">Sujet de la demande</label>
                            <input type="text" name="sujet" id="sujet" class="form-control"
                                   placeholder="Ex: Problème d'accès, Bug technique..." required>
                            <div class="invalid-feedback" id="sujet-error"></div>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold">Description détaillée</label>
                            <textarea name="description" id="description" class="form-control"
                                      placeholder="Décrivez votre problème en détail... (arabe, anglais, français...)" rows="5" required></textarea>
                            <div class="invalid-feedback" id="description-error"></div>
                        </div>

                        <div class="col-12 d-flex gap-2 justify-content-end mt-4">
                            <a href="{{ path('reclamation_index') }}" class="btn btn-outline-secondary px-4">Annuler</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-send me-2"></i> Envoyer la demande
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
    document.getElementById('reclamForm').addEventListener('submit', function(e) {
        let valid = true;
        const sujet = document.getElementById('sujet').value.trim();
        const desc  = document.getElementById('description').value.trim();

        if (sujet.length < 3) {
            document.getElementById('sujet').classList.add('is-invalid');
            document.getElementById('sujet-error').textContent = 'Le sujet doit contenir au moins 3 caractères';
            valid = false;
        } else {
            document.getElementById('sujet').classList.remove('is-invalid');
            document.getElementById('sujet').classList.add('is-valid');
        }

        if (desc.length < 10) {
            document.getElementById('description').classList.add('is-invalid');
            document.getElementById('description-error').textContent = 'La description doit contenir au moins 10 caractères';
            valid = false;
        } else {
            document.getElementById('description').classList.remove('is-invalid');
            document.getElementById('description').classList.add('is-valid');
        }

        if (!valid) e.preventDefault();
    });
    </script>
    {% endif %}

    <!-- List Section -->
    <div class="mt-4">
        {% if reclamations is not empty %}
            <div class="row g-4">
                {% for r in reclamations %}
                    <div class="col-md-6 col-lg-4">
                        <div class="resource-card h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge {{ r.statut == 'EN_ATTENTE' ? 'bg-warning-subtle text-warning' : (r.statut == 'RESOLU' ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger') }} rounded-pill px-3">
                                    {{ r.statut|replace({'_': ' '}) }}
                                </span>
                                <div class="text-muted small">
                                    <i class="bi bi-calendar3"></i> {{ r.dateCreation|date('d/m/Y') }}
                                </div>
                            </div>
                            
                            <h5 class="resource-title mb-3 text-main">{{ r.sujet }}</h5>
                            
                            <p class="resource-description text-muted small mb-0">
                                {{ r.description|slice(0, 200) }}{% if r.description|length > 200 %}...{% endif %}
                            </p>
                            
                            {% if r.statut == 'RESOLU' %}
                                <div class="mt-3 p-2 bg-success-subtle text-success rounded-3 small text-center">
                                    <i class="bi bi-check-circle-fill me-1"></i> Cette demande a été traitée.
                                </div>
                            {% endif %}
                            <div class="mt-3">
                                <a href="{{ path('reclamation_show', {id: r.id}) }}" class="btn btn-sm btn-outline-primary w-100">
                                    <i class="bi bi-chat-dots me-1"></i> Voir la discussion
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% elseif not showForm %}
            <div class="card-modern">
                <div class="card-body-modern text-center py-5">
                    <i class="bi bi-journal-text display-1 text-muted opacity-25"></i>
                    <p class="text-muted mt-3">Vous n'avez soumis aucune réclamation pour le moment.</p>
                    <a href="{{ path('reclamation_index', {new: 1}) }}" class="btn btn-primary mt-3">
                        Démarrer une réclamation
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}