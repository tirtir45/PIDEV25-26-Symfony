{% extends 'base.html.twig' %}
{% block title %}Demande de vérification{% endblock %}
{% block body %}
<div class="container-fluid fade-in px-4 py-3">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div style="background:#fff;border:1px solid #EAE8F8;border-radius:14px;padding:32px;">
                <div style="text-align:center;margin-bottom:24px;">
                    <div style="font-size:48px;margin-bottom:8px;">✔️</div>
                    <h2 style="font-size:20px;font-weight:700;color:#1a1040;margin:0 0 6px;">Demande de Badge Vérifié</h2>
                    <p style="color:#9ca3af;font-size:13px;margin:0;">Obtenez le badge ✔️ sur votre profil</p>
                </div>

                {% if user.badgeVerifie %}
                    <div style="background:#d1fae5;border:1px solid #6ee7b7;border-radius:10px;padding:16px;text-align:center;">
                        <div style="font-size:24px;margin-bottom:6px;">✔️</div>
                        <div style="font-weight:700;color:#065f46;">Vous avez déjà le badge vérifié !</div>
                        <div style="font-size:12px;color:#6b7280;margin-top:4px;">Obtenu le {{ user.dateVerification|date('d/m/Y') }}</div>
                    </div>
                {% elseif existing %}
                    <div style="background:#fef3c7;border:1px solid #fcd34d;border-radius:10px;padding:16px;text-align:center;">
                        <div style="font-size:24px;margin-bottom:6px;">⏳</div>
                        <div style="font-weight:700;color:#92400e;">Demande en cours de traitement</div>
                        <div style="font-size:12px;color:#6b7280;margin-top:4px;">Soumise le {{ existing.date_demande|date('d/m/Y') }}</div>
                    </div>
                {% else %}
                    <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:10px;padding:16px;margin-bottom:20px;">
                        <div style="font-size:13px;font-weight:600;color:#0369a1;margin-bottom:8px;">Critères requis :</div>
                        <ul style="margin:0;padding-left:18px;font-size:13px;color:#374151;line-height:1.8;">
                            <li>Email renseigné ✅</li>
                            <li>Numéro de téléphone ✅</li>
                            <li>Photo de profil + biographie</li>
                            <li>Au moins 2 réclamations résolues</li>
                        </ul>
                    </div>

                    <form method="POST" action="{{ path('verification_request') }}">
                        <div style="margin-bottom:16px;">
                            <label style="font-size:13px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">
                                Pourquoi souhaitez-vous obtenir ce badge ? *
                            </label>
                            <textarea name="raison" rows="4" required
                                style="width:100%;border:1.5px solid #EAE8F8;border-radius:10px;padding:12px;font-size:13px;outline:none;resize:vertical;"
                                placeholder="Expliquez brièvement votre demande..."></textarea>
                        </div>
                        <button type="submit"
                            style="width:100%;background:#7C5CFC;color:#fff;border:none;border-radius:10px;padding:12px;font-size:14px;font-weight:600;cursor:pointer;">
                            Soumettre la demande
                        </button>
                    </form>
                {% endif %}

                <div style="text-align:center;margin-top:16px;">
                    <a href="{{ path('app_profile') }}" style="font-size:13px;color:#9ca3af;text-decoration:none;">← Retour au profil</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
