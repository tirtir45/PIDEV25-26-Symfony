{# templates/admin/valider_projet.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="container fade-in">
    <div class="validation-card">
        <div class="validation-header">
            <h2><i class="bi bi-clipboard-check"></i> Validation du projet</h2>
            <span class="status-badge status-pending">En attente de validation</span>
        </div>
        
        <div class="project-details">
            <h3>{{ projet.titre }}</h3>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="detail-item">
                        <label>Entrepreneur</label>
                        <p>{{ projet.id_entrepreneur.nom ?? 'N/A' }}</p>
                    </div>
                    <div class="detail-item">
                        <label>Secteur</label>
                        <p>{{ projet.secteur }}</p>
                    </div>
                    <div class="detail-item">
                        <label>Date de soumission</label>
                        <p>{{ projet.dateSoumission|date('d/m/Y H:i') }}</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <label>Budget estimé</label>
                        <p class="fw-bold text-success">{{ projet.budgetEstime|number_format(0, ',', ' ') }} €</p>
                    </div>
                    <div class="detail-item">
                        <label>Durée estimée</label>
                        <p>{{ projet.dureeEstimee }} mois</p>
                    </div>
                    <div class="detail-item">
                        <label>Nombre de membres</label>
                        <p>{{ projet.nbMembresEquipe }} personnes</p>
                    </div>
                </div>
            </div>
            
            <div class="detail-item full-width">
                <label>Description</label>
                <p>{{ projet.description|nl2br }}</p>
            </div>
            
            <div class="detail-item full-width">
                <label>Objectifs</label>
                <p>{{ projet.objectifs|nl2br }}</p>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="detail-item">
                        <label>Statut juridique</label>
                        <p>{{ projet.statutJuridique }}</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <label>Financement actuel</label>
                        <p>{{ projet.financementActuel }}</p>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="detail-item">
                        <label>Email contact</label>
                        <p><a href="mailto:{{ projet.emailContact }}">{{ projet.emailContact }}</a></p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-item">
                        <label>Téléphone</label>
                        <p>{{ projet.telephoneContact }}</p>
                    </div>
                </div>
            </div>
            
            {% if projet.partenairesPotentiels %}
            <div class="detail-item full-width">
                <label>Partenaires potentiels</label>
                <p>{{ projet.partenairesPotentiels|nl2br }}</p>
            </div>
            {% endif %}
            
            {% if projet.experiencesAnterieures %}
            <div class="detail-item full-width">
                <label>Expériences antérieures</label>
                <p>{{ projet.experiencesAnterieures|nl2br }}</p>
            </div>
            {% endif %}
        </div>
        
        <form method="post" id="validationForm" class="validation-form">
            <div class="form-group">
                <label class="form-label fw-bold">Commentaire (optionnel pour acceptation, recommandé pour refus)</label>
                <textarea name="commentaire_admin" class="form-control" rows="4" placeholder="Ajoutez un commentaire pour l'entrepreneur...">{{ projet.commentaire_admin }}</textarea>
            </div>
            
            <div class="decision-group">
                <label class="fw-bold mb-3">Décision finale</label>
                <div class="decision-buttons">
                    <button type="submit" name="action" value="accepter" class="decision-btn accept-btn">
                        <i class="bi bi-check-circle"></i>
                        <span>Accepter le projet</span>
                    </button>
                    <button type="submit" name="action" value="refuser" class="decision-btn refuse-btn">
                        <i class="bi bi-x-circle"></i>
                        <span>Refuser le projet</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
.validation-card {
    background: white;
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    max-width: 1000px;
    margin: 0 auto;
}

.validation-header {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: white;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.validation-header h2 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.project-details {
    padding: 2rem;
    border-bottom: 1px solid #e2e8f0;
}

.project-details h3 {
    margin-bottom: 1.5rem;
    color: var(--color-dark);
}

.detail-item {
    margin-bottom: 1rem;
}

.detail-item label {
    font-weight: 600;
    color: var(--color-gray);
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.detail-item p {
    margin: 0;
    color: var(--color-dark);
    line-height: 1.5;
}

.full-width {
    margin-top: 0.5rem;
}

.validation-form {
    padding: 2rem;
}

.form-group {
    margin-bottom: 1.5rem;
}

.decision-group {
    margin: 1.5rem 0;
}

.decision-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
}

.decision-btn {
    flex: 1;
    min-width: 200px;
    padding: 1rem 2rem;
    border: none;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
}

.decision-btn i {
    font-size: 1.5rem;
}

.accept-btn {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
}

.accept-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
}

.refuse-btn {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white;
}

.refuse-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(239, 68, 68, 0.3);
}

.status-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
}

.status-pending {
    background: #fef3c7;
    color: #d97706;
}

@media (max-width: 768px) {
    .decision-buttons {
        flex-direction: column;
    }
    
    .decision-btn {
        width: 100%;
    }
    
    .validation-header {
        flex-direction: column;
        text-align: center;
    }
}
</style>

<script>
document.getElementById('validationForm').addEventListener('submit', function(e) {
    const commentaire = document.querySelector('textarea[name="commentaire_admin"]').value;
    const action = e.submitter ? e.submitter.value : null;
    
    if (action === 'refuser' && !commentaire.trim()) {
        e.preventDefault();
        alert('Veuillez ajouter un commentaire expliquant pourquoi vous refusez ce projet.');
        document.querySelector('textarea[name="commentaire_admin"]').focus();
    }
});
</script>
{% endblock %}