{# templates/admin/reclamations.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Gestion des Réclamations - Admin Hub{% endblock %}

{% block body %}
<div class="container-fluid fade-in">
    <!-- Header -->
    <div class="header">
        <div>
            <h1>Gestion des Réclamations</h1>
            <div class="page-subtitle">Gérez les retours et les signalements des utilisateurs</div>
        </div>
        <div class="header-actions">
            <span class="badge bg-primary rounded-pill px-3 py-2">{{ total }} Réclamations</span>
        </div>
    </div>

    <!-- Search & Filters -->
    <div class="search-filters">
        <form method="GET" action="{{ path('admin_reclamation_index') }}" class="row g-3">
            <div class="col-md-5">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" class="form-control" placeholder="Rechercher par sujet, nom ou email..." value="{{ search }}">
                </div>
            </div>
            <div class="col-md-3">
                <select name="statut" class="form-select" onchange="this.form.submit()">
                    <option value="" {{ statut == '' ? 'selected' : '' }}>Tous les statuts</option>
                    <option value="EN_ATTENTE" {{ statut == 'EN_ATTENTE' ? 'selected' : '' }}>⏳ En attente</option>
                    <option value="RESOLU" {{ statut == 'RESOLU' ? 'selected' : '' }}>✅ Résolu</option>
                    <option value="REJETE" {{ statut == 'REJETE' ? 'selected' : '' }}>❌ Rejeté</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="sort" class="form-select" onchange="this.form.submit()">
                    <option value="dateCreation" {{ sort == 'dateCreation' ? 'selected' : '' }}>Date</option>
                    <option value="sujet" {{ sort == 'sujet' ? 'selected' : '' }}>Sujet (A-Z)</option>
                    <option value="statut" {{ sort == 'statut' ? 'selected' : '' }}>Statut</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filtrer</button>
            </div>
        </form>
    </div>

    <!-- Reclamation List -->
    <div class="mt-4">
        {% if reclamations is empty %}
            <div class="card-modern">
                <div class="card-body-modern text-center py-5">
                    <i class="bi bi-envelope-x display-1 text-muted opacity-25"></i>
                    <p class="text-muted mt-3">Aucune réclamation trouvée pour le moment.</p>
                </div>
            </div>
        {% else %}
            <div class="row g-4">
                {% for r in reclamations %}
                    <div class="col-md-6 col-lg-4">
                        <div class="resource-card h-100 {{ r.statut == 'EN_ATTENTE' ? 'border-warning' : '' }}">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <span class="badge {{ r.statut == 'EN_ATTENTE' ? 'bg-warning-subtle text-warning' : (r.statut == 'RESOLU' ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger') }} rounded-pill px-3">
                                        {{ r.statut|replace({'_': ' '}) }}
                                    </span>
                                </div>
                                <div class="text-muted small">
                                    <i class="bi bi-calendar3"></i> {{ r.dateCreation|date('d/m/Y') }}
                                </div>
                            </div>
                            
                            <h5 class="resource-title mb-2 text-main">{{ r.sujet }}</h5>
                            
                            <div class="user-info mb-3 p-2 rounded-3" style="background: rgba(0,0,0,0.02);">
                                {% if r.utilisateur %}
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-mini" style="width:24px; height:24px; background: var(--primary); color:white; border-radius:50%; font-size:10px; display:flex; align-items:center; justify-content:center;">
                                            {{ r.utilisateur.nom|slice(0,1)|upper }}
                                        </div>
                                        <div class="text-truncate small">
                                            <span class="fw-bold">{{ r.utilisateur.nom }}</span>
                                            <div class="text-muted">{{ r.utilisateur.email }}</div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="small text-muted italic">Utilisateur inconnu</div>
                                {% endif %}
                            </div>

                            <p class="resource-description text-muted small mb-4">
                                {{ r.description|slice(0, 150) }}{% if r.description|length > 150 %}...{% endif %}
                            </p>

                            <div class="mt-auto pt-3 border-top">
                                <div class="d-flex gap-2">
                                    <form method="POST" action="{{ path('admin_reclamation_statut', {id: r.id}) }}" class="flex-grow-1 d-flex gap-1">
                                        <select name="statut" class="form-select form-select-sm">
                                            <option value="EN_ATTENTE" {{ r.statut == 'EN_ATTENTE' ? 'selected' : '' }}>⏳ Attente</option>
                                            <option value="RESOLU" {{ r.statut == 'RESOLU' ? 'selected' : '' }}>✅ Résolu</option>
                                            <option value="REJETE" {{ r.statut == 'REJETE' ? 'selected' : '' }}>❌ Rejeté</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary" title="Mettre à jour">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>

                                    <form method="POST" action="{{ path('admin_reclamation_delete', {id: r.id}) }}"
                                          onsubmit="return confirm('Supprimer cette réclamation ?')" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}