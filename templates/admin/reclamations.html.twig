{% extends 'base.html.twig' %}

{% block title %}Gestion des Réclamations - StartHub{% endblock %}

{% block body %}
<div class="gestion-container">

    <div class="gestion-header">
        <h1 class="gestion-title">Gestion des Réclamations</h1>
        <span class="gestion-count">{{ total }} réclamation{{ total > 1 ? 's' : '' }}</span>
    </div>

    <!-- Filtres -->
    <form method="GET" action="{{ path('admin_reclamation_index') }}" class="gestion-filters">
        <div class="filter-group">
            <label class="filter-label">Rechercher</label>
            <input type="text" name="search" class="filter-input"
                   placeholder="Sujet, nom ou email..."
                   value="{{ search }}">
        </div>

        <div class="filter-group">
            <label class="filter-label">Filtrer par statut</label>
            <select name="statut" class="filter-select">
                <option value="" {{ statut == '' ? 'selected' : '' }}>Tous les statuts</option>
                <option value="EN_ATTENTE" {{ statut == 'EN_ATTENTE' ? 'selected' : '' }}>En attente</option>
                <option value="RESOLU" {{ statut == 'RESOLU' ? 'selected' : '' }}>Résolu</option>
                <option value="REJETE" {{ statut == 'REJETE' ? 'selected' : '' }}>Rejeté</option>
            </select>
        </div>

        <div class="filter-group">
            <label class="filter-label">Trier par</label>
            <select name="sort" class="filter-select">
                <option value="dateCreation" {{ sort == 'dateCreation' ? 'selected' : '' }}>Date</option>
                <option value="sujet" {{ sort == 'sujet' ? 'selected' : '' }}>Sujet (A-Z)</option>
                <option value="statut" {{ sort == 'statut' ? 'selected' : '' }}>Statut</option>
            </select>
        </div>

        <button type="submit" class="btn-actualiser">⟳ Actualiser</button>
    </form>

    <!-- Liste -->
    {% if reclamations is empty %}
        <div class="gestion-empty">Aucune réclamation trouvée.</div>
    {% else %}
        <div class="gestion-list">
            {% for r in reclamations %}
            <div class="gestion-card">
                <div class="gestion-card-top">
                    <span class="gestion-id">ID: {{ r.id }}</span>
                    <span class="gestion-date">📅 {{ r.dateCreation|date('d/m/Y') }}</span>
                </div>

                <div class="gestion-card-title">{{ r.sujet }}</div>

                <div class="gestion-card-info">
                    {% if r.utilisateur %}
                        <span>✉ {{ r.utilisateur.email }}</span>
                        <span>👤 {{ r.utilisateur.nom }}</span>
                    {% endif %}
                    <span class="gestion-statut statut-{{ r.statut|lower }}">{{ r.statut|replace({'_': ' '}) }}</span>
                </div>

                <div class="gestion-card-desc">{{ r.description|slice(0, 120) }}{% if r.description|length > 120 %}...{% endif %}</div>

                <div class="gestion-card-actions">
                    <form method="POST" action="{{ path('admin_reclamation_statut', {id: r.id}) }}" class="gestion-actions-form">
                        <select name="statut" class="gestion-statut-select">
                            <option value="EN_ATTENTE" {{ r.statut == 'EN_ATTENTE' ? 'selected' : '' }}>⏳ En attente</option>
                            <option value="RESOLU" {{ r.statut == 'RESOLU' ? 'selected' : '' }}>✅ Résolu</option>
                            <option value="REJETE" {{ r.statut == 'REJETE' ? 'selected' : '' }}>❌ Rejeté</option>
                        </select>
                        <button type="submit" class="btn-changer">
                            <span>↻</span> Mettre à jour
                        </button>
                    </form>

                    <form method="POST" action="{{ path('admin_reclamation_delete', {id: r.id}) }}"
                          onsubmit="return confirm('Supprimer cette réclamation ?')">
                        <button type="submit" class="btn-suppr">
                            <span>🗑</span> Supprimer
                        </button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}