{# templates/admin/gestion_projet.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="container-fluid fade-in">
    <div class="header">
        <div>
            <h1><i class="bi bi-folder2"></i> {{ projet.titre }}</h1>
            <div class="page-subtitle">Gestion du projet - {{ projet.id_entrepreneur.nom ?? 'N/A' }}</div>
        </div>
        <div class="header-actions">
            <span class="status-badge 
                {% if projet.etat == 'En attente' %}status-pending
                {% elseif projet.etat == 'Accepté' %}status-accepted
                {% elseif projet.etat == 'Refusé' %}status-refused
                {% elseif projet.etat == 'En cours' %}status-in-progress
                {% else %}status-completed{% endif %}">
                {{ projet.etat }}
            </span>
            {% if projet.etat == 'Accepté' %}
            <form method="post" action="{{ path('admin_changer_statut_projet', {'id': projet.idProjet}) }}" class="d-inline">
                <select name="statut" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                    <option value="En cours">📊 Passer En cours</option>
                    <option value="Terminé">✅ Marquer Terminé</option>
                </select>
            </form>
            {% endif %}
        </div>
    </div>

    <!-- Progression -->
    <div class="progress-section mb-4">
        <div class="d-flex justify-content-between mb-2">
            <strong>Progression globale</strong>
            <strong class="text-primary">{{ projet.progression }}%</strong>
        </div>
        <div class="progress" style="height: 10px;">
            <div class="progress-bar" style="width: {{ projet.progression }}%"></div>
        </div>
    </div>

    <!-- Section: Informations détaillées du projet -->
    <div class="card-modern mb-4">
        <div class="card-header-modern">
            <h3><i class="bi bi-info-circle"></i> Informations détaillées du projet</h3>
        </div>
        <div class="card-body-modern">
            <div class="row">
                <!-- Informations générales -->
                <div class="col-md-6">
                    <h5 class="mb-3"><i class="bi bi-file-text"></i> Description</h5>
                    <div class="detail-item">
                        <label>Titre</label>
                        <p><strong>{{ projet.titre }}</strong></p>
                    </div>
                    <div class="detail-item">
                        <label>Description</label>
                        <p>{{ projet.description|nl2br }}</p>
                    </div>
                    <div class="detail-item">
                        <label>Secteur</label>
                        <p><span class="badge bg-primary">{{ projet.secteur }}</span></p>
                    </div>
                    <div class="detail-item">
                        <label>Objectifs</label>
                        <p>{{ projet.objectifs|nl2br }}</p>
                    </div>
                </div>

                <!-- Informations financières -->
                <div class="col-md-6">
                    <h5 class="mb-3"><i class="bi bi-calculator"></i> Aspects financiers</h5>
                    <div class="detail-item">
                        <label>Budget estimé</label>
                        <p class="fs-4 fw-bold text-success">{{ projet.budgetEstime|number_format(0, ',', ' ') }} €</p>
                    </div>
                    <div class="detail-item">
                        <label>Durée estimée</label>
                        <p>{{ projet.dureeEstimee }} mois</p>
                    </div>
                    <div class="detail-item">
                        <label>Nombre de membres</label>
                        <p>{{ projet.nbMembresEquipe }} personnes</p>
                    </div>
                    <div class="detail-item">
                        <label>Statut juridique</label>
                        <p>{{ projet.statutJuridique }}</p>
                    </div>
                    <div class="detail-item">
                        <label>Financement actuel</label>
                        <p><span class="badge bg-info">{{ projet.financementActuel }}</span></p>
                    </div>
                    {% if projet.partenairesPotentiels %}
                    <div class="detail-item">
                        <label>Partenaires potentiels</label>
                        <p>{{ projet.partenairesPotentiels|nl2br }}</p>
                    </div>
                    {% endif %}
                </div>

                <!-- Coordonnées -->
                <div class="col-md-6 mt-3">
                    <h5 class="mb-3"><i class="bi bi-envelope"></i> Coordonnées</h5>
                    <div class="detail-item">
                        <label>Email de contact</label>
                        <p><i class="bi bi-envelope"></i> <a href="mailto:{{ projet.emailContact }}">{{ projet.emailContact }}</a></p>
                    </div>
                    <div class="detail-item">
                        <label>Téléphone</label>
                        <p><i class="bi bi-telephone"></i> <a href="tel:{{ projet.telephoneContact }}">{{ projet.telephoneContact }}</a></p>
                    </div>
                    {% if projet.siteWeb %}
                    <div class="detail-item">
                        <label>Site web</label>
                        <p><i class="bi bi-globe"></i> <a href="{{ projet.siteWeb }}" target="_blank">{{ projet.siteWeb }}</a></p>
                    </div>
                    {% endif %}
                </div>

                <!-- Expériences -->
                {% if projet.experiencesAnterieures %}
                <div class="col-md-6 mt-3">
                    <h5 class="mb-3"><i class="bi bi-briefcase"></i> Expériences antérieures</h5>
                    <div class="detail-item">
                        <p>{{ projet.experiencesAnterieures|nl2br }}</p>
                    </div>
                </div>
                {% endif %}

                <!-- Informations de soumission -->
                <div class="col-12 mt-3">
                    <hr>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="detail-item">
                                <label>Date de soumission</label>
                                <p><i class="bi bi-calendar"></i> {{ projet.dateSoumission|date('d/m/Y H:i') }}</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="detail-item">
                                <label>Entrepreneur</label>
                                <p><i class="bi bi-person"></i> {{ projet.id_entrepreneur.nom ?? 'N/A' }}</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="detail-item">
                                <label>Statut actuel</label>
                                <p>{{ projet.etat }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Colonne gauche : Membres (lecture seule) -->
        <div class="col-lg-5 mb-4">
            <div class="card-modern">
                <div class="card-header-modern">
                    <h3><i class="bi bi-people"></i> Membres de l'équipe</h3>
                </div>
                <div class="card-body-modern">
                    {% if membres|length > 0 %}
                        <div class="team-grid">
                            {% for membre in membres %}
                            <div class="team-member-card">
                                <div class="team-member-info">
                                    <div class="team-member-avatar-sm">
                                        <i class="bi bi-person-circle fs-1"></i>
                                    </div>
                                    <div class="team-member-details">
                                        <div class="team-member-name">{{ membre.idUtilisateur.nom ?? membre.membre.nom ?? 'Membre' }}</div>
                                        <div class="team-member-role">{{ membre.roleEquipe }}</div>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-4">
                            <i class="bi bi-people fs-1 text-muted"></i>
                            <p class="text-muted mt-2">Aucun membre dans l'équipe pour le moment</p>
                            <small class="text-muted">L'entrepreneur ajoutera les membres</small>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Colonne droite : Tâches (lecture seule) -->
        <div class="col-lg-7 mb-4">
            <div class="card-modern">
                <div class="card-header-modern">
                    <h3><i class="bi bi-check2-square"></i> Tâches du projet</h3>
                </div>
                <div class="card-body-modern">
                    {% if taches|length > 0 %}
                        <div class="tasks-list">
                            {% for tache in taches %}
                            <div class="task-card" data-status="{{ tache.statut }}">
                                <div class="task-header">
                                    <div class="task-title">
                                        <h4>{{ tache.titre }}</h4>
                                        <span class="status-badge 
                                            {% if tache.statut == 'À faire' %}status-pending
                                            {% elseif tache.statut == 'En cours' %}status-in-progress
                                            {% else %}status-completed{% endif %}">
                                            {{ tache.statut }}
                                        </span>
                                    </div>
                                </div>
                                {% if tache.description %}
                                <div class="task-description">
                                    {{ tache.description|nl2br }}
                                </div>
                                {% endif %}
                                <div class="task-footer">
                                    <div class="task-assignee">
                                        <i class="bi bi-person"></i>
                                        {{ tache.idUtilisateur.nom ?? tache.responsable.nom ?? 'Non assigné' }}
                                    </div>
                                    {% if tache.dateLimite %}
                                    <div class="task-deadline">
                                        <i class="bi bi-calendar"></i>
                                        {{ tache.dateLimite|date('d/m/Y') }}
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-4">
                            <i class="bi bi-check2-square fs-1 text-muted"></i>
                            <p class="text-muted mt-2">Aucune tâche créée pour le moment</p>
                            <small class="text-muted">L'entrepreneur ajoutera les tâches</small>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    
    <!-- Bouton retour -->
    <div class="text-center mt-3 mb-4">
        <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour au tableau de bord
        </a>
    </div>
</div>

<style>
.card-modern {
    background: white;
    border-radius: 20px;
    box-shadow: var(--shadow-md);
    overflow: hidden;
}

.card-header-modern {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: white;
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.card-header-modern h3 {
    margin: 0;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.card-body-modern {
    padding: 1.5rem;
}

.progress-section {
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
}

.detail-item {
    margin-bottom: 1rem;
}

.detail-item label {
    display: block;
    font-weight: 600;
    color: var(--color-gray);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.25rem;
}

.detail-item p {
    margin: 0;
    color: var(--color-dark);
}

.team-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.team-member-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    transition: var(--transition);
}

.team-member-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
}

.team-member-info {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.team-member-avatar-sm {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: 50%;
    color: white;
}

.team-member-details {
    flex: 1;
}

.team-member-name {
    font-weight: 600;
    color: var(--color-dark);
}

.team-member-role {
    font-size: 0.85rem;
    color: var(--color-gray);
}

.tasks-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.task-card {
    background: #f8fafc;
    border-radius: 12px;
    padding: 1rem;
    border-left: 4px solid;
    transition: var(--transition);
}

.task-card[data-status="À faire"] { border-left-color: var(--color-warning); }
.task-card[data-status="En cours"] { border-left-color: var(--color-primary); }
.task-card[data-status="Terminée"] { border-left-color: var(--color-success); }

.task-card:hover {
    transform: translateX(5px);
    box-shadow: var(--shadow-sm);
}

.task-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
}

.task-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
}

.task-title h4 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
}

.task-description {
    color: var(--color-gray);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    line-height: 1.5;
}

.task-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--color-gray);
}

.task-assignee i, .task-deadline i {
    margin-right: 0.25rem;
}

.header-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
}

.badge {
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    font-weight: 500;
}

hr {
    margin: 1rem 0;
}
</style>
{% endblock %}