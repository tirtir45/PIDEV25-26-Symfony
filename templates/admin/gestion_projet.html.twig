                        <div class="alert alert-warning mb-3">
                            <strong>Test formulaire simple :</strong>
                            <form method="post" action="{{ path('admin_gestion_projet', {id: projet.idProjet}) }}" style="display:inline;">
                                <input type="hidden" name="action" value="accepter">
                                <button type="submit" class="btn btn-sm btn-success">TEST Accepter (simple)</button>
                            </form>
                        </div>
                        
                        <form method="post" id="validationForm" action="{{ path('admin_gestion_projet', {id: projet.idProjet}) }}">
                            <div class="mb-3">
                                <label for="commentaire_admin" class="form-label fw-bold">
                                    <i class="bi bi-chat-text me-1"></i>Commentaire
                                    <small class="text-muted fw-normal">(requis pour refus)</small>
                                </label>
                                <textarea name="commentaire_admin" id="commentaire_admin"
                                          class="form-control" rows="4"
                                          placeholder="Commentaire visible par l'entrepreneur...">{{ projet.commentaireAdmin|escape }}</textarea>
                                <div class="invalid-feedback">Un commentaire est requis pour un refus.</div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" name="action" value="accepter" id="btnAccepter"
                                        class="btn btn-success btn-lg">
                                    <i class="bi bi-check-circle-fill me-2"></i>Accepter le projet
                                    {% set pct2 = evaluation ? evaluation.pourcentage : (evalData ? evalData.pourcentage : null) %}
                                    {% if pct2 is not null and pct2 < 70 %}
                                        <small>(Dérogation requise - score {{ pct2 }}%)</small>
                                    {% endif %}
                                </button>
                                <button type="submit" name="action" value="refuser" id="btnRefuser"
                                        class="btn btn-danger btn-lg">
                                    <i class="bi bi-x-circle-fill me-2"></i>Refuser le projet
                                </button>
                            </div>
                            
                            <div class="mt-2 text-center">
                                <small class="text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Motif obligatoire pour le refus
                                </small>
                            </div>
                        </form>
                    {% else %}
                        <div class="text-center py-2">
                            {% if projet.etat == 'Accepté' %}
                                <i class="bi bi-check-circle-fill text-success" style="font-size:2.5rem"></i>
                                <h5 class="mt-2 text-success">Projet accepté</h5>
                            {% else %}
                                <i class="bi bi-x-circle-fill text-danger" style="font-size:2.5rem"></i>
                                <h5 class="mt-2 text-danger">Projet refusé</h5>
                            {% endif %}
                            {% if projet.commentaireAdmin %}
                            <div class="alert alert-light text-start mt-3 mb-0">
                                <strong><i class="bi bi-chat-quote me-1"></i>Commentaire :</strong>
                                <p class="mb-0 mt-1 text-muted">{{ projet.commentaireAdmin|escape|nl2br }}</p>
                            </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>

        </div>{# /col-lg-5 #}
    </div>{# /row #}
</div>

<style>
.fade-in { animation: fadeIn .4s ease; }
@keyframes fadeIn { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:none; } }

.avatar-circle {
    width: 38px; height: 38px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1rem; flex-shrink: 0;
}

/* Donut score */
.score-donut {
    width: 110px; height: 110px; border-radius: 50%;
    background: conic-gradient(#10b981 calc(var(--pct) * 1%), #e5e7eb 0);
    display: flex; align-items: center; justify-content: center;
    position: relative;
}
.score-donut::before {
    content: ''; position: absolute;
    width: 78px; height: 78px; border-radius: 50%; background: white;
}
.score-donut span {
    position: relative; font-weight: 700; font-size: 1.2rem; color: #1f2937;
}
</style>

