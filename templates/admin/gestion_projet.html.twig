                        <div class="border rounded p-2 mb-1 small">
                            <div class="fw-semibold text-truncate">{{ p.title ?? 'Sans titre' }}</div>
                            <div class="text-muted">
                                {% if p.assignee is defined %}{{ p.assignee }}{% endif %}
                                {% if p.priority_date is defined %} · {{ p.priority_date|slice(0,4) }}{% endif %}
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {# Alertes #}
                    {% if pd.alerts is defined and pd.alerts|length > 0 %}
                    <div class="mb-3">
                        {% for alert in pd.alerts %}
                        <div class="alert alert-{{ alert.type }} py-1 px-2 small mb-1">{{ alert.msg }}</div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {# Recommandation #}
                    {% if pd.recommendation is defined %}
                    <div class="alert alert-light border small mb-0">
                        <i class="bi bi-lightbulb-fill text-warning me-1"></i>
                        {{ pd.recommendation }}
                    </div>
                    {% endif %}

                    {% endif %}{# end pd #}

                    <div class="text-end mt-2">
                        <small class="text-muted">
                            {% if projet.patentAnalyzedAt %}Analysé le {{ projet.patentAnalyzedAt|date('d/m/Y H:i') }}{% endif %}
                        </small>
                    </div>
                </div>

                {% else %}
                <div class="card-body text-center text-muted py-4">
                    <i class="bi bi-file-earmark-text fs-2 d-block mb-2"></i>
                    Aucune analyse brevets disponible.<br>
                    <small>Cliquez sur "Lancer l'analyse" pour rechercher les brevets existants via SerpAPI Google Patents.</small>
                </div>
                {% endif %}
            </div>

            {# ── Décision admin ── #}
