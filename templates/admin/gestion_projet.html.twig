                        <div class="d-flex align-items-center gap-2 mb-1 small">
                            <div class="text-truncate flex-grow-1" style="max-width:60%">{{ a.name }}</div>
                            <div class="progress flex-grow-1" style="height:6px">
                                <div class="progress-bar bg-primary" style="width:{{ val }}%"></div>
                            </div>
                            <span class="text-muted" style="min-width:35px;text-align:right">{{ val }}{% if a.percentage is defined %}%{% endif %}</span>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {# ── Top codes CPC ── #}
                    {% if pd.top_cpc is defined and pd.top_cpc|length > 0 %}
                    <div class="mb-3">
                        <div class="fw-bold small mb-2"><i class="bi bi-tags me-1"></i>Codes CPC dominants</div>
                        <div class="d-flex flex-wrap gap-1">
                            {% for c in pd.top_cpc|slice(0,8) %}
                            {% set cLabel = c.name is defined ? c.name : (c.code is defined ? c.code : '?') %}
                            {% set cVal = c.percentage is defined ? c.percentage : (c.count is defined ? c.count : '') %}
                            <span class="badge bg-secondary" title="{{ cVal }}{% if c.percentage is defined %}%{% endif %} des brevets">{{ cLabel }} {% if cVal %}<small>{{ cVal }}{% if c.percentage is defined %}%{% endif %}</small>{% endif %}</span>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    {# ── Concurrents ── #}
                    {% if pd.competitors is defined and pd.competitors|length > 0 %}
                    <div class="mb-3">
                        <div class="fw-bold small mb-2 text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Concurrents détectés</div>
                        {% for c in pd.competitors %}
                        <span class="badge bg-danger me-1 mb-1">{{ c.name }} ({{ c.count is defined ? c.count : (c.patents is defined ? c.patents : 0) }})</span>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {# ── Présence géographique ── #}
                    {% if pd.countries is defined and pd.countries|length > 0 %}
                    <div class="mb-3">
                        <div class="fw-bold small mb-2"><i class="bi bi-globe me-1"></i>Présence géographique</div>
                        <div class="d-flex flex-wrap gap-1">
                            {% for code, stats in pd.countries %}
                            <span class="badge {{ stats.active > 0 ? 'bg-success' : 'bg-light text-dark border' }}"
                                  title="Actifs: {{ stats.active }} | Inactifs: {{ stats.inactive }}">
                                {{ code }}
                                {% if stats.active > 0 %}<small>✓{{ stats.active }}</small>{% endif %}
                            </span>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    {# ── Brevets trouvés ── #}
                    {% if pd.sample_patents is defined and pd.sample_patents|length > 0 %}
                    <div class="mb-3">
                        <div class="fw-bold small mb-2"><i class="bi bi-file-text me-1"></i>Brevets trouvés ({{ pd.sample_patents|length }} affichés / {{ pd.total_results ?? 0 }} total)</div>
                        <div class="accordion accordion-flush" id="patentsAccordion">
                        {% for p in pd.sample_patents %}
                        <div class="accordion-item border rounded mb-1">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-2 small" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#patent{{ loop.index }}">
                                    <div class="d-flex align-items-start gap-2 w-100 me-2">
                                        {% if p.thumbnail %}
                                        <img src="{{ p.thumbnail }}" alt="" style="width:36px;height:36px;object-fit:cover;border-radius:4px;flex-shrink:0">
                                        {% endif %}
                                        <div class="min-width-0">
                                            <div class="fw-semibold text-truncate" style="max-width:280px">{{ p.title }}</div>
                                            <div class="text-muted" style="font-size:.7rem">
                                                {% if p.assignee %}{{ p.assignee }}{% endif %}
                                                {% if p.filing_date %} · {{ p.filing_date|slice(0,4) }}{% endif %}
                                                {% if p.publication_number %}
                                                    · <span class="badge bg-light text-dark border">{{ p.publication_number }}</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </button>
                            </h2>
                            <div id="patent{{ loop.index }}" class="accordion-collapse collapse">
                                <div class="accordion-body py-2 small">
                                    {% if p.snippet %}
                                    <p class="text-muted mb-2">{{ p.snippet }}</p>
                                    {% endif %}

                                    <div class="row g-2 mb-2">
                                        {% if p.inventor %}
                                        <div class="col-6"><span class="text-muted">Inventeur :</span> {{ p.inventor }}</div>
                                        {% endif %}
                                        {% if p.filing_date %}
                                        <div class="col-6"><span class="text-muted">Dépôt :</span> {{ p.filing_date }}</div>
                                        {% endif %}
                                        {% if p.grant_date %}
                                        <div class="col-6"><span class="text-muted">Accordé :</span> {{ p.grant_date }}</div>
                                        {% endif %}
                                        {% if p.language %}
                                        <div class="col-6"><span class="text-muted">Langue :</span> {{ p.language|upper }}</div>
                                        {% endif %}
                                    </div>

                                    {# Statut par pays #}
                                    {% if p.country_status|length > 0 %}
                                    <div class="mb-2">
                                        {% for code, status in p.country_status %}
                                        <span class="badge me-1
                                            {% if status == 'ACTIVE' %}bg-success
                                            {% elseif status == 'NOT_ACTIVE' %}bg-secondary
                                            {% else %}bg-light text-dark border{% endif %}">
                                            {{ code }}
                                        </span>
                                        {% endfor %}
                                    </div>
                                    {% endif %}

                                    {# Figures #}
                                    {% if p.figures|length > 0 %}
                                    <div class="d-flex gap-2 mb-2">
                                        {% for fig in p.figures %}
                                        <a href="{{ fig.full }}" target="_blank">
                                            <img src="{{ fig.thumbnail }}" alt="Figure" style="height:60px;border-radius:4px;border:1px solid #e2e8f0">
                                        </a>
                                        {% endfor %}
                                    </div>
                                    {% endif %}

                                    {# Liens #}
                                    <div class="d-flex gap-2">
                                        {% if p.patent_link %}
                                        <a href="{{ p.patent_link }}" target="_blank" class="btn btn-xs btn-outline-primary" style="font-size:.75rem;padding:2px 8px">
                                            <i class="bi bi-box-arrow-up-right me-1"></i>Voir le brevet
                                        </a>
                                        {% endif %}
                                        {% if p.pdf %}
                                        <a href="{{ p.pdf }}" target="_blank" class="btn btn-xs btn-outline-danger" style="font-size:.75rem;padding:2px 8px">
                                            <i class="bi bi-file-pdf me-1"></i>PDF
                                        </a>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    {# ── Alertes ── #}
                    {% if pd.alerts is defined and pd.alerts|length > 0 %}
                    <div class="mb-3">
                        {% for alert in pd.alerts %}
                        <div class="alert alert-{{ alert.type }} py-1 px-2 small mb-1">{{ alert.msg }}</div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {# ── Recommandation ── #}
                    {% if pd.recommendation is defined %}
                    <div class="alert alert-light border small mb-0">
                        <i class="bi bi-lightbulb-fill text-warning me-1"></i>{{ pd.recommendation }}
                    </div>
                    {% endif %}

                    {% endif %}{# end pd #}

                    <div class="text-end mt-2">
                        <small class="text-muted">
                            {% if projet.patentAnalyzedAt %}Analysé le {{ projet.patentAnalyzedAt|date('d/m/Y H:i') }}{% endif %}
                        </small>
                    </div>
                </div>

                {% else %}
                <div class="card-body text-center text-muted py-4">
                    <i class="bi bi-file-earmark-text fs-2 d-block mb-2"></i>
                    Aucune analyse brevets disponible.<br>
                    <small>Cliquez sur "Lancer l'analyse" pour rechercher via SerpAPI Google Patents :<br>
                    brevets accordés · déposants · codes CPC · présence géographique · figures</small>
                </div>
                {% endif %}
            </div>

                {% if projet.patentNoveltyScore is not null %}
                {% set pd = projet.patentData %}
                <div class="card-body">

                    {# Score nouveauté #}
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold">Score de nouveauté</span>
                        <span class="fs-5 fw-bold
                            {% if projet.patentNoveltyScore >= 70 %}text-success
                            {% elseif projet.patentNoveltyScore >= 40 %}text-warning
                            {% else %}text-danger{% endif %}">
                            {{ projet.patentNoveltyScore }}/100
                        </span>
                    </div>
                    <div class="progress mb-3" style="height:10px">
                        <div class="progress-bar
                            {% if projet.patentNoveltyScore >= 70 %}bg-success
                            {% elseif projet.patentNoveltyScore >= 40 %}bg-warning
                            {% else %}bg-danger{% endif %}"
                            style="width:{{ projet.patentNoveltyScore }}%"></div>
                    </div>

                    {% if pd %}
                    {# Métriques clés #}
                    <div class="row g-2 mb-3 text-center small">
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <div class="text-muted">Total brevets</div>
                                <strong class="fs-6">{{ pd.total_patents ?? 0 }}</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <div class="text-muted">Récents (5 ans)</div>
                                <strong class="fs-6 {{ (pd.recent_patents_5y ?? 0) > 50 ? 'text-danger' : 'text-success' }}">
                                    {{ pd.recent_patents_5y ?? 0 }}
                                </strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <div class="text-muted">Concurrents</div>
                                <strong class="fs-6 {{ (pd.competitors ?? [])|length > 0 ? 'text-warning' : 'text-success' }}">
                                    {{ (pd.competitors ?? [])|length }}
                                </strong>
                            </div>
                        </div>
                    </div>

                    {# Requête utilisée #}
                    {% if pd.query is defined and pd.query %}
                    <div class="small text-muted mb-3">
                        <i class="bi bi-search me-1"></i>Requête : <code>{{ pd.query|slice(0,80) }}{% if pd.query|length > 80 %}…{% endif %}</code>
                    </div>
                    {% endif %}

                    {# Principaux déposants #}
                    {% if pd.top_assignees is defined and pd.top_assignees|length > 0 %}
                    <div class="mb-3">
                        <div class="fw-bold small mb-2"><i class="bi bi-building me-1"></i>Principaux déposants</div>
                        {% for a in pd.top_assignees|slice(0,5) %}
                        <div class="d-flex justify-content-between align-items-center small mb-1">
                            <span class="text-truncate" style="max-width:70%">{{ a.name }}</span>
                            {% if a.frequency is defined and a.frequency is not iterable %}
                                <span class="badge bg-secondary">{{ a.frequency }}</span>
                            {% elseif a.percentage is defined and a.percentage is not iterable %}
                                <span class="badge bg-secondary">{{ a.percentage }}%</span>
                            {% else %}
                                <span class="badge bg-secondary">-</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {# Concurrents détectés #}
                    {% if pd.competitors is defined and pd.competitors|length > 0 %}
                    <div class="mb-3">
                        <div class="fw-bold small mb-2"><i class="bi bi-exclamation-triangle text-warning me-1"></i>Concurrents détectés</div>
                        {% for c in pd.competitors %}
                        <span class="badge bg-warning text-dark me-1 mb-1">{{ c.name }} ({{ c.count ?? 0 }})</span>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {# Exemples de brevets #}
                    {% if pd.sample_patents is defined and pd.sample_patents|length > 0 %}
                    <div class="mb-3">
                        <div class="fw-bold small mb-2"><i class="bi bi-file-text me-1"></i>Exemples de brevets trouvés</div>
