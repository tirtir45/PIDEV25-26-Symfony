                <div class="card-header
                    {% if projet.etat == 'Accepté' %}bg-success text-white
                    {% elseif projet.etat == 'Refusé' %}bg-danger text-white
                    {% else %}bg-light{% endif %}">
                    <i class="bi bi-check2-circle me-2"></i>Décision
                </div>
                <div class="card-body">
                    {# DEBUG #}
                    <div class="alert alert-info">
                        <strong>DEBUG:</strong> État du projet = "{{ projet.etat }}"
                    </div>
                    
                    {% if projet.etat == 'En attente' %}
