                            <div class="col-3"><div class="text-muted">Prix</div><strong>{{ mac.price ?? '—' }}</strong></div>
                            <div class="col-3">
                                <div class="text-muted">Jour</div>
                                {% set mpd = mac.pct_day|default('0')|replace({'%':''})|trim %}
                                <strong class="{{ mpd > 0 ? 'text-success' : (mpd < 0 ? 'text-danger' : '') }}">{{ mac.pct_day ?? '—' }}</strong>
                            </div>
                            <div class="col-3">
                                <div class="text-muted">Mois</div>
                                {% set mpm = mac.pct_month|default('0')|replace({'%':''})|trim %}
                                <strong class="{{ mpm > 0 ? 'text-success' : (mpm < 0 ? 'text-danger' : '') }}">{{ mac.pct_month ?? '—' }}</strong>
                            </div>
                            <div class="col-3">
                                <div class="text-muted">Année</div>
                                {% set mpy = mac.pct_year|default('0')|replace({'%':''})|trim %}
                                <strong class="{{ mpy > 0 ? 'text-success' : (mpy < 0 ? 'text-danger' : '') }}">{{ mac.pct_year ?? '—' }}</strong>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {# ── Alertes ── #}
                    {% if md.alerts is defined and md.alerts|length > 0 %}
                    <div class="mb-3">
                        <div class="fw-bold small mb-1"><i class="bi bi-bell me-1"></i>Alertes automatiques</div>
                        {% for alert in md.alerts %}
                        <div class="alert alert-{{ alert.type }} py-1 px-2 small mb-1">{{ alert.msg }}</div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {# ── Recommandation ── #}
                    {% if md.recommendation is defined %}
                    <div class="alert alert-light border small mb-0">
                        <i class="bi bi-lightbulb-fill text-warning me-1"></i>
                        {{ md.recommendation }}
                    </div>
                    {% endif %}

                    {% endif %}{# end md #}

                    <div class="text-end mt-2">
                        <small class="text-muted">
                            {% if projet.marketAnalyzedAt %}Analysé le {{ projet.marketAnalyzedAt|date('d/m/Y H:i') }}{% endif %}
                        </small>
                    </div>
                </div>

                {% else %}
                <div class="card-body text-center text-muted py-4">
                    <i class="bi bi-bar-chart-line fs-2 d-block mb-2"></i>
                    Aucune analyse disponible.<br>
                    <small>Cliquez sur "Lancer l'analyse" pour obtenir :<br>
                    EOD historique · Prix live · RSI · Volatilité · Commodités · Macro S&P500</small>
                </div>
                {% endif %}
            </div>

            {# ── Analyse brevets (SerpAPI) ── #}
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-file-earmark-text me-2"></i>Analyse brevets <small class="opacity-75">via Google Patents</small></span>
                    <div class="d-flex gap-2 align-items-center">
                        {% if projet.patentData and projet.patentData.google_patents_url is defined and projet.patentData.google_patents_url %}
                            <a href="{{ projet.patentData.google_patents_url }}" target="_blank" class="btn btn-sm btn-outline-light">
                                <i class="bi bi-box-arrow-up-right me-1"></i>Google Patents
                            </a>
                        {% endif %}
                        <a href="{{ path('admin_analyser_patents', {'id': projet.idProjet}) }}"
                           class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-clockwise me-1"></i>
                            {{ projet.patentNoveltyScore is not null ? 'Relancer' : 'Lancer l\'analyse' }}
                        </a>
                    </div>
                </div>

                {% if projet.patentNoveltyScore is not null %}
                {% set pd = projet.patentData %}
                <div class="card-body">

                    {# ── Score + métriques ── #}
                    <div class="row g-2 mb-3">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold">Score de nouveauté</span>
                                <span class="fw-bold fs-5
                                    {% if projet.patentNoveltyScore >= 70 %}text-success
                                    {% elseif projet.patentNoveltyScore >= 40 %}text-warning
                                    {% else %}text-danger{% endif %}">
                                    {{ projet.patentNoveltyScore }}/100
                                </span>
                            </div>
                            <div class="progress mb-2" style="height:10px">
                                <div class="progress-bar
                                    {% if projet.patentNoveltyScore >= 70 %}bg-success
                                    {% elseif projet.patentNoveltyScore >= 40 %}bg-warning
                                    {% else %}bg-danger{% endif %}"
                                    style="width:{{ projet.patentNoveltyScore }}%"></div>
                            </div>
                        </div>
                        {% if pd %}
                        <div class="col-3 text-center">
                            <div class="border rounded p-2 small">
                                <div class="text-muted">Total brevets</div>
                                <strong class="fs-6">{{ pd.total_results ?? 0 }}</strong>
                            </div>
                        </div>
                        <div class="col-3 text-center">
                            <div class="border rounded p-2 small">
                                <div class="text-muted">Récents (5 ans)</div>
                                <strong class="{{ (pd.recent_5y ?? 0) > 30 ? 'text-danger' : 'text-success' }}">{{ pd.recent_5y ?? 0 }}</strong>
                            </div>
                        </div>
                        <div class="col-3 text-center">
                            <div class="border rounded p-2 small">
                                <div class="text-muted">Actifs</div>
                                <strong class="text-warning">{{ pd.active_count ?? 0 }}</strong>
                            </div>
                        </div>
                        <div class="col-3 text-center">
                            <div class="border rounded p-2 small">
                                <div class="text-muted">Concurrents</div>
                                <strong class="{{ (pd.competitors ?? [])|length > 0 ? 'text-danger' : 'text-success' }}">{{ (pd.competitors ?? [])|length }}</strong>
                            </div>
                        </div>
                        {% endif %}
                    </div>

                    {% if pd %}

                    {# ── Requête utilisée ── #}
                    {% if pd.query is defined and pd.query %}
                    <div class="small text-muted mb-3 p-2 bg-light rounded">
                        <i class="bi bi-search me-1"></i><strong>Requête :</strong>
                        <code class="text-dark">{{ pd.query }}</code>
                    </div>
                    {% endif %}

                    {# ── Timeline d'activité ── #}
                    {% if pd.timeline is defined and pd.timeline|length > 0 %}
                    <div class="mb-3">
                        <div class="fw-bold small mb-2"><i class="bi bi-graph-up me-1"></i>Activité de dépôt par période</div>
                        <div class="d-flex gap-1 align-items-end" style="height:50px">
                            {% for t in pd.timeline|reverse %}
                                {% if t.pct > 0 %}
                                <div title="{{ t.range }} : {{ t.pct }}%"
                                     style="flex:1;background:linear-gradient(to top,#7c3aed,#a855f7);border-radius:3px 3px 0 0;height:{{ t.pct * 2 > 50 ? 50 : t.pct * 2 }}px;min-width:8px;opacity:.8;cursor:pointer"
                                     data-bs-toggle="tooltip" data-bs-title="{{ t.range }} — {{ t.pct }}%"></div>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <div class="d-flex justify-content-between" style="font-size:.65rem;color:#94a3b8;margin-top:2px">
                            {% if pd.timeline|length > 0 %}
                                <span>{{ pd.timeline|last.range }}</span>
                                <span>{{ pd.timeline|first.range }}</span>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}

                    {# ── Top déposants ── #}
                    {% if pd.top_assignees is defined and pd.top_assignees|length > 0 %}
                    <div class="mb-3">
                        <div class="fw-bold small mb-2"><i class="bi bi-building me-1"></i>Top déposants</div>
                        {% for a in pd.top_assignees|slice(0,6) %}
