{% extends 'base.html.twig' %}
{% block title %}Ticket #{{ reclamation.id }}{% endblock %}

{% block stylesheets %}
<style>
* { box-sizing: border-box; }

.ticket-page { display: flex; gap: 24px; align-items: flex-start; }

/* ── Left panel ── */
.ticket-left { flex: 1; min-width: 0; }

/* Ticket header */
.ticket-header {
    background: #fff; border: 1px solid #e5e7eb;
    border-radius: 12px; padding: 20px 24px;
    margin-bottom: 16px;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
}
.ticket-header-left { flex: 1; }
.ticket-id { font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: .8px; margin-bottom: 6px; }
.ticket-title { font-size: 20px; font-weight: 700; color: #111827; margin: 0 0 8px; }
.ticket-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.ticket-meta span { font-size: 12px; color: #6b7280; display: flex; align-items: center; gap: 4px; }
.status-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .5px;
}
.status-EN_ATTENTE { background: #fef3c7; color: #92400e; }
.status-EN_COURS   { background: #dbeafe; color: #1e40af; }
.status-RESOLU     { background: #d1fae5; color: #065f46; }
.status-REJETE     { background: #fee2e2; color: #991b1b; }

.statut-form { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.statut-form select {
    border: 1px solid #e5e7eb; border-radius: 8px; padding: 7px 12px;
    font-size: 13px; color: #374151; outline: none; background: #f9fafb; cursor: pointer;
}
.statut-form select:focus { border-color: #8b5cf6; }
.statut-form .btn-save {
    background: #7c3aed; color: #fff; border: none;
    border-radius: 8px; padding: 7px 16px; font-size: 13px; font-weight: 600;
    cursor: pointer; transition: background .2s;
}
.statut-form .btn-save:hover { background: #6d28d9; }

/* Conversation card */
.conv-card {
    background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden;
}
.conv-top {
    padding: 14px 20px; border-bottom: 1px solid #f3f4f6;
    display: flex; align-items: center; gap: 8px; background: #fafafa;
}
.conv-top .live { width: 8px; height: 8px; border-radius: 50%; background: #10b981; flex-shrink: 0; }
.conv-top .conv-title { font-size: 14px; font-weight: 600; color: #111827; }
.conv-top .conv-count { margin-left: auto; font-size: 12px; color: #9ca3af; }

.conv-body {
    padding: 24px 20px; min-height: 340px; max-height: 440px;
    overflow-y: auto; display: flex; flex-direction: column; gap: 20px;
    background: #f9fafb;
}
.conv-body::-webkit-scrollbar { width: 4px; }
.conv-body::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 4px; }

/* Message */
.msg { display: flex; gap: 12px; }
.msg.msg-right { flex-direction: row-reverse; }

.msg-av {
    width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 700; color: #fff;
}
.msg-av.av-admin { background: #7c3aed; }
.msg-av.av-user  { background: #0ea5e9; }

.msg-inner { max-width: 68%; display: flex; flex-direction: column; gap: 4px; }
.msg.msg-right .msg-inner { align-items: flex-end; }

.msg-who { font-size: 11px; font-weight: 600; color: #9ca3af; display: flex; align-items: center; gap: 4px; }
.msg.msg-right .msg-who { color: #7c3aed; }

.msg-text {
    padding: 12px 16px; border-radius: 16px;
    font-size: 14px; line-height: 1.6; color: #1f2937;
    background: #fff; border: 1px solid #e5e7eb;
    border-bottom-left-radius: 4px;
}
.msg.msg-right .msg-text {
    background: #7c3aed; color: #fff; border: none;
    border-bottom-right-radius: 4px; border-bottom-left-radius: 16px;
}
.msg-when { font-size: 10px; color: #d1d5db; }
.msg.msg-right .msg-when { color: #c4b5fd; }

.conv-empty {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; gap: 10px; padding: 60px 0; color: #d1d5db;
}
.conv-empty i { font-size: 40px; }
.conv-empty p { font-size: 13px; margin: 0; }

.conv-input {
    padding: 16px 20px; border-top: 1px solid #f3f4f6; background: #fff;
}
.conv-input form { display: flex; gap: 10px; }
.conv-input input {
    flex: 1; border: 1px solid #e5e7eb; border-radius: 10px;
    padding: 11px 16px; font-size: 14px; color: #111827;
    outline: none; background: #f9fafb; transition: .2s;
}
.conv-input input:focus { border-color: #8b5cf6; background: #fff; box-shadow: 0 0 0 3px rgba(124,58,237,.08); }
.conv-input input::placeholder { color: #9ca3af; }
.conv-input .btn-reply {
    background: #7c3aed; color: #fff; border: none; border-radius: 10px;
    padding: 11px 20px; font-size: 14px; font-weight: 600;
    cursor: pointer; display: flex; align-items: center; gap: 7px; transition: .2s;
    white-space: nowrap;
}
.conv-input .btn-reply:hover { background: #6d28d9; }

.conv-closed {
    padding: 16px 20px; border-top: 1px solid #f3f4f6;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    font-size: 13px; color: #6b7280; background: #f9fafb;
}

/* ── Right sidebar ── */
.ticket-sidebar { width: 260px; flex-shrink: 0; display: flex; flex-direction: column; gap: 16px; }

.sidebar-card {
    background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden;
}
.sidebar-card-header {
    padding: 12px 16px; border-bottom: 1px solid #f3f4f6;
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .8px; color: #9ca3af; background: #fafafa;
    display: flex; align-items: center; gap: 6px;
}
.sidebar-card-body { padding: 16px; }

.user-row { display: flex; align-items: center; gap: 12px; }
.user-av-sm {
    width: 40px; height: 40px; border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #a78bfa);
    color: #fff; font-size: 16px; font-weight: 700;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.user-nm { font-size: 14px; font-weight: 600; color: #111827; }
.user-em { font-size: 12px; color: #9ca3af; margin-top: 2px; }

.desc-body { font-size: 13px; line-height: 1.7; color: #374151; }
.orig-box {
    margin-top: 10px; padding: 10px 12px; border-radius: 8px;
    background: #fffbeb; border-left: 3px solid #f59e0b;
}
.orig-box .orig-lbl { font-size: 10px; font-weight: 700; color: #92400e; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px; }
.orig-box .orig-val { font-size: 12px; color: #78350f; }

.ai-row { display: flex; flex-direction: column; gap: 8px; }
.ai-item { display: flex; align-items: center; justify-content: space-between; }
.ai-item .ai-lbl { font-size: 12px; color: #6b7280; }
.ai-chip {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;
}
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

    <a href="{{ path('admin_reclamation_index') }}" style="display:inline-flex;align-items:center;gap:6px;color:#6b7280;font-size:13px;text-decoration:none;margin-bottom:20px;padding:6px 14px;border:1px solid #e5e7eb;border-radius:8px;background:#fff;">
        <i class="bi bi-arrow-left"></i> Retour
    </a>

    <div class="ticket-page">

        {# ── Left ── #}
        <div class="ticket-left">

            {# Ticket header #}
            <div class="ticket-header">
                <div class="ticket-header-left">
                    <div class="ticket-id">Ticket #{{ reclamation.id }}</div>
                    <h1 class="ticket-title">{{ reclamation.sujet }}</h1>
                    <div class="ticket-meta">
                        <span class="status-badge status-{{ reclamation.statut }}">
                            {{ reclamation.statut == 'EN_ATTENTE' ? '⏳' : (reclamation.statut == 'RESOLU' ? '✅' : (reclamation.statut == 'EN_COURS' ? '🔄' : '❌')) }}
                            {{ reclamation.statut|replace({'_': ' '}) }}
                        </span>
                        <span><i class="bi bi-calendar3"></i> {{ reclamation.dateCreation|date('d/m/Y à H:i') }}</span>
                        {% if reclamation.priorite %}
                        <span><i class="bi bi-flag"></i> Priorité :
                            <strong style="color:{{ reclamation.priorite == 'HIGH' ? '#ef4444' : (reclamation.priorite == 'MEDIUM' ? '#f59e0b' : '#22c55e') }};">
                                {{ reclamation.priorite }}
                            </strong>
                        </span>
                        {% endif %}
                    </div>
                </div>
                <form method="POST" action="{{ path('admin_reclamation_show', {id: reclamation.id}) }}" class="statut-form">
                    {% if reclamation.statut != 'RESOLU' and reclamation.statut != 'REJETE' %}
                    <select name="statut">
                        <option value="EN_ATTENTE" {{ reclamation.statut == 'EN_ATTENTE' ? 'selected' : '' }}>⏳ En attente</option>
                        <option value="EN_COURS"   {{ reclamation.statut == 'EN_COURS'   ? 'selected' : '' }}>🔄 En cours</option>
                        <option value="RESOLU"     {{ reclamation.statut == 'RESOLU'     ? 'selected' : '' }}>✅ Résolu</option>
                        <option value="REJETE"     {{ reclamation.statut == 'REJETE'     ? 'selected' : '' }}>❌ Rejeté</option>
                    </select>
                    <button type="submit" class="btn-save">Enregistrer</button>
                    {% else %}
                    <span style="display:inline-flex;align-items:center;gap:6px;padding:7px 16px;border-radius:8px;font-size:13px;font-weight:600;background:{{ reclamation.statut == 'RESOLU' ? '#d1fae5' : '#fee2e2' }};color:{{ reclamation.statut == 'RESOLU' ? '#065f46' : '#991b1b' }};">
                        <i class="bi bi-lock-fill"></i>
                        {{ reclamation.statut == 'RESOLU' ? '✅ Ticket résolu' : '❌ Ticket rejeté' }}
                    </span>
                    {% endif %}
                </form>
            </div>

            {# Conversation #}
            <div class="conv-card">
                <div class="conv-top">
                    <div class="live"></div>
                    <span class="conv-title">Conversation</span>
                    <span class="conv-count">{{ messages|length }} message{{ messages|length != 1 ? 's' : '' }}</span>
                </div>

                <div class="conv-body" id="chatBody">
                    {# Description initiale comme premier message #}
                    <div class="msg">
                        <div class="msg-av av-user">
                            {{ reclamation.utilisateur ? reclamation.utilisateur.nom|slice(0,1)|upper : 'U' }}
                        </div>
                        <div class="msg-inner">
                            <div class="msg-who">
                                <i class="bi bi-person"></i>
                                {{ reclamation.utilisateur ? reclamation.utilisateur.nom : 'Utilisateur' }}
                                <span style="font-weight:400;color:#d1d5db;margin-left:4px;">· Réclamation initiale</span>
                            </div>
                            <div class="msg-text" style="background:#f0f9ff;border-color:#bae6fd;">
                                {{ reclamation.description }}
                                {% if reclamation.descriptionOriginale %}
                                <div style="margin-top:10px;padding:8px 12px;background:#fffbeb;border-left:3px solid #f59e0b;border-radius:6px;font-size:12px;color:#78350f;">
                                    <strong style="color:#92400e;font-size:10px;text-transform:uppercase;letter-spacing:.5px;">
                                        <i class="bi bi-translate me-1"></i>Original · {{ reclamation.langueOriginale|upper }}
                                    </strong><br>
                                    {{ reclamation.descriptionOriginale }}
                                </div>
                                {% endif %}
                            </div>
                            <span class="msg-when">{{ reclamation.dateCreation|date('d/m/Y à H:i') }}</span>
                        </div>
                    </div>

                    {# Réponse automatique chatbot #}
                    {% if reclamation.autoResponse %}
                    <div class="msg msg-right">
                        <div class="msg-av av-admin" style="background:#10b981;">
                            <i class="bi bi-robot" style="font-size:14px;"></i>
                        </div>
                        <div class="msg-inner">
                            <div class="msg-who" style="color:#10b981;">
                                <i class="bi bi-stars"></i> Réponse automatique
                            </div>
                            <div class="msg-text" style="background:linear-gradient(135deg,#059669,#10b981);color:#fff;border:none;border-bottom-right-radius:4px;">
                                {{ reclamation.autoResponse }}
                            </div>
                            <span class="msg-when">Réponse générée automatiquement</span>
                        </div>
                    </div>
                    {% endif %}

                    {# Séparateur #}
                    {% if messages is not empty %}
                    <div style="display:flex;align-items:center;gap:10px;margin:4px 0;">
                        <div style="flex:1;height:1px;background:#f3f4f6;"></div>
                        <span style="font-size:11px;color:#d1d5db;white-space:nowrap;">Échanges</span>
                        <div style="flex:1;height:1px;background:#f3f4f6;"></div>
                    </div>
                    {% endif %}

                    {% for msg in messages %}
                        {% set isAdmin = msg.id_auteur.getId() == adminId %}
                        <div class="msg {{ isAdmin ? 'msg-right' : '' }}">
                            <div class="msg-av {{ isAdmin ? 'av-admin' : 'av-user' }}" style="overflow:hidden;padding:0;">
                                {% if msg.id_auteur.getPhoto() %}
                                    <img src="{{ asset(msg.id_auteur.getPhoto()) }}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
                                {% else %}
                                    {{ msg.id_auteur.nom|slice(0,1)|upper }}
                                {% endif %}
                            </div>
                            <div class="msg-inner">
                                <div class="msg-who">
                                    {% if isAdmin %}<i class="bi bi-shield-check"></i> Admin{% else %}<i class="bi bi-person"></i> {{ msg.id_auteur.nom }}{% endif %}
                                </div>
                                <div class="msg-text">{{ msg.commentaire }}</div>
                                <span class="msg-when">{{ msg.date_commentaire|date('d/m/Y à H:i') }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {% if reclamation.statut == 'RESOLU' or reclamation.statut == 'REJETE' %}
                    <div class="conv-closed">
                        <i class="bi bi-lock-fill" style="color:{{ reclamation.statut == 'RESOLU' ? '#10b981' : '#ef4444' }};"></i>
                        {{ reclamation.statut == 'RESOLU' ? 'Ticket résolu — communication fermée.' : 'Ticket rejeté — communication fermée.' }}
                    </div>
                {% else %}
                    <div class="conv-input">
                        <form method="POST" action="{{ path('admin_reclamation_show', {id: reclamation.id}) }}">
                            <input type="text" name="message" placeholder="Écrire une réponse..." autocomplete="off">
                            <button type="submit" class="btn-reply">
                                <i class="bi bi-send-fill"></i> Répondre
                            </button>
                        </form>
                    </div>
                {% endif %}
            </div>

        </div>{# /ticket-left #}

        {# ── Sidebar ── #}
        <div class="ticket-sidebar">

            {# Utilisateur #}
            <div class="sidebar-card">
                <div class="sidebar-card-header"><i class="bi bi-person"></i> Demandeur</div>
                <div class="sidebar-card-body">
                    {% if reclamation.utilisateur %}
                    <div class="user-row">
                        <div class="user-av-sm">{{ reclamation.utilisateur.nom|slice(0,1)|upper }}</div>
                        <div>
                            <div class="user-nm">{{ reclamation.utilisateur.nom }}</div>
                            <div class="user-em">{{ reclamation.utilisateur.email }}</div>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

            {# Analyse IA #}
            {% if reclamation.categorie or reclamation.sentiment or reclamation.priorite %}
            <div class="sidebar-card">
                <div class="sidebar-card-header"><i class="bi bi-robot"></i> Analyse IA</div>
                <div class="sidebar-card-body">
                    <div class="ai-row">
                        {% if reclamation.categorie %}
                        <div class="ai-item">
                            <span class="ai-lbl">Catégorie</span>
                            <span class="ai-chip" style="background:#eff6ff;color:#3b82f6;"><i class="bi bi-tag-fill"></i>{{ reclamation.categorie }}</span>
                        </div>
                        {% endif %}
                        {% if reclamation.sentiment %}
                        <div class="ai-item">
                            <span class="ai-lbl">Sentiment</span>
                            <span class="ai-chip" style="background:{{ reclamation.sentiment == 'négatif' ? '#fef2f2' : (reclamation.sentiment == 'positif' ? '#f0fdf4' : '#f9fafb') }};color:{{ reclamation.sentiment == 'négatif' ? '#ef4444' : (reclamation.sentiment == 'positif' ? '#22c55e' : '#6b7280') }};">
                                {{ reclamation.sentiment == 'négatif' ? '😠' : (reclamation.sentiment == 'positif' ? '😊' : '😐') }} {{ reclamation.sentiment }}
                            </span>
                        </div>
                        {% endif %}
                        {% if reclamation.priorite %}
                        <div class="ai-item">
                            <span class="ai-lbl">Priorité</span>
                            <span class="ai-chip" style="background:{{ reclamation.priorite == 'HIGH' ? '#fef2f2' : (reclamation.priorite == 'MEDIUM' ? '#fffbeb' : '#f0fdf4') }};color:{{ reclamation.priorite == 'HIGH' ? '#ef4444' : (reclamation.priorite == 'MEDIUM' ? '#f59e0b' : '#22c55e') }};">
                                {{ reclamation.priorite == 'HIGH' ? '🔴' : (reclamation.priorite == 'MEDIUM' ? '🟡' : '🟢') }} {{ reclamation.priorite }}
                            </span>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endif %}

        </div>{# /sidebar #}

    </div>{# /ticket-page #}

</div>
<script>
    const b = document.getElementById('chatBody');
    if (b) b.scrollTop = b.scrollHeight;
</script>
{% endblock %}
