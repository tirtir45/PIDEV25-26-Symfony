{% set userRole = app.session.get('user_role')|default('') %}
{% set isMember = app.session.get('is_member')|default(false) %}

{% if userRole == 'Administrateur' %}
    {{ include('_sidebar_admin.html.twig') }}
{% elseif userRole == 'Membre' or isMember %}
    {{ include('_sidebar_membre.html.twig') }}
{% elseif userRole == 'Entrepreneur' %}
    {{ include('_sidebar_entrepreneur.html.twig') }}
{% elseif userRole == 'Fournisseur' %}
    {{ include('_sidebar_fournisseur.html.twig') }}
{% else %}
    {# Fallback or default sidebar #}
    {{ include('_sidebar_entrepreneur.html.twig') }}
{% endif %}
